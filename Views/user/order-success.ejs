<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Successful - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <style>
    body {
      background-color: #f8f6f3;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }

    .success-wrapper {
      max-width: 700px;
      margin: 60px auto;
      padding: 0 24px;
    }

    .success-card {
      background: white;
      border-radius: 12px;
      padding: 60px 40px;
      text-align: center;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .success-icon {
      width: 100px;
      height: 100px;
      margin: 0 auto 30px;
      background: #e8f5e9;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      animation: scaleIn 0.5s ease-out;
    }

    @keyframes scaleIn {
      0% {
        transform: scale(0);
        opacity: 0;
      }
      50% {
        transform: scale(1.1);
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    .success-icon svg {
      width: 50px;
      height: 50px;
      stroke: #2e7d32;
      stroke-width: 3;
    }

    .success-title {
      font-size: 32px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 12px;
    }

    .success-message {
      font-size: 16px;
      color: #666;
      margin-bottom: 30px;
      line-height: 1.6;
    }

    .order-info-box {
      background: #faf8f5;
      border: 1px solid #e8e8e8;
      border-radius: 8px;
      padding: 24px;
      margin-bottom: 30px;
    }

    .order-number {
      font-size: 14px;
      color: #666;
      margin-bottom: 8px;
    }

    .order-id {
      font-size: 24px;
      font-weight: 700;
      color: #2d1f14;
      letter-spacing: 1px;
    }

    .order-details-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      margin-top: 20px;
      text-align: left;
    }

    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .detail-label {
      font-size: 12px;
      color: #999;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .detail-value {
      font-size: 15px;
      color: #2d1f14;
      font-weight: 600;
    }

    .action-buttons {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn-primary {
      padding: 14px 32px;
      background: #2d1f14;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s;
    }

    .btn-primary:hover {
      background: #1a1209;
    }

    .btn-secondary {
      padding: 14px 32px;
      background: white;
      color: #2d1f14;
      border: 2px solid #2d1f14;
      border-radius: 6px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .btn-secondary:hover {
      background: #2d1f14;
      color: white;
    }

    .delivery-info {
      margin-top: 30px;
      padding-top: 30px;
      border-top: 1px solid #e8e8e8;
      text-align: left;
    }

    .delivery-title {
      font-size: 16px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 12px;
    }

    .delivery-address {
      font-size: 14px;
      color: #666;
      line-height: 1.6;
    }

    .items-summary {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #e8e8e8;
    }

    .items-title {
      font-size: 16px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 16px;
      text-align: left;
    }

    .order-item {
      display: flex;
      gap: 12px;
      margin-bottom: 12px;
      text-align: left;
    }

    .item-image {
      width: 50px;
      height: 70px;
      background: #f5f1ed;
      border-radius: 4px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .item-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .item-details {
      flex: 1;
    }

    .item-title {
      font-size: 14px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 4px;
    }

    .item-qty {
      font-size: 13px;
      color: #666;
    }

    .item-price {
      font-size: 14px;
      font-weight: 600;
      color: #2d1f14;
      text-align: right;
    }

    @media (max-width: 768px) {
      .success-card {
        padding: 40px 24px;
      }

      .success-title {
        font-size: 24px;
      }

      .order-details-grid {
        grid-template-columns: 1fr;
      }

      .action-buttons {
        flex-direction: column;
      }

      .btn-primary,
      .btn-secondary {
        width: 100%;
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>

  <div class="success-wrapper">
    <div class="success-card">
      
      <div class="success-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>

      <h1 class="success-title">Order Placed Successfully!</h1>
      <p class="success-message">
        Thank you for your order. We've received your order and will start processing it soon.
        You'll receive a confirmation email shortly.
      </p>

      <div class="order-info-box">
        <div class="order-number">Order Number</div>
        <div class="order-id"><%= order.orderId %></div>

        <div class="order-details-grid">
          <div class="detail-item">
            <span class="detail-label">Order Date</span>
            <span class="detail-value"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Total Amount</span>
            <span class="detail-value">₹<%= order.totalAmount.toFixed(2) %></span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Payment Method</span>
            <span class="detail-value"><%= order.paymentMethod %></span>
          </div>

          <div class="detail-item">
            <span class="detail-label">Order Status</span>
            <span class="detail-value"><%= order.orderStatus %></span>
          </div>
        </div>
      </div>

      <div class="action-buttons">
        <a href="/orders/<%= order._id %>" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
          View Order Details
        </a>

        <a href="/shop" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="m1 1 4 4 2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          Continue Shopping
        </a>
      </div>

      <div class="delivery-info">
        <div class="delivery-title">Delivery Address</div>
        <div class="delivery-address">
          <strong><%= order.shippingAddress.fullName %></strong><br>
          <%= order.shippingAddress.phone %><br>
          <%= order.shippingAddress.addressLine1 %><% if (order.shippingAddress.addressLine2) { %>, <%= order.shippingAddress.addressLine2 %><% } %><br>
          <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> - <%= order.shippingAddress.pincode %><br>
          <%= order.shippingAddress.country %>
        </div>
      </div>

      <div class="items-summary">
        <div class="items-title">Order Items (<%= order.items.length %>)</div>
        <% order.items.forEach(item => { %>
          <div class="order-item">
            <div class="item-image">
              <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                <img src="<%= item.product.images[0].url %>" alt="<%= item.title %>"/>
              <% } else { %>
                <div style="font-size: 24px; color: #bbb; display: flex; align-items: center; justify-content: center; height: 100%;">📚</div>
              <% } %>
            </div>
            <div class="item-details">
              <div class="item-title"><%= item.title %></div>
              <div class="item-qty">Quantity: <%= item.quantity %></div>
            </div>
            <div class="item-price">
              ₹<%= item.subtotal.toFixed(2) %>
            </div>
          </div>
        <% }) %>
      </div>

    </div>
  </div>

</body>
</html>
