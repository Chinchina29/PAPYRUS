<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Orders - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { background-color: #f8f6f3; }
    .orders-wrapper { max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px; }
    .breadcrumb-nav { font-size: 13px; color: #999; margin-bottom: 24px; text-transform: uppercase; letter-spacing: 0.5px; }
    .breadcrumb-nav a { color: #999; text-decoration: none; transition: color 0.2s; }
    .breadcrumb-nav a:hover { color: #5a4a3a; text-decoration: underline; }
    .orders-header { margin-bottom: 32px; }
    .orders-header h1 { font-size: 42px; font-weight: 400; color: #2d1f14; margin-bottom: 8px; }
    
    .filters-bar { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
    .search-box { flex: 1; min-width: 250px; position: relative; }
    .search-box input { width: 100%; padding: 12px 16px 12px 40px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 14px; }
    .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #999; }
    .filter-select { padding: 12px 16px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 14px; background: white; cursor: pointer; }
    .clear-btn { padding: 12px 20px; background: #d32f2f; color: white; border: none; border-radius: 8px; cursor: pointer; font-size: 14px; }
    
    .order-card { background: white; border-radius: 12px; padding: 24px; margin-bottom: 16px; border: 1px solid #e8dcc8; }
    .order-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #f0f0f0; }
    .order-id { font-size: 16px; font-weight: 600; color: #2d1f14; }
    .order-date { font-size: 13px; color: #666; margin-top: 4px; }
    .order-status { padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
    .status-pending { background: #fff3e0; color: #f57c00; }
    .status-processing { background: #e3f2fd; color: #1976d2; }
    .status-shipped { background: #e8f5e9; color: #388e3c; }
    .status-delivered { background: #c8e6c9; color: #2e7d32; }
    .status-cancelled { background: #ffebee; color: #d32f2f; }
    .status-returned { background: #f3e5f5; color: #7b1fa2; }
    
    .order-items { margin-bottom: 16px; }
    .order-item { display: flex; gap: 16px; padding: 12px 0; }
    .item-image { width: 60px; height: 80px; border-radius: 6px; overflow: hidden; background: #f5f1ed; }
    .item-image img { width: 100%; height: 100%; object-fit: cover; }
    .item-details { flex: 1; }
    .item-title { font-weight: 600; color: #2d1f14; margin-bottom: 4px; }
    .item-qty { font-size: 13px; color: #666; }
    .item-price { font-weight: 600; color: #2d1f14; }
    
    .order-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 16px; border-top: 1px solid #f0f0f0; }
    .order-total { font-size: 18px; font-weight: 600; color: #2d1f14; }
    .order-actions { display: flex; gap: 8px; }
    .btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; transition: all 0.2s; text-decoration: none; display: inline-block; }
    .btn-primary { background: #2d1f14; color: white; border: none; }
    .btn-primary:hover { background: #1a1209; }
    .btn-secondary { background: white; color: #2d1f14; border: 1.5px solid #2d1f14; }
    .btn-secondary:hover { background: #2d1f14; color: white; }
    .btn-danger { background: #d32f2f; color: white; border: none; }
    .btn-danger:hover { background: #b71c1c; }
    
    .empty-state { text-align: center; padding: 80px 20px; }
    .empty-state svg { width: 64px; height: 64px; color: #ccc; margin-bottom: 16px; }
    .empty-state h2 { font-size: 24px; color: #666; margin-bottom: 8px; }
    .empty-state p { color: #999; margin-bottom: 24px; }
    
    .pagination { display: flex; justify-content: center; gap: 8px; margin-top: 32px; }
    .page-btn { padding: 10px 16px; border: 1px solid #e8dcc8; background: white; border-radius: 6px; cursor: pointer; }
    .page-btn.active { background: #2d1f14; color: white; }
    .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  </style>
  <style>
    .cancel-order-popup label:hover,
    .return-order-popup label:hover {
      background: #f5f1ed !important;
    }
    .swal2-popup {
      border-radius: 12px !important;
    }
    .swal2-title {
      font-family: 'Playfair Display', serif !important;
      font-size: 24px !important;
      color: #2d1f14 !important;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="orders-wrapper">
    <div class="breadcrumb-nav">
      <a href="/home">HOME</a> / <a href="/profile">PROFILE</a> / <span>MY ORDERS</span>
    </div>

    <div class="orders-header">
      <h1>My Orders</h1>
      <p style="color: #666;">Track and manage your orders</p>
    </div>

    <div class="filters-bar">
      <div class="search-box">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input type="text" id="searchInput" placeholder="Search by order ID or product name..." value="<%= search %>">
      </div>
      <select id="statusFilter" class="filter-select">
        <option value="">All Status</option>
        <option value="Pending" <%= status === 'Pending' ? 'selected' : '' %>>Pending</option>
        <option value="Processing" <%= status === 'Processing' ? 'selected' : '' %>>Processing</option>
        <option value="Shipped" <%= status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
        <option value="Delivered" <%= status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
        <option value="Cancelled" <%= status === 'Cancelled' ? 'selected' : '' %>>Cancelled</option>
        <option value="Returned" <%= status === 'Returned' ? 'selected' : '' %>>Returned</option>
      </select>
      <select id="sortFilter" class="filter-select">
        <option value="newest" <%= sort === 'newest' ? 'selected' : '' %>>Newest First</option>
        <option value="oldest" <%= sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
        <option value="amount-high" <%= sort === 'amount-high' ? 'selected' : '' %>>Amount: High to Low</option>
        <option value="amount-low" <%= sort === 'amount-low' ? 'selected' : '' %>>Amount: Low to High</option>
      </select>
      <button class="clear-btn" onclick="clearFilters()">Clear</button>
    </div>

    <% if (orders && orders.length > 0) { %>
      <% orders.forEach(order => { %>
        <div class="order-card">
          <div class="order-header">
            <div>
              <div class="order-id"><%= order.orderId %></div>
              <div class="order-date">Ordered on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
            </div>
            <span class="order-status status-<%= order.orderStatus.toLowerCase() %>"><%= order.orderStatus %></span>
          </div>

          <div class="order-items">
            <% order.items.slice(0, 2).forEach(item => { %>
              <div class="order-item">
                <div class="item-image">
                  <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                    <img src="<%= item.product.images[0].url %>" alt="<%= item.title %>">
                  <% } else { %>
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%; font-size: 24px;">📚</div>
                  <% } %>
                </div>
                <div class="item-details">
                  <div class="item-title"><%= item.title %></div>
                  <div class="item-qty">Qty: <%= item.quantity %></div>
                </div>
                <div class="item-price">₹<%= item.subtotal.toFixed(2) %></div>
              </div>
            <% }) %>
            <% if (order.items.length > 2) { %>
              <div style="font-size: 13px; color: #666; margin-top: 8px;">+ <%= order.items.length - 2 %> more item(s)</div>
            <% } %>
          </div>

          <div class="order-footer">
            <div class="order-total">Total: ₹<%= order.totalAmount.toFixed(2) %></div>
            <div class="order-actions">
              <a href="/orders/<%= order._id %>" class="btn btn-primary">View Details</a>
              <% if (order.orderStatus === 'Delivered' || order.orderStatus === 'Shipped') { %>
                <a href="/orders/<%= order._id %>/invoice" target="_blank" class="btn btn-secondary" title="Download Invoice">
                  <svg style="width: 16px; height: 16px; margin-right: 4px; vertical-align: middle;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                  </svg>
                  Invoice
                </a>
              <% } %>
              <% if (order.orderStatus === 'Pending' || order.orderStatus === 'Processing') { %>
                <button class="btn btn-danger" onclick="cancelOrder('<%= order._id %>')">Cancel Order</button>
              <% } %>
              <% if (order.orderStatus === 'Delivered') { %>
                <button class="btn btn-secondary" onclick="returnOrder('<%= order._id %>')">Return Order</button>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>

      <% if (totalPages > 1) { %>
        <div class="pagination">
          <button class="page-btn" onclick="goToPage(<%= currentPage - 1 %>)" <%= currentPage === 1 ? 'disabled' : '' %>>Previous</button>
          <% for (let i = 1; i <= totalPages; i++) { %>
            <button class="page-btn <%= i === currentPage ? 'active' : '' %>" onclick="goToPage(<%= i %>)"><%= i %></button>
          <% } %>
          <button class="page-btn" onclick="goToPage(<%= currentPage + 1 %>)" <%= currentPage === totalPages ? 'disabled' : '' %>>Next</button>
        </div>
      <% } %>
    <% } else { %>
      <div class="empty-state">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="9" cy="21" r="1"></circle>
          <circle cx="20" cy="21" r="1"></circle>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
        </svg>
        <h2>No Orders Found</h2>
        <p>You haven't placed any orders yet</p>
        <a href="/shop" class="btn btn-primary">Start Shopping</a>
      </div>
    <% } %>
  </div>

  <script>
    function applyFilters() {
      const search = document.getElementById('searchInput').value;
      const status = document.getElementById('statusFilter').value;
      const sort = document.getElementById('sortFilter').value;
      const params = new URLSearchParams();
      if (search) params.append('search', search);
      if (status) params.append('status', status);
      if (sort) params.append('sort', sort);
      window.location.href = `/orders?${params.toString()}`;
    }

    function clearFilters() {
      window.location.href = '/orders';
    }

    function goToPage(page) {
      const params = new URLSearchParams(window.location.search);
      params.set('page', page);
      window.location.href = `/orders?${params.toString()}`;
    }

    document.getElementById('searchInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') applyFilters();
    });

    document.getElementById('statusFilter').addEventListener('change', applyFilters);
    document.getElementById('sortFilter').addEventListener('change', applyFilters);

    async function cancelOrder(orderId) {
      const result = await Swal.fire({
        title: 'Cancel Your Order',
        html: `
          <p style="color: #666; font-size: 14px; margin-bottom: 20px;">We're sorry to see you go. Please let us know the reason for your cancellation.</p>
          <div style="text-align: left; margin-bottom: 20px;">
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Found a better price elsewhere" style="margin-right: 10px;">
              <span style="font-size: 14px;">Found a better price elsewhere</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Mistakenly ordered" style="margin-right: 10px;">
              <span style="font-size: 14px;">Mistakenly ordered</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Long expected delivery time" style="margin-right: 10px;">
              <span style="font-size: 14px;">Long expected delivery time</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Changed my mind" style="margin-right: 10px;">
              <span style="font-size: 14px;">Changed my mind</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Other" style="margin-right: 10px;">
              <span style="font-size: 14px;">Other</span>
            </label>
          </div>
          <div style="text-align: left;">
            <label style="display: block; font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Additional Comments (Optional)</label>
            <textarea id="cancelComments" class="swal2-textarea" placeholder="Please provide any additional details..." style="width: 100%; min-height: 80px; padding: 12px; border: 1px solid #e8dcc8; border-radius: 6px; font-size: 14px; resize: vertical;"></textarea>
          </div>
        `,
        showCancelButton: true,
        confirmButtonColor: '#2d1f14',
        cancelButtonColor: '#999',
        confirmButtonText: 'Confirm Cancellation',
        cancelButtonText: 'Keep My Order',
        width: '500px',
        customClass: {
          popup: 'cancel-order-popup'
        },
        preConfirm: () => {
          const selectedReason = document.querySelector('input[name="cancelReason"]:checked');
          if (!selectedReason) {
            Swal.showValidationMessage('Please select a reason for cancellation');
            return false;
          }
          return {
            reason: selectedReason.value,
            comments: document.getElementById('cancelComments').value
          };
        }
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch(`/orders/${orderId}/cancel`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
              reason: result.value.reason,
              comments: result.value.comments
            })
          });

          const data = await response.json();

          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Order Cancelled',
              text: data.message,
              confirmButtonColor: '#2d1f14'
            }).then(() => location.reload());
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message,
              confirmButtonColor: '#2d1f14'
            });
          }
        } catch (error) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to cancel order',
            confirmButtonColor: '#2d1f14'
          });
        }
      }
    }

    async function returnOrder(orderId) {
      const result = await Swal.fire({
        title: 'Return Your Order',
        html: `
          <p style="color: #666; font-size: 14px; margin-bottom: 20px;">We are sorry the book wasn't a perfect fit. Please let us know the reason for your return.</p>
          <div style="text-align: left; margin-bottom: 20px;">
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="returnReason" value="Item damaged upon arrival" style="margin-right: 10px;">
              <span style="font-size: 14px;">Item damaged upon arrival</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="returnReason" value="Incorrect book received" style="margin-right: 10px;">
              <span style="font-size: 14px;">Incorrect book received</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="returnReason" value="Quality not as described" style="margin-right: 10px;">
              <span style="font-size: 14px;">Quality not as described</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="returnReason" value="Changed my mind" style="margin-right: 10px;">
              <span style="font-size: 14px;">Changed my mind</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="returnReason" value="Other" style="margin-right: 10px;">
              <span style="font-size: 14px;">Other</span>
            </label>
          </div>
          <div style="text-align: left;">
            <label style="display: block; font-size: 11px; color: #999; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px;">Additional Comments (Optional)</label>
            <textarea id="returnComments" class="swal2-textarea" placeholder="Please provide any additional details..." style="width: 100%; min-height: 80px; padding: 12px; border: 1px solid #e8dcc8; border-radius: 6px; font-size: 14px; resize: vertical;"></textarea>
          </div>
        `,
        showCancelButton: true,
        confirmButtonColor: '#2d1f14',
        cancelButtonColor: '#999',
        confirmButtonText: 'Initiate Return',
        cancelButtonText: 'Keep My Order',
        width: '500px',
        customClass: {
          popup: 'return-order-popup'
        },
        preConfirm: () => {
          const selectedReason = document.querySelector('input[name="returnReason"]:checked');
          if (!selectedReason) {
            Swal.showValidationMessage('Please select a reason for return');
            return false;
          }
          return {
            reason: selectedReason.value,
            comments: document.getElementById('returnComments').value
          };
        }
      });

      if (result.isConfirmed) {
        try {
          const response = await fetch(`/orders/${orderId}/return`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(result.value)
          });

          const data = await response.json();

          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Return Initiated',
              text: data.message,
              confirmButtonColor: '#2d1f14'
            }).then(() => location.reload());
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message,
              confirmButtonColor: '#2d1f14'
            });
          }
        } catch (error) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Failed to process return request',
            confirmButtonColor: '#2d1f14'
          });
        }
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const error = urlParams.get('error');
      if (error) {
        Swal.fire({ icon: 'error', title: 'Error', text: decodeURIComponent(error), confirmButtonColor: '#2d1f14' });
      }
    });
  </script>
</body>
</html>
