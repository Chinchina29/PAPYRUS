<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Listings - Papyrus</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: #f0ede8; color: #2d2418; display: flex; min-height: 100vh; }
    .seller-sidebar { width: 200px; background: #2d2418; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; padding: 28px 0; }
    .sidebar-logo { padding: 0 20px 28px; border-bottom: 1px solid #3d3020; font-family: 'Playfair Display', serif; font-size: 18px; color: #f0ede8; font-weight: 600; display: flex; align-items: center; gap: 8px; }
    .sidebar-logo svg { width: 20px; height: 20px; color: #c8a96e; }
    .sidebar-nav { flex: 1; padding: 20px 0; }
    .sidebar-nav a { display: flex; align-items: center; gap: 10px; padding: 11px 20px; color: #a09078; text-decoration: none; font-size: 13.5px; font-weight: 500; transition: all 0.2s; border-left: 3px solid transparent; }
    .sidebar-nav a:hover { color: #f0ede8; background: #3d3020; }
    .sidebar-nav a.active { color: #f0ede8; background: #3d3020; border-left-color: #c8a96e; }
    .sidebar-nav a svg { width: 15px; height: 15px; flex-shrink: 0; }
    .seller-tier { margin: 12px; background: #3d3020; border-radius: 8px; padding: 14px; font-size: 11px; }
    .tier-label { color: #a09078; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
    .tier-name { color: #c8a96e; font-weight: 600; font-size: 13px; margin-bottom: 8px; }
    .tier-bar { height: 3px; background: #2d2418; border-radius: 2px; }
    .tier-bar-fill { height: 100%; width: 72%; background: #c8a96e; border-radius: 2px; }
    .tier-hint { color: #807060; font-size: 10px; margin-top: 5px; }
    .main { margin-left: 200px; flex: 1; padding: 36px; }
    .top-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .top-nav-links { display: flex; gap: 28px; }
    .top-nav-links a { color: #6b5a48; text-decoration: none; font-size: 14px; font-weight: 500; }
    .top-nav-links a:hover { color: #2d2418; }
    .top-nav-brand { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600; color: #2d2418; }
    .top-nav-icons { display: flex; gap: 16px; align-items: center; }
    .top-nav-icons a { color: #6b5a48; text-decoration: none; }
    .top-nav-icons svg { width: 20px; height: 20px; }
    .page-header { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px; }
    .page-header h1 { font-family: 'Playfair Display', serif; font-size: 26px; color: #2d2418; }
    .page-header p { color: #7a6a58; font-size: 13px; margin-top: 4px; }
    .btn-create { display: flex; align-items: center; gap: 8px; background: #2d2418; color: white; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-size: 13.5px; font-weight: 500; transition: background 0.2s; white-space: nowrap; }
    .btn-create:hover { background: #3d3020; }
    .btn-create svg { width: 16px; height: 16px; }
    .search-bar { display: flex; gap: 10px; margin-bottom: 24px; align-items: center; }
    .search-wrap { flex: 1; position: relative; }
    .search-wrap input { width: 100%; padding: 10px 16px 10px 40px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 14px; background: white; outline: none; font-family: inherit; color: #2d2418; }
    .search-wrap input:focus { border-color: #8b7355; }
    .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: #9a8a78; }
    .filter-btn { display: flex; align-items: center; gap: 6px; padding: 10px 16px; border: 1.5px solid #e8dcc8; border-radius: 8px; background: white; font-size: 13.5px; cursor: pointer; color: #6b5a48; font-family: inherit; transition: background 0.2s; }
    .filter-btn:hover { background: #f5f1ed; }
    .filter-btn svg { width: 15px; height: 15px; }
    .listings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 32px; }
    .book-card { background: white; border-radius: 12px; border: 1px solid #e8dcc8; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: inherit; display: block; }
    .book-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(45,36,24,0.1); }
    .book-img { width: 100%; height: 200px; position: relative; background: #f5f1ed; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .book-img img { width: 100%; height: 100%; object-fit: cover; }
    .book-img-placeholder { font-size: 52px; color: #c8b89a; }
    .status-badge { position: absolute; top: 8px; left: 8px; font-size: 9px; font-weight: 700; letter-spacing: 0.8px; padding: 3px 8px; border-radius: 20px; text-transform: uppercase; }
    .status-badge.approved, .status-badge.active { background: #2d2418; color: white; }
    .status-badge.pending { background: #e8a020; color: white; }
    .status-badge.rejected { background: #c0392b; color: white; }
    .book-info { padding: 14px; }
    .book-title { font-size: 14px; font-weight: 600; color: #2d2418; margin-bottom: 2px; }
    .book-author { font-size: 12px; color: #c8a96e; margin-bottom: 8px; font-style: italic; }
    .book-price { font-size: 15px; font-weight: 600; color: #2d2418; float: right; }
    .book-meta { display: flex; align-items: center; gap: 12px; font-size: 11px; color: #9a8a78; margin-top: 8px; clear: both; }
    .book-meta svg { width: 12px; height: 12px; }
    .add-card { background: white; border: 2px dashed #d4c5b0; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 280px; cursor: pointer; transition: all 0.2s; text-decoration: none; }
    .add-card:hover { border-color: #8b7355; background: #faf8f5; }
    .add-icon { width: 44px; height: 44px; border-radius: 50%; background: #f5f1ed; display: flex; align-items: center; justify-content: center; color: #8b7355; margin-bottom: 10px; }
    .add-icon svg { width: 22px; height: 22px; }
    .add-label { font-size: 13px; color: #8b7355; font-weight: 500; }
    .empty-state { text-align: center; padding: 80px 20px; color: #9a8a78; }
    .empty-state svg { width: 48px; height: 48px; margin-bottom: 16px; opacity: 0.4; }
    .empty-state p { font-size: 15px; margin-bottom: 16px; }
    .empty-state a { display: inline-block; padding: 10px 24px; background: #2d2418; color: white; border-radius: 8px; text-decoration: none; font-size: 13.5px; }
    .admin-note { font-size: 11px; color: #c0392b; margin-top: 4px; background: #fdf0ef; padding: 4px 8px; border-radius: 4px; }
  </style>
</head>
<body>
  <div class="seller-sidebar">
    <div class="sidebar-logo">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      Papyrus
    </div>
    <nav class="sidebar-nav">
      <a href="/sell">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard Overview
      </a>
      <a href="/sell/my-listings" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        My Listings
      </a>
      <a href="#">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Sales Reports
      </a>
    </nav>
    <div class="seller-tier">
      <div class="tier-label">Seller Tier</div>
      <div class="tier-name">Pro Librarian</div>
      <div class="tier-bar"><div class="tier-bar-fill"></div></div>
      <div class="tier-hint">25 more sales to Master level</div>
    </div>
  </div>

  <div class="main">
    <div class="top-nav">
      <div class="top-nav-links">
        <a href="/shop">Browse</a>
        <a href="/sell">Sell</a>
        <a href="/about">About</a>
      </div>
      <div class="top-nav-brand">📖 Papyrus</div>
      <div class="top-nav-icons">
        <a href="/cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></a>
        <a href="/profile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      </div>
    </div>

    <div class="page-header">
      <div>
        <h1>My Listings</h1>
        <p>Manage, edit, and track your library of books.</p>
      </div>
      <a href="/sell/create" class="btn-create">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Create New Listing
      </a>
    </div>

    <div class="search-bar">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="text" id="searchInput" placeholder="Search by title, author or ISBN..."/>
      </div>
      <button class="filter-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="11" y1="18" x2="13" y2="18"/></svg>
        Filter
      </button>
    </div>

    <% if (submissions && submissions.length > 0) { %>
    <div class="listings-grid" id="listingsGrid">
      <% submissions.forEach(sub => { %>
      <a href="/sell/listing/<%= sub._id %>" class="book-card"
        data-title="<%= sub.title?.toLowerCase() %>"
        data-author="<%= sub.author?.toLowerCase() %>"
        data-isbn="<%= sub.isbn?.toLowerCase() %>">
        <div class="book-img">
          <% if (sub.images && sub.images.length > 0) { %>
            <img src="<%= typeof sub.images[0] === 'string' ? sub.images[0] : sub.images[0].url %>" alt="<%= sub.title %>"/>
          <% } else { %>
            <div class="book-img-placeholder">📚</div>
          <% } %>
          <span class="status-badge <%= sub.status %>"><%= sub.status %></span>
        </div>
        <div class="book-info">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <div class="book-title"><%= sub.title %></div>
            <div class="book-price">₹<%= sub.price %></div>
          </div>
          <div class="book-author"><%= sub.author || 'Unknown author' %></div>
          <% if (sub.status === 'rejected' && sub.adminNote) { %>
            <div class="admin-note">Rejected: <%= sub.adminNote %></div>
          <% } %>
          <div class="book-meta">
            <span style="display:flex;align-items:center;gap:3px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              0 Views
            </span>
            <span style="display:flex;align-items:center;gap:3px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <%= new Date(sub.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %>
            </span>
          </div>
        </div>
      </a>
      <% }) %>
      <a href="/sell/create" class="add-card">
        <div class="add-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div class="add-label">Add another book</div>
      </a>
    </div>
    <% } else { %>
    <div class="empty-state">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <p>You haven't listed any books yet.</p>
      <a href="/sell/create">Create Your First Listing</a>
    </div>
    <% } %>
  </div>

  <script>
    document.getElementById('searchInput').addEventListener('input', function() {
      const q = this.value.toLowerCase();
      document.querySelectorAll('.book-card').forEach(card => {
        const title = card.dataset.title || '';
        const author = card.dataset.author || '';
        const isbn = card.dataset.isbn || '';
        card.style.display = (title.includes(q) || author.includes(q) || isbn.includes(q)) ? '' : 'none';
      });
    });
  </script>
</body>
</html>