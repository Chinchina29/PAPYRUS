<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Unsuccessful - Papyrus</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #f5f2ed;
      font-family: 'Inter', -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 32px 16px;
    }

    /* ── Logo ── */
    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      color: #1e3a1e;
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 24px;
    }
    .logo-icon {
      font-size: 26px;
    }

    /* ── Card ── */
    .card {
      background: #fff;
      border-radius: 16px;
      padding: 48px 40px 36px;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }

    /* ── Icon ── */
    .icon-wrap {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: #fce8e8;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 28px;
    }
    .icon-wrap svg {
      width: 32px;
      height: 32px;
      color: #e05555;
    }

    /* ── Text ── */
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 26px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 12px;
    }
    .subtitle {
      font-size: 14px;
      color: #777;
      line-height: 1.65;
      margin-bottom: 28px;
    }

    /* ── Order Info ── */
    .order-info {
      display: flex;
      justify-content: space-between;
      background: #f9f7f4;
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 28px;
      text-align: left;
    }
    .info-item {}
    .info-label {
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #999;
      margin-bottom: 5px;
    }
    .info-value {
      font-size: 14px;
      font-weight: 600;
      color: #1a1a1a;
    }
    .info-value.amount {
      color: #2e6b2e;
    }

    /* ── Buttons ── */
    .btn-primary {
      display: block;
      width: 100%;
      padding: 15px;
      background: #1e3a1e;
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-bottom: 12px;
      letter-spacing: 0.2px;
    }
    .btn-primary:hover:not(:disabled) {
      background: #163016;
      transform: translateY(-1px);
    }
    .btn-primary:disabled {
      opacity: 0.65;
      cursor: not-allowed;
    }

    .btn-secondary {
      display: block;
      width: 100%;
      padding: 14px;
      background: #fff;
      color: #1a1a1a;
      border: 1.5px solid #ddd;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 500;
      font-family: 'Inter', sans-serif;
      cursor: pointer;
      text-decoration: none;
      transition: border-color 0.2s, background 0.2s;
      margin-bottom: 20px;
    }
    .btn-secondary:hover {
      border-color: #1e3a1e;
      background: #f9f7f4;
    }

    /* ── Support Link ── */
    .support-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 13px;
      color: #666;
      text-decoration: none;
      margin-bottom: 24px;
      transition: color 0.2s;
    }
    .support-link:hover { color: #1e3a1e; }
    .support-link svg {
      width: 15px;
      height: 15px;
    }

    /* ── Back Link ── */
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 13px;
      color: #999;
      text-decoration: none;
      transition: color 0.2s;
      border-top: 1px solid #f0f0f0;
      padding-top: 20px;
      width: 100%;
      justify-content: center;
    }
    .back-link:hover { color: #1e3a1e; }

    /* ── Footer ── */
    footer {
      margin-top: 24px;
      display: flex;
      gap: 24px;
      align-items: center;
    }
    .footer-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      color: #aaa;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .footer-badge svg {
      width: 14px;
      height: 14px;
      color: #bbb;
    }
    .copyright {
      font-size: 11px;
      color: #bbb;
      margin-top: 10px;
    }

    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    .spinning { animation: spin 0.9s linear infinite; }
  </style>
</head>
<body>

  <!-- Logo -->
  <a href="/home" class="logo">
    <span class="logo-icon">📖</span>
    Papyrus
  </a>

  <!-- Main Card -->
  <div class="card">

    <!-- Failure Icon -->
    <div class="icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <line x1="12" y1="8" x2="12" y2="12"/>
        <line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
    </div>

    <h1>Payment Unsuccessful</h1>
    <p class="subtitle">
      Something went wrong with your transaction.<br>
      Please check your payment details or try another<br>
      method to complete your purchase.
    </p>

    <!-- Order Info -->
    <div class="order-info">
      <div class="info-item">
        <div class="info-label">Transaction Reference</div>
        <div class="info-value">#<%= order.orderId %></div>
      </div>
      <div class="info-item" style="text-align:right;">
        <div class="info-label">Total Amount</div>
        <div class="info-value amount">₹<%= order.totalAmount.toFixed(2) %></div>
      </div>
    </div>

    <!-- Retry Button -->
    <button id="retryPaymentBtn" class="btn-primary" onclick="retryPayment()">
      Retry Payment
    </button>

    <!-- Go to Cart -->
    <a href="/cart" class="btn-secondary">Go to Cart</a>

    <!-- Contact Support -->
    <a href="/support" class="support-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Contact Support
    </a>

    <!-- Back Link -->
    <a href="/cart" class="back-link">
      ← Return to Shopping Cart
    </a>

  </div>

  <!-- Footer -->
  <div style="display:flex;flex-direction:column;align-items:center;gap:0;">
    <footer>
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Secure Checkout
      </span>
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
          <line x1="8" y1="21" x2="16" y2="21"/>
          <line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
        Encrypted Data
      </span>
    </footer>
    <p class="copyright">© 2024 Papyrus, a Used Book Marketplace. All rights reserved.</p>
  </div>

  <script>
    const MONGO_ORDER_ID  = '<%= mongoOrderId %>';
    const RAZORPAY_KEY_ID = '<%= razorpayKeyId %>';
    const ORDER_NUMBER    = '<%= orderId %>';
    const USER_NAME  = '<%= user ? (user.firstName + " " + user.lastName) : "" %>';
    const USER_EMAIL = '<%= user ? user.email : "" %>';

    async function retryPayment() {
      const btn = document.getElementById('retryPaymentBtn');
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.innerHTML = '<svg class="spinning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;display:inline;margin-right:8px;vertical-align:middle;"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg>Processing...';

      try {
        const res  = await fetch(`/payment/retry/${MONGO_ORDER_ID}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();

        if (!data.success) {
          alert(data.message || 'Unable to initiate retry. Please try again.');
          btn.disabled = false;
          btn.textContent = originalText;
          return;
        }

        const options = {
          key:         data.razorpayKeyId,
          amount:      data.amount,
          currency:    data.currency,
          name:        'Papyrus',
          description: `Order #${ORDER_NUMBER}`,
          order_id:    data.razorpayOrderId,
          prefill:     { name: USER_NAME, email: USER_EMAIL },
          theme:       { color: '#1e3a1e' },
          handler: async function (response) {
            try {
              const verifyRes  = await fetch('/payment/verify', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id:   response.razorpay_order_id,
                  razorpay_signature:  response.razorpay_signature,
                  orderId: MONGO_ORDER_ID,
                }),
              });
              const verifyData = await verifyRes.json();
              if (verifyData.success) {
                window.location.href = `/payment/success?orderId=${MONGO_ORDER_ID}`;
              } else {
                alert('Payment verification failed. Please contact support.');
                window.location.reload();
              }
            } catch (err) {
              alert('An error occurred during verification. Please contact support.');
              window.location.reload();
            }
          },
          modal: {
            ondismiss: async function () {
              try {
                await fetch('/payment/failure', {
                  method:  'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ orderId: MONGO_ORDER_ID, reason: 'Payment cancelled by user' }),
                });
              } catch (_) {}
              btn.disabled = false;
              btn.textContent = originalText;
            },
          },
        };

        const rzp = new Razorpay(options);
        rzp.on('payment.failed', async function (response) {
          try {
            await fetch('/payment/failure', {
              method:  'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId: MONGO_ORDER_ID, reason: response.error.description }),
            });
          } catch (_) {}
          window.location.reload();
        });
        rzp.open();

      } catch (err) {
        alert('Something went wrong. Please try again.');
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }
  </script>
</body>
</html>