<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Unsuccessful - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <style>
    body { 
      background: linear-gradient(135deg, #f8f6f3 0%, #e8ddd4 100%);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
    }

    .failure-container {
      background: white;
      border-radius: 20px;
      padding: 48px;
      max-width: 600px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(45, 31, 20, 0.1);
      border: 1px solid #e8dcc8;
    }

    .failure-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      animation: failureShake 1s ease-in-out;
    }

    @keyframes failureShake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
      20%, 40%, 60%, 80% { transform: translateX(5px); }
    }

    .failure-icon svg {
      width: 40px;
      height: 40px;
      color: white;
    }

    .failure-title {
      font-size: 32px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 12px;
    }

    .failure-message {
      font-size: 16px;
      color: #666;
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .error-details {
      background: #fff3f3;
      border: 1px solid #ffcdd2;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 32px;
      text-align: left;
    }

    .error-title {
      font-size: 14px;
      font-weight: 600;
      color: #d32f2f;
      margin-bottom: 8px;
    }

    .error-text {
      font-size: 14px;
      color: #666;
      margin-bottom: 16px;
    }

    .troubleshoot-tips {
      background: #f8f9fa;
      border-radius: 8px;
      padding: 16px;
      text-align: left;
    }

    .tips-title {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #666;
      margin-bottom: 12px;
    }

    .tips-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .tips-list li {
      font-size: 13px;
      color: #666;
      margin-bottom: 8px;
      padding-left: 16px;
      position: relative;
    }

    .tips-list li:before {
      content: '•';
      color: #f57c00;
      font-size: 16px;
      position: absolute;
      left: 0;
      top: -2px;
    }

    .order-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .info-item {
      text-align: left;
    }

    .info-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #999;
      margin-bottom: 4px;
    }

    .info-value {
      font-size: 14px;
      color: #2d1f14;
      font-weight: 500;
    }

    .action-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      margin-bottom: 24px;
    }

    .btn {
      padding: 14px 28px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Poppins', sans-serif;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, #f57c00 0%, #ef6c00 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(245, 124, 0, 0.3);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #ef6c00 0%, #e65100 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(245, 124, 0, 0.4);
    }

    .btn-secondary {
      background: white;
      color: #2d1f14;
      border: 2px solid #2d1f14;
      box-shadow: 0 2px 8px rgba(45, 31, 20, 0.1);
    }

    .btn-secondary:hover {
      background: #2d1f14;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(45, 31, 20, 0.2);
    }

    .support-section {
      background: #f8f6f3;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 24px;
    }

    .support-title {
      font-size: 16px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 12px;
    }

    .support-text {
      font-size: 14px;
      color: #666;
      margin-bottom: 16px;
    }

    .support-links {
      display: flex;
      justify-content: center;
      gap: 24px;
    }

    .support-link {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: #f57c00;
      text-decoration: none;
      transition: color 0.2s;
      font-weight: 500;
    }

    .support-link:hover {
      color: #ef6c00;
    }

    .security-note {
      font-size: 12px;
      color: #999;
      text-align: center;
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid #e8ddd4;
    }

    @media (max-width: 768px) {
      .failure-container {
        padding: 32px 24px;
        margin: 20px;
      }

      .order-info {
        grid-template-columns: 1fr;
      }

      .action-buttons {
        flex-direction: column;
      }

      .support-links {
        flex-direction: column;
        gap: 12px;
      }
    }
  </style>
</head>
<body>
  <div class="failure-container">
    <div class="failure-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"/>
        <line x1="15" y1="9" x2="9" y2="15"/>
        <line x1="9" y1="9" x2="15" y2="15"/>
      </svg>
    </div>

    <h1 class="failure-title">Payment Unsuccessful</h1>
    <p class="failure-message">
      Something went wrong with your transaction. Please check your payment details or try another method to complete your purchase.
    </p>

    <div class="order-info">
      <div class="info-item">
        <div class="info-label">Transaction Reference</div>
        <div class="info-value"><%= order.orderId %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Total Amount</div>
        <div class="info-value">₹<%= order.totalAmount.toFixed(2) %></div>
      </div>
    </div>

    <div class="error-details">
      <div class="error-title">What Happened?</div>
      <div class="error-text">
        <% if (order.paymentFailureReason) { %>
          <%= order.paymentFailureReason %>
        <% } else { %>
          Your payment could not be processed at this time. This could be due to insufficient funds, card restrictions, or a temporary issue with your bank.
        <% } %>
      </div>
      
      <div class="troubleshoot-tips">
        <div class="tips-title">Quick Fixes</div>
        <ul class="tips-list">
          <li>Check if your card has sufficient balance or credit limit</li>
          <li>Ensure your card is enabled for online transactions</li>
          <li>Verify that all payment details are entered correctly</li>
          <li>Try using a different payment method or card</li>
          <li>Check if your bank has blocked the transaction</li>
        </ul>
      </div>
    </div>

    <div class="action-buttons">
      <button id="retryPaymentBtn" class="btn btn-primary" onclick="retryPayment()">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
          <polyline points="1 4 1 10 7 10"/>
          <path d="M3.51 15a9 9 0 1 0 .49-3.51"/>
        </svg>
        Retry Payment
      </button>
      <a href="/orders" class="btn btn-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
        </svg>
        View My Orders
      </a>
    </div>

    <div class="support-section">
      <div class="support-title">Need Help?</div>
      <div class="support-text">
        If the problem persists, our support team is here to help you complete your purchase.
      </div>
      <div class="support-links">
        <a href="#" class="support-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          Contact Support
        </a>
        <a href="/home" class="support-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Return to Shopping
        </a>
      </div>
    </div>

    <div class="security-note">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px; display: inline; margin-right: 6px;">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <path d="M9 12l2 2 4-4"/>
      </svg>
      Your payment information is secure and has not been charged for this failed transaction.
    </div>
  </div>

  <script>
    const MONGO_ORDER_ID  = '<%= mongoOrderId %>';
    const RAZORPAY_KEY_ID = '<%= razorpayKeyId %>';
    const ORDER_NUMBER    = '<%= orderId %>';
    const USER_NAME = '<%= user ? (user.firstName + " " + user.lastName) : "" %>';
    const USER_EMAIL = '<%= user ? user.email : "" %>';

    async function retryPayment() {
      const btn = document.getElementById('retryPaymentBtn');
      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;animation:spin 1s linear infinite"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-3.51"/></svg> Processing...';

      try {
        const res = await fetch(`/payment/retry/${MONGO_ORDER_ID}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();

        if (!data.success) {
          alert(data.message || 'Unable to initiate retry. Please try again.');
          btn.disabled = false;
          btn.innerHTML = originalHTML;
          return;
        }

        // Open Razorpay modal with the fresh order
        const options = {
          key: data.razorpayKeyId,
          amount: data.amount,
          currency: data.currency,
          name: 'Papyrus',
          description: `Order #${ORDER_NUMBER}`,
          order_id: data.razorpayOrderId,
          prefill: { name: USER_NAME, email: USER_EMAIL },
          theme: { color: '#f57c00' },
          handler: async function (response) {
            // Verify payment on success
            try {
              const verifyRes = await fetch('/payment/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_order_id:   response.razorpay_order_id,
                  razorpay_signature:  response.razorpay_signature,
                  orderId: MONGO_ORDER_ID,
                }),
              });
              const verifyData = await verifyRes.json();
              if (verifyData.success) {
                window.location.href = `/payment/success?orderId=${MONGO_ORDER_ID}`;
              } else {
                alert('Payment verification failed. Please contact support.');
                window.location.reload();
              }
            } catch (err) {
              alert('An error occurred during verification. Please contact support.');
              window.location.reload();
            }
          },
          modal: {
            ondismiss: async function () {
              // Record failure when user closes the modal without paying
              try {
                await fetch('/payment/failure', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ orderId: MONGO_ORDER_ID, reason: 'Payment cancelled by user' }),
                });
              } catch (_) {}
              btn.disabled = false;
              btn.innerHTML = originalHTML;
            },
          },
        };

        const rzp = new Razorpay(options);
        rzp.on('payment.failed', async function (response) {
          try {
            await fetch('/payment/failure', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId: MONGO_ORDER_ID, reason: response.error.description }),
            });
          } catch (_) {}
          window.location.reload();
        });
        rzp.open();

      } catch (err) {
        alert('Something went wrong. Please try again.');
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    }
  </script>
  <style>
    @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  </style>
</body>
</html>