<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Successful - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { 
      background: linear-gradient(135deg, #f8f6f3 0%, #e8ddd4 100%);
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0;
      padding: 20px;
    }

    .success-container {
      background: white;
      border-radius: 20px;
      padding: 48px;
      max-width: 600px;
      width: 100%;
      text-align: center;
      box-shadow: 0 20px 40px rgba(45, 31, 20, 0.1);
      border: 1px solid #e8dcc8;
    }

    .success-icon {
      width: 80px;
      height: 80px;
      background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 24px;
      animation: successPulse 1.5s ease-in-out;
    }

    @keyframes successPulse {
      0% { transform: scale(0.8); opacity: 0.7; }
      50% { transform: scale(1.1); opacity: 1; }
      100% { transform: scale(1); opacity: 1; }
    }

    .success-icon svg {
      width: 40px;
      height: 40px;
      color: white;
    }

    .success-title {
      font-size: 32px;
      font-weight: 600;
      color: #2d1f14;
      margin-bottom: 12px;
    }

    .success-message {
      font-size: 16px;
      color: #666;
      margin-bottom: 32px;
      line-height: 1.6;
    }

    .order-summary {
      background: #f8f6f3;
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 32px;
      text-align: left;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 12px;
      font-size: 14px;
    }

    .summary-row:last-child {
      margin-bottom: 0;
      font-weight: 600;
      font-size: 18px;
      padding-top: 12px;
      border-top: 2px solid #e8ddd4;
    }

    .order-info {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }

    .info-item {
      text-align: left;
    }

    .info-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #999;
      margin-bottom: 4px;
    }

    .info-value {
      font-size: 14px;
      color: #2d1f14;
      font-weight: 500;
    }

    .book-illustration {
      margin: 24px 0;
      opacity: 0.8;
    }

    .book-icon {
      width: 120px;
      height: 120px;
      background: linear-gradient(135deg, #8b7355 0%, #6b5a48 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto;
      position: relative;
      box-shadow: 0 8px 16px rgba(45, 31, 20, 0.2);
    }

    .book-icon::before {
      content: '';
      position: absolute;
      top: 20px;
      left: 20px;
      right: 20px;
      bottom: 20px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 4px;
      border-left: 2px solid rgba(255, 255, 255, 0.3);
    }

    .book-icon::after {
      content: '📚';
      font-size: 48px;
      z-index: 1;
    }

    .action-buttons {
      display: flex;
      gap: 16px;
      justify-content: center;
      margin-bottom: 24px;
    }

    .btn {
      padding: 14px 28px;
      border-radius: 10px;
      font-size: 16px;
      font-weight: 600;
      font-family: 'Poppins', sans-serif;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: none;
    }

    .btn-primary {
      background: linear-gradient(135deg, #2d1f14 0%, #3d2f24 100%);
      color: white;
      box-shadow: 0 4px 12px rgba(45, 31, 20, 0.2);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #1a1209 0%, #2d1f14 100%);
      transform: translateY(-2px);
      box-shadow: 0 6px 16px rgba(45, 31, 20, 0.3);
    }

    .btn-secondary {
      background: white;
      color: #2d1f14;
      border: 2px solid #2d1f14;
      box-shadow: 0 2px 8px rgba(45, 31, 20, 0.1);
    }

    .btn-secondary:hover {
      background: #2d1f14;
      color: white;
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(45, 31, 20, 0.2);
    }

    .support-links {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: 24px;
    }

    .support-link {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 14px;
      color: #666;
      text-decoration: none;
      transition: color 0.2s;
    }

    .support-link:hover {
      color: #2d1f14;
    }

    .security-badges {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 16px;
      margin-top: 32px;
      padding-top: 24px;
      border-top: 1px solid #e8ddd4;
      font-size: 12px;
      color: #999;
    }

    @media (max-width: 768px) {
      .success-container {
        padding: 32px 24px;
        margin: 20px;
      }

      .order-info {
        grid-template-columns: 1fr;
      }

      .action-buttons {
        flex-direction: column;
      }

      .support-links {
        flex-direction: column;
        gap: 12px;
      }
    }
  </style>
</head>
<body>
  <div class="success-container">
    <div class="success-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>

    <h1 class="success-title">Payment Successful!</h1>
    <p class="success-message">
      Your order has been placed and is now being processed. Thank you for your purchase!
    </p>

    <div class="order-info">
      <div class="info-item">
        <div class="info-label">Order Reference</div>
        <div class="info-value"><%= orderSummary.orderId %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Total Amount</div>
        <div class="info-value">₹<%= orderSummary.totalAmount.toFixed(2) %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Payment Method</div>
        <div class="info-value"><%= orderSummary.paymentMethod %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Expected Delivery</div>
        <div class="info-value"><%= orderSummary.estimatedDelivery.formatted %></div>
      </div>
    </div>

    <div class="book-illustration">
      <div class="book-icon"></div>
    </div>

    <div class="order-summary">
      <div class="summary-row">
        <span>Items (<%= orderSummary.items.length %>)</span>
        <span>₹<%= breakdown.subtotal.toFixed(2) %></span>
      </div>
      
      <div class="summary-row">
        <span>Shipping</span>
        <span><%= breakdown.shipping === 0 ? 'FREE' : '₹' + breakdown.shipping.toFixed(2) %></span>
      </div>
      
      <% if (breakdown.discount > 0) { %>
      <div class="summary-row">
        <span>Discount<% if (couponInfo) { %> (<%= couponInfo.code %>)<% } %></span>
        <span>-₹<%= breakdown.discount.toFixed(2) %></span>
      </div>
      <% } %>
      
      <div class="summary-row">
        <span>Total Paid</span>
        <span>₹<%= breakdown.total.toFixed(2) %></span>
      </div>
    </div>

    <div class="action-buttons">
      <a href="<%= navigation.orderDetailsUrl %>" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
          <path d="M9 12l2 2 4-4"/>
          <path d="M21 12c-1 0-3-1-3-3s2-3 3-3 3 1 3 3-2 3-3 3"/>
          <path d="M3 12c1 0 3-1 3-3s-2-3-3-3-3 1-3 3 2 3 3 3"/>
          <path d="M3 12h6m6 0h6"/>
        </svg>
        View Order Details
      </a>
      <a href="<%= navigation.continueShoppingUrl %>" class="btn btn-secondary">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        Continue Shopping
      </a>
    </div>

    <div class="support-links">
      <a href="#" class="support-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        Contact Support
      </a>
      <a href="/home" class="support-link">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
          <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7z"/>
        </svg>
        Return to Shopping
      </a>
    </div>

    <div class="security-badges">
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="M9 12l2 2 4-4"/>
        </svg>
        Secure Checkout
      </span>
      <span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <circle cx="12" cy="16" r="1"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Encrypted Data
      </span>
    </div>
  </div>

  <script>
    setTimeout(() => {
      document.querySelector('.success-container').style.opacity = '1';
    }, 100);
  </script>
</body>
</html>