<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Successful - Papyrus</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #f5f2ed;
      font-family: 'Inter', -apple-system, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      padding: 32px 16px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      color: #1e3a1e;
      font-weight: 600;
      text-decoration: none;
      margin-bottom: 24px;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      padding: 44px 40px 36px;
      max-width: 500px;
      width: 100%;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    }

    .icon-wrap {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: #2e7d32;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 28px;
      animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .icon-wrap svg { width: 34px; height: 34px; color: #fff; }
    @keyframes popIn {
      0%   { transform: scale(0.6); opacity: 0; }
      80%  { transform: scale(1.08); }
      100% { transform: scale(1); opacity: 1; }
    }

    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 26px;
      font-weight: 600;
      color: #1a1a1a;
      margin-bottom: 10px;
    }
    .subtitle {
      font-size: 14px;
      color: #777;
      line-height: 1.65;
      margin-bottom: 22px;
    }

    /* Order reference strip */
    .order-info {
      display: flex;
      justify-content: space-between;
      background: #f9f7f4;
      border-radius: 10px;
      padding: 14px 18px;
      margin-bottom: 18px;
      text-align: left;
    }
    .info-label {
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: #999;
      margin-bottom: 4px;
    }
    .info-value { font-size: 13px; font-weight: 600; color: #1a1a1a; }
    .info-value.amount { color: #2e7d32; }

    /* Book item row */
    .book-item {
      display: flex;
      align-items: center;
      gap: 14px;
      background: #f9f7f4;
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 6px;
      text-align: left;
    }
    .book-cover {
      width: 52px;
      height: 68px;
      border-radius: 6px;
      background: #2e7d32;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      overflow: hidden;
    }
    .book-cover img { width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
    .book-meta { flex: 1; }
    .book-title  { font-size: 14px; font-weight: 600; color: #1a1a1a; margin-bottom: 2px; }
    .book-author { font-size: 12px; color: #888; margin-bottom: 8px; }
    .delivery-row { display: flex; align-items: center; gap: 5px; }
    .delivery-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.4px; color: #bbb; display: block; }
    .delivery-date  { font-size: 12px; color: #555; font-weight: 500; }
    .delivery-row svg { width: 12px; height: 12px; color: #888; flex-shrink: 0; }

    .more-items { font-size: 12px; color: #999; text-align: right; margin-bottom: 20px; }

    /* Buttons */
    .btn-primary {
      display: block; width: 100%; padding: 15px;
      background: #1e3a1e; color: #fff; border: none;
      border-radius: 10px; font-size: 15px; font-weight: 600;
      font-family: 'Inter', sans-serif; cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      margin-bottom: 12px; text-decoration: none; text-align: center;
    }
    .btn-primary:hover { background: #163016; transform: translateY(-1px); }

    .btn-secondary {
      display: block; width: 100%; padding: 14px;
      background: #fff; color: #1a1a1a;
      border: 1.5px solid #ddd; border-radius: 10px;
      font-size: 15px; font-weight: 500;
      font-family: 'Inter', sans-serif; cursor: pointer;
      text-decoration: none; text-align: center;
      transition: border-color 0.2s, background 0.2s;
      margin-bottom: 20px;
    }
    .btn-secondary:hover { border-color: #1e3a1e; background: #f9f7f4; }

    .support-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 13px; color: #666; text-decoration: none;
      margin-bottom: 24px; transition: color 0.2s;
    }
    .support-link:hover { color: #1e3a1e; }
    .support-link svg { width: 15px; height: 15px; }

    .back-link {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 13px; color: #999; text-decoration: none;
      transition: color 0.2s; border-top: 1px solid #f0f0f0;
      padding-top: 20px; width: 100%; justify-content: center;
    }
    .back-link:hover { color: #1e3a1e; }

    footer { margin-top: 24px; display: flex; gap: 24px; align-items: center; }
    .footer-badge {
      display: flex; align-items: center; gap: 6px;
      font-size: 11px; color: #aaa;
      text-transform: uppercase; letter-spacing: 0.5px;
    }
    .footer-badge svg { width: 14px; height: 14px; color: #bbb; }
    .copyright { font-size: 11px; color: #bbb; margin-top: 10px; }
  </style>
</head>
<body>

  <a href="/home" class="logo">📖 Papyrus</a>

  <div class="card">

    <div class="icon-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
           stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </div>

    <h1>Payment Successful</h1>
    <p class="subtitle">
      Your order has been placed and is now being<br>processed. Thank you for your purchase!
    </p>

    <!-- Order Reference Strip -->
    <div class="order-info">
      <div>
        <div class="info-label">Transaction Reference</div>
        <div class="info-value">#<%= order.orderId %></div>
      </div>
      <div style="text-align:right;">
        <div class="info-label">Total Amount</div>
        <div class="info-value amount">₹<%= order.totalAmount.toFixed(2) %></div>
      </div>
    </div>

    <!-- First Book Item -->
    <% if (order.items && order.items.length > 0) {
         const first = order.items[0];
         const prod  = first.product || {};
         const img   = (prod.images && prod.images[0]) ? prod.images[0] : null;
         const title = first.title || prod.title || 'Your Book';
         const author = first.author || prod.author || '';
         const deliveryDate = new Date();
         deliveryDate.setDate(deliveryDate.getDate() + 5);
         const deliveryEnd  = new Date();
         deliveryEnd.setDate(deliveryEnd.getDate() + 7);
         const fmt = { month: 'short', day: 'numeric' };
    %>
    <div class="book-item">
      <div class="book-cover">
        <% if (img) { %>
          <img src="<%= img %>" alt="<%= title %>"/>
        <% } else { %>
          📗
        <% } %>
      </div>
      <div class="book-meta">
        <div class="book-title"><%= title %></div>
        <% if (author) { %><div class="book-author"><%= author %></div><% } %>
        <div class="delivery-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="3" width="15" height="13"/>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
            <circle cx="18.5" cy="18.5" r="2.5"/>
          </svg>
          <div>
            <span class="delivery-label">Expected Delivery</span>
            <span class="delivery-date">
              <%= deliveryDate.toLocaleDateString('en-US', fmt) %> –
              <%= deliveryEnd.toLocaleDateString('en-US', fmt) %>
            </span>
          </div>
        </div>
      </div>
    </div>
    <% if (order.items.length > 1) { %>
      <p class="more-items">+<%= order.items.length - 1 %> more item<%= order.items.length > 2 ? 's' : '' %></p>
    <% } else { %>
      <div style="margin-bottom:20px;"></div>
    <% }
    } %>

    <!-- CTA Buttons -->
    <a href="/orders/<%= order._id %>" class="btn-primary">Track Order</a>
    <a href="/home" class="btn-secondary">Go to Home</a>

    <a href="#" class="support-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Contact Support
    </a>

    <a href="/shop" class="back-link">← Return to Shopping</a>
  </div>

  <div style="display:flex;flex-direction:column;align-items:center;">
    <footer>
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        Secure Checkout
      </span>
      <span class="footer-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="3" width="20" height="14" rx="2"/>
          <line x1="8" y1="21" x2="16" y2="21"/>
          <line x1="12" y1="17" x2="12" y2="21"/>
        </svg>
        Encrypted Data
      </span>
    </footer>
    <p class="copyright">© 2024 Papyrus, a Used Book Marketplace. All rights reserved.</p>
  </div>

</body>
</html>