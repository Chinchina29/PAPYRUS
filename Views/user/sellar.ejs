<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Seller Dashboard - Papyrus</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet"/>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'DM Sans', sans-serif; background: #f0ede8; color: #2d2418; display: flex; min-height: 100vh; }
    .seller-sidebar { width: 200px; background: #2d2418; color: #c8b89a; display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; z-index: 100; padding: 28px 0; }
    .sidebar-logo { padding: 0 20px 28px; border-bottom: 1px solid #3d3020; font-family: 'Playfair Display', serif; font-size: 18px; color: #f0ede8; font-weight: 600; display: flex; align-items: center; gap: 8px; }
    .sidebar-logo svg { width: 20px; height: 20px; color: #c8a96e; }
    .sidebar-nav { flex: 1; padding: 20px 0; }
    .sidebar-nav a { display: flex; align-items: center; gap: 10px; padding: 11px 20px; color: #a09078; text-decoration: none; font-size: 13.5px; font-weight: 500; transition: all 0.2s; border-left: 3px solid transparent; }
    .sidebar-nav a:hover { color: #f0ede8; background: #3d3020; }
    .sidebar-nav a.active { color: #f0ede8; background: #3d3020; border-left-color: #c8a96e; }
    .sidebar-nav a svg { width: 15px; height: 15px; flex-shrink: 0; }
    .seller-tier { margin: 12px; background: #3d3020; border-radius: 8px; padding: 14px; font-size: 11px; }
    .tier-label { color: #a09078; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 4px; }
    .tier-name { color: #c8a96e; font-weight: 600; font-size: 13px; margin-bottom: 8px; }
    .tier-bar { height: 3px; background: #2d2418; border-radius: 2px; }
    .tier-bar-fill { height: 100%; width: 72%; background: #c8a96e; border-radius: 2px; }
    .tier-hint { color: #807060; font-size: 10px; margin-top: 5px; }
    .main { margin-left: 200px; flex: 1; padding: 36px; }
    .top-nav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
    .top-nav-links { display: flex; gap: 28px; }
    .top-nav-links a { color: #6b5a48; text-decoration: none; font-size: 14px; font-weight: 500; }
    .top-nav-links a:hover { color: #2d2418; }
    .top-nav-brand { font-family: 'Playfair Display', serif; font-size: 20px; font-weight: 600; color: #2d2418; }
    .top-nav-icons { display: flex; gap: 16px; align-items: center; }
    .top-nav-icons a { color: #6b5a48; text-decoration: none; }
    .top-nav-icons svg { width: 20px; height: 20px; }
    .breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-size: 13px; color: #9a8a78; }
    .breadcrumb a { color: #8b7355; text-decoration: none; transition: color 0.2s; }
    .breadcrumb a:hover { color: #2d2418; }
    .breadcrumb-separator { color: #c8b89a; }
    .breadcrumb span { color: #2d2418; font-weight: 500; }
    .page-header { margin-bottom: 28px; }
    .page-header h1 { font-family: 'Playfair Display', serif; font-size: 28px; font-weight: 600; color: #2d2418; }
    .page-header p { color: #7a6a58; font-size: 14px; margin-top: 4px; }
    .stats-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 32px; }
    .stat-card { background: white; border-radius: 12px; padding: 22px; border: 1px solid #e8dcc8; position: relative; overflow: hidden; }
    .stat-badge { position: absolute; top: 16px; right: 16px; font-size: 11px; font-weight: 600; color: #2e7d32; background: #edfaf3; padding: 2px 8px; border-radius: 20px; }
    .stat-badge.neutral { color: #7a6a58; background: #f5f1ed; }
    .stat-icon { width: 32px; height: 32px; color: #8b7355; margin-bottom: 12px; }
    .stat-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px; color: #9a8a78; font-weight: 600; margin-bottom: 6px; }
    .stat-value { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 600; color: #2d2418; }
    .section-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
    .section-title { font-family: 'Playfair Display', serif; font-size: 20px; color: #2d2418; }
    .section-sub { font-size: 12px; color: #9a8a78; margin-top: 2px; }
    .view-all { font-size: 13px; color: #8b7355; text-decoration: none; font-weight: 500; }
    .view-all:hover { color: #2d2418; }
    .listings-grid { display: grid; grid-template-columns: 160px repeat(3, 1fr); gap: 14px; margin-bottom: 32px; }
    .create-card { background: white; border: 2px dashed #d4c5b0; border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; cursor: pointer; transition: all 0.2s; text-decoration: none; min-height: 220px; }
    .create-card:hover { border-color: #8b7355; background: #faf8f5; }
    .create-icon { width: 40px; height: 40px; border-radius: 50%; background: #f5f1ed; display: flex; align-items: center; justify-content: center; color: #8b7355; margin-bottom: 10px; }
    .create-icon svg { width: 20px; height: 20px; }
    .create-label { font-size: 12px; color: #8b7355; font-weight: 500; text-align: center; }
    .book-card { background: white; border-radius: 12px; border: 1px solid #e8dcc8; overflow: hidden; transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; color: inherit; display: block; }
    .book-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(45,36,24,0.1); }
    .book-img { width: 100%; height: 160px; position: relative; background: #f5f1ed; display: flex; align-items: center; justify-content: center; overflow: hidden; }
    .book-img img { width: 100%; height: 100%; object-fit: cover; }
    .book-img-placeholder { font-size: 40px; }
    .status-badge { position: absolute; top: 8px; left: 8px; font-size: 9px; font-weight: 700; letter-spacing: 0.8px; padding: 3px 8px; border-radius: 20px; text-transform: uppercase; }
    .status-badge.approved, .status-badge.active { background: #2d2418; color: white; }
    .status-badge.pending { background: #e8a020; color: white; }
    .status-badge.rejected { background: #c0392b; color: white; }
    .book-info { padding: 12px; }
    .book-title { font-size: 13px; font-weight: 600; color: #2d2418; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .book-author { font-size: 11px; color: #9a8a78; margin-bottom: 4px; }
    .book-price { font-weight: 600; color: #2d2418; font-size: 13px; }
    .activity-card { background: white; border-radius: 12px; border: 1px solid #e8dcc8; overflow: hidden; margin-bottom: 32px; }
    .activity-header { padding: 18px 22px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #f0ede8; }
    .activity-title { font-size: 15px; font-weight: 600; color: #2d2418; }
    table { width: 100%; border-collapse: collapse; }
    th { font-size: 10px; text-transform: uppercase; letter-spacing: 0.8px; color: #9a8a78; font-weight: 600; padding: 12px 22px; text-align: left; background: #faf8f5; border-bottom: 1px solid #f0ede8; }
    td { padding: 14px 22px; font-size: 13.5px; border-bottom: 1px solid #f9f7f5; }
    tr:last-child td { border-bottom: none; }
    .order-id { font-family: monospace; color: #8b7355; font-size: 12px; }
    .book-name { font-weight: 500; color: #2d2418; }
    .amount { font-weight: 600; color: #2d2418; }
    .order-status { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; }
    .order-status.shipped { background: #e8f4fd; color: #1565c0; }
    .order-status.processing { background: #fff3e0; color: #e65100; }
    .order-status.delivered { background: #edfaf3; color: #2e7d32; }
    .download-link { display: block; text-align: center; padding: 14px; font-size: 13px; color: #8b7355; text-decoration: none; border-top: 1px solid #f0ede8; font-weight: 500; }
    .download-link:hover { background: #faf8f5; }
    .empty-state { text-align: center; padding: 48px 20px; color: #9a8a78; }
  </style>
</head>
<body>
  <div class="seller-sidebar">
    <a href="/home" class="sidebar-logo" style="text-decoration: none; color: inherit; cursor: pointer;">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      Papyrus
    </a>
    <nav class="sidebar-nav">
      <a href="/sell" class="active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Dashboard Overview
      </a>
      <a href="/sell/my-listings">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        My Listings
      </a>
      <a href="/sell/reports">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Sales Reports
      </a>
    </nav>
    <div class="seller-tier">
      <div class="tier-label">Seller Tier</div>
      <div class="tier-name">Pro Librarian</div>
      <div class="tier-bar"><div class="tier-bar-fill"></div></div>
      <div class="tier-hint">25 more sales to Master level</div>
    </div>
  </div>

  <div class="main">
    <div class="top-nav">
      <div class="top-nav-links">
        <a href="/shop">Browse</a>
        <a href="/sell">Sell</a>
        <a href="/about">About</a>
      </div>
      <div class="top-nav-brand">
        <a href="/home" style="text-decoration: none; color: inherit; cursor: pointer; display: flex; align-items: center; gap: 8px;">
          <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 24px; height: 24px;">
            <path d="M10 70 Q10 75 15 75 L45 75 Q48 75 50 70 L50 85 Q48 90 45 90 L15 90 Q10 90 10 85 Z" fill="#7A5C3E"/>
            <path d="M90 70 Q90 75 85 75 L55 75 Q52 75 50 70 L50 85 Q52 90 55 90 L85 90 Q90 90 90 85 Z" fill="#7A5C3E"/>
            <path d="M50 70 L45 50 L50 30 L55 50 Z" fill="#5a4a3a"/>
            <circle cx="50" cy="25" r="6" fill="#5a4a3a"/>
            <ellipse cx="50" cy="15" rx="4" ry="7" fill="#7A5C3E"/>
            <ellipse cx="42" cy="20" rx="4" ry="6" fill="#7A5C3E"/>
            <ellipse cx="58" cy="20" rx="4" ry="6" fill="#7A5C3E"/>
            <ellipse cx="38" cy="28" rx="5" ry="7" fill="#7A5C3E"/>
            <ellipse cx="62" cy="28" rx="5" ry="7" fill="#7A5C3E"/>
            <ellipse cx="35" cy="38" rx="4" ry="6" fill="#7A5C3E"/>
            <ellipse cx="65" cy="38" rx="4" ry="6" fill="#7A5C3E"/>
          </svg>
          Papyrus
        </a>
      </div>
      <div class="top-nav-icons">
        <a href="/cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg></a>
        <a href="/profile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></a>
      </div>
    </div>

    <div class="breadcrumb">
      <a href="/home">HOME</a>
      <span class="breadcrumb-separator">›</span>
      <span>SELLER DASHBOARD</span>
    </div>

    <div class="page-header">
      <h1>Seller Dashboard</h1>
      <p>Welcome back. Here is your shop activity.</p>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-badge">+12%</span>
        <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
        <div class="stat-label">Total Revenue</div>
        <div class="stat-value">₹<%= typeof stats !== 'undefined' && stats.totalRevenue ? stats.totalRevenue.toFixed(2) : '0.00' %></div>
      </div>
      <div class="stat-card">
        <span class="stat-badge">+<%= typeof stats !== 'undefined' ? stats.recentSales || 0 : 0 %></span>
        <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
        <div class="stat-label">Items Sold</div>
        <div class="stat-value"><%= typeof stats !== 'undefined' ? stats.itemsSold || 0 : 0 %></div>
      </div>
      <div class="stat-card">
        <span class="stat-badge neutral">Pending</span>
        <svg class="stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div class="stat-label">Pending Submissions</div>
        <div class="stat-value"><%= typeof stats !== 'undefined' ? stats.pendingCount || 0 : 0 %></div>
      </div>
    </div>

    <div class="section-header">
      <div>
        <div class="section-title">Active Listings</div>
        <div class="section-sub">Your submitted books</div>
      </div>
      <a href="/sell/my-listings" class="view-all">View All Listings →</a>
    </div>

    <div class="listings-grid">
      <a href="/sell/create" class="create-card">
        <div class="create-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        </div>
        <div class="create-label">Create New Listing</div>
      </a>
      <% if (typeof recentSubmissions !== 'undefined' && recentSubmissions.length > 0) { %>
        <% recentSubmissions.slice(0,3).forEach(sub => { %>
          <% 
            let linkUrl = '#';
            let isClickable = false;
            
            if (sub.status === 'approved' && sub.approvedProductId) {
              if (sub.productExists && !sub.productDeleted && sub.productListed) {
                linkUrl = `/shop/${sub.approvedProductId}?from=my-listings`;
                isClickable = true;
              }
            }
          %>
          <a href="<%= linkUrl %>" class="book-card" <%= !isClickable ? 'style="cursor: default; pointer-events: none; opacity: 0.7;"' : '' %>>
            <div class="book-img">
              <% if (sub.images && sub.images.length > 0) { %>
                <img src="<%= sub.images[0].url %>" alt="<%= sub.title %>"/>
              <% } else { %>
                <div class="book-img-placeholder">📚</div>
              <% } %>
              <span class="status-badge <%= sub.status %>"><%= sub.status %></span>
            </div>
            <div class="book-info">
              <div class="book-title"><%= sub.title %></div>
              <div class="book-author"><%= sub.author || 'Unknown author' %></div>
              <div class="book-price">₹<%= sub.price %></div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <div style="grid-column:2/-1;display:flex;align-items:center;justify-content:center;background:white;border-radius:12px;border:1px solid #e8dcc8;padding:40px;color:#9a8a78;font-size:14px;">
          No listings yet. Create your first listing!
        </div>
      <% } %>
    </div>

    <div class="activity-card">
      <div class="activity-header">
        <div class="activity-title">Recent Selling Activity</div>
      </div>
      <% if (typeof recentOrders !== 'undefined' && recentOrders && recentOrders.length > 0) { %>
      <table>
        <thead>
          <tr><th>Order ID</th><th>Book Title</th><th>Customer</th><th>Date</th><th>Amount</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% recentOrders.forEach(order => { %>
          <% 
            const displayId = order.orderId ? order.orderId : (order._id ? `#${order._id.toString().slice(-6).toUpperCase()}` : '#ORDER');
            const displayTitle = order.title || order.bookTitle || 'Book';
            const displayCustomer = order.customer || order.customerName || 'Customer';
            const displayDate = order.date ? new Date(order.date).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : (order.createdAt ? new Date(order.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) : 'N/A');
            const displayAmount = order.price !== undefined ? order.price : (order.amount !== undefined ? order.amount : 0);
            const displayStatus = (order.status || 'Pending').toLowerCase();
          %>
          <tr>
            <td class="order-id"><%= displayId %></td>
            <td class="book-name"><%= displayTitle %></td>
            <td><%= displayCustomer %></td>
            <td><%= displayDate %></td>
            <td class="amount">₹<%= typeof displayAmount === 'number' ? displayAmount.toFixed(2) : displayAmount %></td>
            <td><span class="order-status <%= displayStatus %>"><%= order.status || 'Pending' %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
        <div class="empty-state"><p>No recent orders yet.</p></div>
      <% } %>
      <a href="/sell/reports" class="download-link">View Sales Reports & Download CSV</a>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const urlParams = new URLSearchParams(window.location.search);
      const error = urlParams.get('error');
      
      if (error) {
        Swal.fire({
          icon: 'error',
          title: 'Error',
          text: decodeURIComponent(error),
          confirmButtonColor: '#7A5C3E'
        }).then(() => {
          const url = new URL(window.location);
          url.searchParams.delete('error');
          window.history.replaceState({}, '', url);
        });
      }
    });
  </script>
</body>
</html>