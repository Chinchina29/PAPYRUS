<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Order Details - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    body { 
      background-color: #f8f6f3;
      font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    .order-detail-wrapper { max-width: 1200px; margin: 0 auto; padding: 40px 24px 80px; }
    .breadcrumb-nav { font-size: 13px; color: #999; margin-bottom: 24px; text-transform: uppercase; letter-spacing: 0.5px; }
    .breadcrumb-nav a { color: #999; text-decoration: none; transition: color 0.2s; }
    .breadcrumb-nav a:hover { color: #5a4a3a; text-decoration: underline; }
    .order-header { margin-bottom: 32px; }
    .order-header h1 { font-size: 42px; font-weight: 400; color: #2d1f14; margin-bottom: 8px; }
    .order-id { color: #8b7355; }
    
    .content-grid { display: grid; grid-template-columns: 1fr 380px; gap: 24px; }
    
    .card { background: white; border-radius: 12px; padding: 24px; margin-bottom: 24px; border: 1px solid #e8dcc8; }
    .card-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; margin-bottom: 16px; }
    
    .info-row { display: flex; justify-content: space-between; margin-bottom: 16px; }
    .info-label { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; margin-bottom: 4px; }
    .info-value { font-size: 14px; color: #2d1f14; font-weight: 500; }
    
    .order-item { display: flex; gap: 16px; padding: 16px 0; border-bottom: 1px solid #f3f4f6; }
    .order-item:last-child { border-bottom: none; }
    
    .item-image { width: 60px; height: 80px; border-radius: 6px; overflow: hidden; background: #f5f1ed; flex-shrink: 0; }
    .item-image img { width: 100%; height: 100%; object-fit: cover; }
    
    .item-details { flex: 1; }
    .item-title { font-weight: 600; font-size: 15px; color: #2d1f14; margin-bottom: 4px; }
    .item-meta { font-size: 13px; color: #6b7280; margin-bottom: 8px; }
    .item-qty { font-size: 13px; color: #6b7280; }
    .item-price { font-weight: 600; font-size: 15px; color: #2d1f14; text-align: right; }
    
    .status-badge { display: inline-block; padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; }
    .status-pending { background: #fff3e0; color: #f57c00; }
    .status-processing { background: #e3f2fd; color: #1976d2; }
    .status-shipped { background: #e8f5e9; color: #388e3c; }
    .status-delivered { background: #c8e6c9; color: #2e7d32; }
    .status-cancelled { background: #ffebee; color: #d32f2f; }
    .status-returned { background: #f3e5f5; color: #7b1fa2; }
    
    .payment-row { display: flex; justify-content: space-between; padding: 8px 0; font-size: 14px; }
    .payment-row.total { border-top: 2px solid #e5e7eb; padding-top: 12px; margin-top: 8px; font-weight: 700; font-size: 18px; }
    
    .payment-method { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #6b7280; margin-top: 12px; }
    
    .btn { padding: 12px 24px; border-radius: 10px; font-size: 14px; font-weight: 600; font-family: 'Poppins', sans-serif; cursor: pointer; transition: all 0.3s ease; text-decoration: none; display: inline-block; border: none; }
    .btn-primary { background: linear-gradient(135deg, #2d1f14 0%, #3d2f24 100%); color: white; width: 100%; margin-bottom: 12px; box-shadow: 0 4px 12px rgba(45, 31, 20, 0.2); }
    .btn-primary:hover { background: linear-gradient(135deg, #1a1209 0%, #2d1f14 100%); transform: translateY(-2px); box-shadow: 0 6px 16px rgba(45, 31, 20, 0.3); }
    .btn-secondary { background: white; color: #2d1f14; border: 2px solid #2d1f14; width: 100%; box-shadow: 0 2px 8px rgba(45, 31, 20, 0.1); }
    .btn-secondary:hover { background: #2d1f14; color: white; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(45, 31, 20, 0.2); }
    
    .action-buttons { display: flex; gap: 12px; margin-top: 24px; }
    .action-buttons .btn { flex: 1; text-align: center; }
    
    @media (max-width: 1024px) {
      .content-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="order-detail-wrapper">
    <div class="breadcrumb-nav">
      <a href="/home">HOME</a> / <a href="/orders">MY ORDERS</a> / <span>ORDER DETAILS</span>
    </div>

    <div class="order-header">
      <h1>Order Details: <span class="order-id"><%= order.orderId %></span></h1>
    </div>

    <div class="content-grid">
      <div>
        <div class="card">
          <div class="card-title">Shipping Information</div>
          
          <div class="info-row">
            <div>
              <div class="info-label">Customer Name</div>
              <div class="info-value"><%= order.shippingAddress.fullName %></div>
            </div>
            <div style="text-align: right;">
              <div class="info-label">Phone Number</div>
              <div class="info-value"><%= order.shippingAddress.phone %></div>
            </div>
          </div>

          <div>
            <div class="info-label">Shipping Address</div>
            <div class="info-value">
              <%= order.shippingAddress.addressLine1 %><br>
              <% if (order.shippingAddress.addressLine2) { %>
                <%= order.shippingAddress.addressLine2 %><br>
              <% } %>
              <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %><br>
              <%= order.shippingAddress.country %>
            </div>
          </div>

          <% if (order.trackingNumber) { %>
          <div style="margin-top: 16px;">
            <div class="info-label">Tracking Number</div>
            <div class="info-value"><%= order.trackingNumber %></div>
          </div>
          <% } %>
        </div>

        <div class="card">
          <div class="card-title">Order Items (<%= order.items.length %>)</div>
          
          <% order.items.forEach((item, index) => { %>
            <div class="order-item" style="<%= index === order.items.length - 1 ? 'border-bottom: none;' : '' %>">
              <div class="item-image">
                <% if (item.product && item.product.images && item.product.images.length > 0) { %>
                  <img src="<%= item.product.images[0].url %>" alt="<%= item.title %>">
                <% } else { %>
                  <div style="display: flex; align-items: center; justify-content: center; height: 100%; font-size: 24px;">📚</div>
                <% } %>
              </div>
              <div class="item-details" style="flex: 1;">
                <div class="item-title"><%= item.title %></div>
                <div class="item-meta">
                  <% if (item.product && item.product.condition) { %>
                    <%= item.product.condition.replace('-', ' ') %> condition
                  <% } %>
                </div>
                <div class="item-qty">Qty: <%= item.quantity %> × ₹<%= item.price.toFixed(2) %></div>
                
                <div style="margin-top: 8px;">
                  <% 
                    
                    let displayStatus;
                    
                    if (item.cancelledAt) {
                      
                      displayStatus = 'Cancelled';
                    } else if (item.returnRequestStatus === 'Approved') {
                      
                      displayStatus = 'Returned';
                    } else if (item.itemStatus) {
                      
                      displayStatus = item.itemStatus;
                    } else {
                      
                      displayStatus = order.orderStatus;
                    }
                  %>
                  <span class="status-badge status-<%= displayStatus.toLowerCase() %>">
                    <%= displayStatus.toUpperCase() %>
                  </span>
                </div>

                <div style="margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap;">
                  <% if ((item.itemStatus === 'Pending' || item.itemStatus === 'Processing' || (!item.itemStatus && (order.orderStatus === 'Pending' || order.orderStatus === 'Processing'))) && !item.cancelledAt) { %>
                    <button 
                      class="btn" 
                      onclick="cancelItem('<%= order._id %>', '<%= item._id %>', '<%= item.title %>')"
                      style="padding: 8px 16px; font-size: 13px; font-weight: 600; font-family: 'Poppins', sans-serif; background: white; color: #d32f2f; border: 2px solid #d32f2f; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 2px 6px rgba(211, 47, 47, 0.15);" onmouseover="this.style.background='#d32f2f'; this.style.color='white'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(211, 47, 47, 0.3)'" onmouseout="this.style.background='white'; this.style.color='#d32f2f'; this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 6px rgba(211, 47, 47, 0.15)'">
                      ✕ Cancel This Item
                    </button>
                  <% } %>
                  
                  <% if ((item.itemStatus === 'Delivered' || (!item.itemStatus && order.orderStatus === 'Delivered')) && (item.returnRequestStatus === 'None' || !item.returnRequestStatus) && !item.cancelledAt && order.orderStatus !== 'Returned' && order.returnRequestStatus !== 'Requested' && order.returnRequestStatus !== 'Approved') { %>
                    <button 
                      class="btn" 
                      onclick="returnItem('<%= order._id %>', '<%= item._id %>', '<%= item.title %>')"
                      style="padding: 8px 16px; font-size: 13px; font-weight: 600; font-family: 'Poppins', sans-serif; background: white; color: #f57c00; border: 2px solid #f57c00; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 2px 6px rgba(245, 124, 0, 0.15);" onmouseover="this.style.background='#f57c00'; this.style.color='white'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 4px 12px rgba(245, 124, 0, 0.3)'" onmouseout="this.style.background='white'; this.style.color='#f57c00'; this.style.transform='translateY(0)'; this.style.boxShadow='0 2px 6px rgba(245, 124, 0, 0.15)'">
                      ↩ Return This Item
                    </button>
                  <% } %>

                  <% if (item.returnRequestStatus === 'Requested') { %>
                    <span style="padding: 6px 12px; font-size: 12px; background: #fff3e0; color: #f57c00; border-radius: 6px; display: inline-block;">
                      Return Pending
                    </span>
                  <% } %>

                  <% if (item.returnRequestStatus === 'Approved') { %>
                    <span style="padding: 6px 12px; font-size: 12px; background: #e8f5e9; color: #2e7d32; border-radius: 6px; display: inline-block;">
                      Return Approved
                    </span>
                  <% } %>

                  <% if (item.returnRequestStatus === 'Rejected') { %>
                    <span style="padding: 6px 12px; font-size: 12px; background: #ffebee; color: #d32f2f; border-radius: 6px; display: inline-block;">
                      Return Rejected
                    </span>
                  <% } %>

                  <% if (item.cancelledAt) { %>
                    <span style="padding: 6px 12px; font-size: 12px; background: #ffebee; color: #d32f2f; border-radius: 6px; display: inline-block;">
                      Cancelled
                    </span>
                  <% } %>
                </div>

                <% if (item.cancellationReason) { %>
                  <div style="margin-top: 8px; font-size: 12px; color: #666;">
                    <strong>Cancellation Reason:</strong> <%= item.cancellationReason %>
                  </div>
                <% } %>
                <% if (item.returnReason) { %>
                  <div style="margin-top: 8px; font-size: 12px; color: #666;">
                    <strong>Return Reason:</strong> <%= item.returnReason %>
                  </div>
                <% } %>
              </div>
              <div class="item-price">₹<%= item.subtotal.toFixed(2) %></div>
            </div>
          <% }) %>
        </div>

        <% if (order.orderStatus === 'Pending' || order.orderStatus === 'Processing') { %>
        <div class="action-buttons">
          <button class="btn btn-secondary" onclick="cancelOrder('<%= order._id %>')">Cancel Order</button>
          <a href="/orders/<%= order._id %>/invoice" class="btn btn-secondary">Download Invoice (PDF)</a>
        </div>
        <% } else if (order.orderStatus === 'Delivered' && order.returnRequestStatus === 'None') { %>
        <div class="action-buttons">
          <button class="btn btn-secondary" onclick="returnOrder('<%= order._id %>')">Request Return</button>
          <a href="/orders/<%= order._id %>/invoice" class="btn btn-secondary">Download Invoice (PDF)</a>
        </div>
        <% } else { %>
        <div class="action-buttons">
          <a href="/orders/<%= order._id %>/invoice" class="btn btn-secondary">Download Invoice (PDF)</a>
        </div>
        <% } %>
      </div>

      <div>
        <div class="card">
          <div class="card-title">Order Status</div>
          
          <% if (order.returnRequestStatus === 'Requested') { %>
            <div style="background: #fef3c7; border: 1px solid #fbbf24; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" style="width: 20px; height: 20px;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="8" x2="12" y2="12"></line>
                  <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <strong style="color: #92400e; font-size: 14px;">Return Request Pending</strong>
              </div>
              <p style="font-size: 13px; color: #78350f; margin: 0;">
                Your return request is being reviewed by our team. We'll notify you once it's processed.
              </p>
            </div>
          <% } else if (order.returnRequestStatus === 'Approved') { %>
            <div style="background: #d1fae5; border: 1px solid #10b981; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" style="width: 20px; height: 20px;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <strong style="color: #065f46; font-size: 14px;">Return Request Approved</strong>
              </div>
              <p style="font-size: 13px; color: #047857; margin: 0;">
                Your return request has been approved. Please ship the item back to us.
              </p>
            </div>
          <% } else if (order.returnRequestStatus === 'Rejected') { %>
            <div style="background: #fee2e2; border: 1px solid #ef4444; border-radius: 8px; padding: 16px; margin-bottom: 16px;">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" style="width: 20px; height: 20px;">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="15" y1="9" x2="9" y2="15"></line>
                  <line x1="9" y1="9" x2="15" y2="15"></line>
                </svg>
                <strong style="color: #991b1b; font-size: 14px;">Return Request Rejected</strong>
              </div>
              <p style="font-size: 13px; color: #7f1d1d; margin: 0 0 8px 0;">
                <strong>Reason:</strong> <%= order.returnRejectionReason %>
              </p>
              <p style="font-size: 12px; color: #991b1b; margin: 0;">
                If you have questions, please contact our support team.
              </p>
            </div>
          <% } %>
          
          <div style="margin-bottom: 16px;">
            <span class="status-badge status-<%= order.orderStatus.toLowerCase() %>"><%= order.orderStatus %></span>
          </div>

          <div class="info-label">Order Date</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </div>

          <% if (order.shippedAt) { %>
          <div class="info-label">Shipped Date</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= new Date(order.shippedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </div>
          <% } %>

          <% if (order.deliveredAt) { %>
          <div class="info-label">Delivered Date</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= new Date(order.deliveredAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </div>
          <% } %>

          <% if (order.cancelledAt) { %>
          <div class="info-label">Cancelled Date</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= new Date(order.cancelledAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </div>
          <% if (order.cancellationReason) { %>
          <div class="info-label">Cancellation Reason</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= order.cancellationReason %>
          </div>
          <% } %>
          <% } %>

          <% if (order.returnedAt) { %>
          <div class="info-label">Returned Date</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= new Date(order.returnedAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>
          </div>
          <% if (order.returnReason) { %>
          <div class="info-label">Return Reason</div>
          <div class="info-value" style="margin-bottom: 12px;">
            <%= order.returnReason %>
          </div>
          <% } %>
          <% } %>
        </div>

        <div class="card">
          <div class="card-title">Payment Summary</div>
          
          <% 
            // Calculate adjusted totals excluding cancelled/returned items
            let activeSubtotal = 0;
            let cancelledAmount = 0;
            let returnedAmount = 0;
            let activeItems = [];
            
            order.items.forEach(item => {
              if (item.itemStatus === 'Cancelled' || item.cancelledAt) {
                cancelledAmount += item.subtotal;
              } else if (item.itemStatus === 'Returned' || item.returnRequestStatus === 'Approved') {
                returnedAmount += item.subtotal;
              } else {
                activeSubtotal += item.subtotal;
                activeItems.push(item);
              }
            });
            
            // Validate coupon eligibility for active items only
            let validDiscount = 0;
            let couponInvalidReason = null;
            
            if (order.discount > 0 && order.couponCode) {
              // Check if active subtotal meets minimum purchase requirement
              // Based on the coupon requirements, minimum purchase is ₹1000
              const assumedMinPurchase = 1000; // This should come from coupon data
              
              if (activeSubtotal >= assumedMinPurchase) {
                validDiscount = order.discount;
              } else {
                couponInvalidReason = `Coupon requires minimum ₹${assumedMinPurchase} purchase. Active items: ₹${activeSubtotal.toFixed(2)}`;
              }
            }
            
            const adjustedShipping = activeSubtotal >= 500 ? 0 : (activeSubtotal > 0 ? order.shippingCharge : 0);
            const adjustedTotal = activeSubtotal + adjustedShipping - validDiscount;
          %>
          
          <% if (order.subtotal !== activeSubtotal) { %>
          <div class="payment-row">
            <span>Original Subtotal</span>
            <span>₹<%= order.subtotal.toFixed(2) %></span>
          </div>
          
          <% if (cancelledAmount > 0) { %>
          <div class="payment-row" style="color: #d32f2f;">
            <span>Less: Cancelled Items</span>
            <span>-₹<%= cancelledAmount.toFixed(2) %></span>
          </div>
          <% } %>
          
          <% if (returnedAmount > 0) { %>
          <div class="payment-row" style="color: #f57c00;">
            <span>Less: Returned Items</span>
            <span>-₹<%= returnedAmount.toFixed(2) %></span>
          </div>
          <% } %>
          
          <div class="payment-row">
            <span>Active Subtotal</span>
            <span>₹<%= activeSubtotal.toFixed(2) %></span>
          </div>
          <% } else { %>
          <div class="payment-row">
            <span>Subtotal</span>
            <span>₹<%= activeSubtotal.toFixed(2) %></span>
          </div>
          <% } %>
          
          <div class="payment-row">
            <span>Shipping (Standard)</span>
            <span><%= adjustedShipping === 0 ? 'FREE' : '₹' + adjustedShipping.toFixed(2) %></span>
          </div>
          
          <% if (order.discount > 0) { %>
            <% if (validDiscount > 0) { %>
            <div class="payment-row">
              <span>Discount (<%= order.couponCode %>)</span>
              <span>-₹<%= validDiscount.toFixed(2) %></span>
            </div>
            <% } else if (couponInvalidReason) { %>
            <div class="payment-row" style="color: #d32f2f;">
              <span>Discount (<%= order.couponCode %>) - Invalid</span>
              <span>₹0.00</span>
            </div>
            <div style="font-size: 12px; color: #d32f2f; margin: 8px 0; padding: 8px; background: #ffebee; border-radius: 4px;">
              <strong>Note:</strong> <%= couponInvalidReason %>
            </div>
            <% } %>
          <% } %>
          
          <div class="payment-row total">
            <span>Total</span>
            <span>₹<%= adjustedTotal.toFixed(2) %></span>
          </div>

          <div class="payment-method">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
            Payment Method: <%= order.paymentMethod %>
          </div>
        </div>

        <div style="text-align: center; padding: 16px; color: #666; font-size: 13px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 20px; height: 20px; margin-bottom: 8px;">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <p>Need help with this order?</p>
          <a href="#" style="color: #2d1f14; text-decoration: underline;">Contact Support</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    async function cancelItem(orderId, itemId, itemTitle) {
      const result = await Swal.fire({
        title: 'Cancel This Item?',
        html: `
          <p style="color: #666; font-size: 14px; margin-bottom: 12px;">You are about to cancel:</p>
          <p style="font-weight: 600; font-size: 15px; margin-bottom: 20px;">${itemTitle}</p>
          <p style="color: #666; font-size: 14px; margin-bottom: 20px;">Please let us know the reason for cancellation.</p>
          <div style="text-align: left; margin-bottom: 20px;">
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Found a better price elsewhere" style="margin-right: 10px;">
              <span style="font-size: 14px;">Found a better price elsewhere</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Mistakenly ordered" style="margin-right: 10px;">
              <span style="font-size: 14px;">Mistakenly ordered</span>
            </label>
            <label style="display: flex; align-items: center; padding: 10px; cursor: pointer; border-radius: 6px; transition: background 0.2s;">
              <input type="radio" name="cancelReason" value="Long expected delivery time" style="margin-right: 10px;">
              <span style="font-size: 14px;">Long expected delivery time</span>
            </label>
