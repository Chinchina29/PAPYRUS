<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Product Unavailable - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <style>
    body {
      background: #f5f1ed;
      font-family: 'Georgia', 'Times New Roman', serif;
      color: #2d1f14;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }
    .unavailable-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 60px 24px;
    }
    .unavailable-card {
      background: white;
      border-radius: 16px;
      padding: 60px 48px;
      text-align: center;
      max-width: 520px;
      width: 100%;
      box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }
    .unavailable-icon {
      width: 80px;
      height: 80px;
      margin: 0 auto 28px;
      background: #fef3c7;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .unavailable-icon svg {
      width: 40px;
      height: 40px;
      color: #d97706;
    }
    .unavailable-title {
      font-size: 26px;
      font-weight: 700;
      color: #2d1f14;
      margin-bottom: 12px;
    }
    .unavailable-message {
      font-size: 15px;
      color: #7A5C3E;
      line-height: 1.7;
      margin-bottom: 8px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .unavailable-product-name {
      font-size: 14px;
      color: #999;
      font-style: italic;
      margin-bottom: 32px;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .btn-group {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .btn-primary {
      padding: 12px 28px;
      background: #2d1f14;
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .btn-primary:hover { background: #1a1209; }
    .btn-secondary {
      padding: 12px 28px;
      background: transparent;
      color: #2d1f14;
      border: 1.5px solid #2d1f14;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      transition: all 0.2s;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    .btn-secondary:hover { background: #2d1f14; color: white; }
    .divider {
      border: none;
      border-top: 1px solid #e8dcc8;
      margin: 32px 0;
    }
    .suggestion-text {
      font-size: 13px;
      color: #999;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>

  <div class="unavailable-wrapper">
    <div class="unavailable-card">

      <div class="unavailable-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
      </div>

      <% if (reason === 'removed') { %>
        <h1 class="unavailable-title">Product Removed</h1>
        <p class="unavailable-message">
          This book has been permanently removed from our catalog and is no longer available for purchase.
        </p>
      <% } else if (reason === 'unlisted') { %>
        <h1 class="unavailable-title">Product Unavailable</h1>
        <p class="unavailable-message">
          This book is currently unavailable. It may have been temporarily taken off the shelves or is under review.
        </p>
      <% } else if (reason === 'category') { %>
        <h1 class="unavailable-title">Category Unavailable</h1>
        <p class="unavailable-message">
          This book's category is currently unavailable. The product cannot be accessed at this time.
        </p>
      <% } else { %>
        <h1 class="unavailable-title">Product Not Found</h1>
        <p class="unavailable-message">
          We couldn't find the book you're looking for. It may have been moved or no longer exists.
        </p>
      <% } %>

      <% if (title) { %>
        <p class="unavailable-product-name">"<%= title %>"</p>
      <% } else { %>
        <div style="margin-bottom: 32px;"></div>
      <% } %>

      <div class="btn-group">
        <a href="/shop" class="btn-primary">Browse Other Books</a>
        <a href="javascript:history.back()" class="btn-secondary">Go Back</a>
      </div>

      <hr class="divider">
      <p class="suggestion-text">Looking for something specific? Try searching our full catalog.</p>

    </div>
  </div>

</body>
</html>
