<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Papyrus - Stories Worth Sharing</title>
    <link rel="stylesheet" href="/css/home.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  </head>
  <body>
    <%- include('../partials/header') %>

    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <p class="hero-subtitle">EST. 1974</p>
          <h1 class="hero-title">Stories Worth Sharing</h1>
          <p class="hero-description">
            Discover vintage books that have stood the test of time and timeless
            classics that will find a new home. Explore our curated collection
            preserving literary heritage.
          </p>
          <a href="/shop" class="btn-primary">Explore Collections</a>
        </div>
        <div class="hero-images">
          <div class="hero-image-main">
            <img
              src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&h=600&fit=crop"
              alt="Book Cover"
            />
          </div>
          <div class="hero-image-stack">
            <div class="stack-image stack-1">
              <img
                src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=300&h=450&fit=crop"
                alt="Vintage Book"
              />
            </div>
            <div class="stack-image stack-2">
              <img
                src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?w=300&h=450&fit=crop"
                alt="Classic Book"
              />
            </div>
            <div class="stack-image stack-3">
              <img
                src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=300&h=450&fit=crop"
                alt="Book Stack"
              />
            </div>
            <div class="stack-image stack-4">
              <img
                src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=300&h=450&fit=crop"
                alt="Old Book"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="featured-collections">
      <div class="container">
        <div class="section-header">
          <h2>Featured Collections</h2>
          <a href="/shop" class="view-all">VIEW ALL ></a>
        </div>
        <div class="collections-grid">
          <% if (featuredCollections && featuredCollections.length > 0) { %>
            <% featuredCollections.forEach(product => { %>
              <a href="/shop/<%= product._id %>" class="collection-card" style="text-decoration: none; color: inherit;">
                <img
                  src="<%= product.images && product.images.length > 0 ? product.images[0].url : 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&h=300&fit=crop' %>"
                  alt="<%= product.title %>"
                />
                <div class="collection-info">
                  <h3><%= product.title.substring(0, 20) %><%= product.title.length > 20 ? '...' : '' %></h3>
                  <p>₹<%= product.price ? product.price.toFixed(2) : 'N/A' %></p>
                </div>
              </a>
            <% }) %>
          <% } else { %>
            <!-- Fallback to static if no products -->
            <div class="collection-card">
              <img
                src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&h=300&fit=crop"
                alt="Rare Finds"
              />
              <div class="collection-info">
                <h3>Rare Finds</h3>
                <p>View More</p>
              </div>
            </div>
            <div class="collection-card">
              <img
                src="https://images.unsplash.com/photo-1481627834876-b7833e8f5570?w=400&h=300&fit=crop"
                alt="The Classics"
              />
              <div class="collection-info">
                <h3>The Classics</h3>
                <p>View More</p>
              </div>
            </div>
            <div class="collection-card">
              <img
                src="https://images.unsplash.com/photo-1495446815901-a7297e633e8d?w=400&h=300&fit=crop"
                alt="Nonfiction Picks"
              />
              <div class="collection-info">
                <h3>Nonfiction Picks</h3>
                <p>View More</p>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="recommended">
      <div class="container">
        <div class="section-header">
          <h2>Recommended for You</h2>
          <div class="carousel-controls">
            <button class="carousel-btn prev">‹</button>
            <button class="carousel-btn next">›</button>
          </div>
        </div>
        <div class="books-carousel">
          <% if (recommendedProducts && recommendedProducts.length > 0) { %>
            <% recommendedProducts.forEach(product => { %>
              <a href="/shop/<%= product._id %>" class="book-card" style="text-decoration: none; color: inherit;">
                <div class="book-image">
                  <% if (product.originalPrice && product.price < product.originalPrice) { 
                    const discount = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
                  %>
                    <span class="badge">-<%= discount %>% OFF</span>
                  <% } %>
                  <img
                    src="<%= product.images && product.images.length > 0 ? product.images[0].url : 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop' %>"
                    alt="<%= product.title %>"
                  />
                </div>
                <h3><%= product.title.toUpperCase() %></h3>
                <p class="price">
                  ₹<%= product.price.toFixed(2) %>
                  <% if (product.originalPrice && product.price < product.originalPrice) { %>
                    <span class="old-price">₹<%= product.originalPrice.toFixed(2) %></span>
                  <% } %>
                </p>
              </a>
            <% }) %>
          <% } else { %>
            <!-- Fallback to hardcoded if no products -->
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop"
                  alt="The Garden of Evening"
                />
              </div>
              <h3>THE GARDEN OF EVENING</h3>
              <p class="price">₹720</p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=300&h=400&fit=crop"
                  alt="Notebook 1947"
                />
              </div>
              <h3>NOTEBOOK 1947</h3>
              <p class="price">₹530</p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1589829085413-56de8ae18c73?w=300&h=400&fit=crop"
                  alt="Spectre"
                />
              </div>
              <h3>SPECTRE</h3>
              <p class="price">₹615</p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1512820790803-83ca734da794?w=300&h=400&fit=crop"
                  alt="Notes of the Air"
                />
              </div>
              <h3>NOTES OF THE AIR</h3>
              <p class="price">₹720</p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=300&h=400&fit=crop"
                  alt="The Secret History"
                />
              </div>
              <h3>THE SECRET HISTORY</h3>
              <p class="price">₹810</p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <img
                  src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=300&h=400&fit=crop"
                  alt="One Summer's Day"
                />
              </div>
              <h3>ONE SUMMER'S DAY</h3>
              <p class="price">₹507</p>
            </a>
          <% } %>
        </div>
      </div>
    </section>

    <section class="top-sellers">
      <div class="container">
        <h2>Top Sellers This Week</h2>
        <div class="books-grid">
          <% if (topSellers && topSellers.length > 0) { %>
            <% topSellers.forEach(product => { %>
              <a href="/shop/<%= product._id %>" class="book-card" style="text-decoration: none; color: inherit;">
                <div class="book-image">
                  <% if (product.originalPrice && product.price < product.originalPrice) { 
                    const discount = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
                  %>
                    <span class="badge">-<%= discount %>% OFF</span>
                  <% } %>
                  <img
                    src="<%= product.images && product.images.length > 0 ? product.images[0].url : 'https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=300&h=400&fit=crop' %>"
                    alt="<%= product.title %>"
                  />
                </div>
                <h3><%= product.title.toUpperCase() %></h3>
                <p class="price">
                  ₹<%= product.price.toFixed(2) %>
                  <% if (product.originalPrice && product.price < product.originalPrice) { %>
                    <span class="old-price">₹<%= product.originalPrice.toFixed(2) %></span>
                  <% } %>
                </p>
              </a>
            <% }) %>
          <% } else { %>
            <!-- Fallback to hardcoded if no products -->
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <span class="badge">-15% OFF</span>
                <img
                  src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=300&h=400&fit=crop"
                  alt="The Bluest Eye"
                />
              </div>
              <h3>THE BLUEST EYE</h3>
              <p class="price">₹720 <span class="old-price">₹820</span></p>
            </a>
            <a href="/shop" class="book-card" style="text-decoration: none; color: inherit;">
              <div class="book-image">
                <span class="badge new">NEW</span>
                <img
                  src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop"
                  alt="Frost Song"
                />
              </div>
              <h3>FROST SONG</h3>
              <p class="price">₹650</p>
            </a>
          <% } %>
        </div>
      </div>
    </section>

    <section class="promise">
      <div class="container">
        <h2>The Papyrus Promise</h2>
        <div class="promise-grid">
          <div class="promise-card">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            </svg>
            <h3>Authenticity</h3>
            <p>Every book is verified for authenticity and quality.</p>
          </div>
          <div class="promise-card">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <h3>Fast Delivery</h3>
            <p>Delivered to your doorstep within 3-5 business days.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="sell-story">
      <div class="container">
        <div class="sell-content">
          <h2>Sell Your Story</h2>
          <p>
            Got a book you no longer need? Turn your unwanted books into cash.
          </p>
          <div class="sell-steps">
            <div class="step">
              <span class="step-number">1. SNAP</span>
            </div>
            <div class="step">
              <span class="step-number">2. LIST</span>
            </div>
            <div class="step">
              <span class="step-number">3. SHIP</span>
            </div>
          </div>
          <a href="/sell" class="btn-secondary">START SELLING TODAY</a>
        </div>
      </div>
    </section>

    <section class="testimonials">
      <div class="container">
        <h2>Reader Testimonials</h2>
        <div class="testimonial-list">
          <div class="testimonial">
            <div class="testimonial-avatar"></div>
            <div class="testimonial-content">
              <p class="testimonial-text">
                "I found rare editions I've been searching for years!"
              </p>
              <p class="testimonial-author">- Sarah Mitchell</p>
            </div>
          </div>
          <div class="testimonial">
            <div class="testimonial-avatar"></div>
            <div class="testimonial-content">
              <p class="testimonial-text">
                "The quality and service are exceptional."
              </p>
              <p class="testimonial-author">- James Anderson</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="recent-stories">
      <div class="container">
        <h2>Recent Stories</h2>
        <div class="stories-grid">
          <% if (recentStories && recentStories.length > 0) { %>
            <% recentStories.forEach(product => { %>
              <a href="/shop/<%= product._id %>" class="story-card" style="text-decoration: none; color: inherit;">
                <img
                  src="<%= product.images && product.images.length > 0 ? product.images[0].url : 'https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop' %>"
                  alt="<%= product.title %>"
                />
                <% if (product.title) { %>
                  <p><%= product.title.substring(0, 25) %><%= product.title.length > 25 ? '...' : '' %></p>
                <% } %>
              </a>
            <% }) %>
          <% } else { %>
            <!-- Fallback to static if no products -->
            <div class="story-card">
              <img
                src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?w=300&h=400&fit=crop"
                alt="Story"
              />
              <p>Love among the Daisies</p>
            </div>
            <div class="story-card">
              <img
                src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?w=300&h=400&fit=crop"
                alt="Story"
              />
              <p>Stories in the Attic</p>
            </div>
            <div class="story-card">
              <img
                src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=300&h=400&fit=crop"
                alt="Story"
              />
            </div>
            <div class="story-card">
              <img
                src="https://images.unsplash.com/photo-1543002588-bfa74002ed7e?w=300&h=400&fit=crop"
                alt="Story"
              />
            </div>
          <% } %>
        </div>
      </div>
    </section>

    <section class="journey">
      <div class="container">
        <h2>Begin Your Journey</h2>
        <p>Discover stories that will stay with you forever</p>
        <a href="/shop" class="btn-primary">EXPLORE NOW</a>
      </div>
    </section>

    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            <div class="footer-logo">
              <svg
                viewBox="0 0 100 100"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  d="M10 70 Q10 75 15 75 L45 75 Q48 75 50 70 L50 85 Q48 90 45 90 L15 90 Q10 90 10 85 Z"
                  fill="currentColor"
                />
                <path
                  d="M90 70 Q90 75 85 75 L55 75 Q52 75 50 70 L50 85 Q52 90 55 90 L85 90 Q90 90 90 85 Z"
                  fill="currentColor"
                />
                <path d="M50 70 L45 50 L50 30 L55 50 Z" fill="currentColor" />
                <circle cx="50" cy="25" r="6" fill="currentColor" />
                <ellipse cx="50" cy="15" rx="4" ry="7" fill="currentColor" />
                <ellipse cx="42" cy="20" rx="4" ry="6" fill="currentColor" />
                <ellipse cx="58" cy="20" rx="4" ry="6" fill="currentColor" />
              </svg>
              <span>PAPYRUS</span>
            </div>
            <p>
              Preserving literary heritage through sustainable book trading
              since 1974.
            </p>
            <div class="social-links">
              <a href="#"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  /></svg
              ></a>
              <a href="#"
                ><svg viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"
                  /></svg
              ></a>
            </div>
          </div>
          <div class="footer-section">
            <h4>EXPLORE</h4>
            <ul>
              <li><a href="/shop">Collections</a></li>
              <li><a href="/shop">Rare Books</a></li>
              <li><a href="/shop">New Arrivals</a></li>
            </ul>
          </div>
          <div class="footer-section">
            <h4>COMPANY</h4>
            <ul>
              <li><a href="#" onclick="showComingSoon(event, 'About')">About</a></li>
              <li><a href="/contact">Contact</a></li>
              <li><a href="/careers">Careers</a></li>
            </ul>
          </div>
          <div class="footer-section">
            <h4>NEWSLETTER</h4>
            <p>Stay updated with our latest finds</p>
            <form class="newsletter-form" onsubmit="subscribeNewsletter(event)">
              <input type="email" placeholder="Email address" required />
              <button type="submit">GO</button>
            </form>
          </div>
        </div>
      </div>
    </footer>

    <script>
      function subscribeNewsletter(event) {
        event.preventDefault();
        Swal.fire({
          icon: 'success',
          title: 'Subscribed!',
          text: 'Thank you for subscribing to our newsletter',
          confirmButtonColor: '#7A5C3E'
        });
        event.target.reset();
      }

      function showComingSoon(event, pageName) {
        event.preventDefault();
        Swal.fire({
            icon: 'info',
            title: `${pageName} Page`,
            html: `<p>The <strong>${pageName}</strong> page is currently under development.</p><p>We're working hard to bring you this feature soon!</p>`,
            confirmButtonText: 'Got it',
            confirmButtonColor: '#7A5C3E',
            iconColor: '#7A5C3E'
        });
      }
    </script>

    <% if (isNewUser && categories && categories.length > 0) { %>
    <div id="genreModal" class="genre-modal">
      <div class="genre-modal-content">
        <div class="genre-modal-header">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 32px; height: 32px; color: #2d5016;">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
          <h2>Personalize Your Library</h2>
          <p>Select your favorite genres to help us curate your perfect collection of stories.</p>
        </div>
        
        <div class="genre-grid">
          <% categories.forEach(category => { %>
            <div class="genre-card" data-genre-id="<%= category._id %>">
              <div class="genre-icon">
                <% if (category.name.toLowerCase().includes('fiction')) { %>
                  📖
                <% } else if (category.name.toLowerCase().includes('non-fiction')) { %>
                  📚
                <% } else if (category.name.toLowerCase().includes('fantasy')) { %>
                  🧙
                <% } else if (category.name.toLowerCase().includes('biography')) { %>
                  👤
                <% } else if (category.name.toLowerCase().includes('classic')) { %>
                  📜
                <% } else if (category.name.toLowerCase().includes('sci-fi') || category.name.toLowerCase().includes('science')) { %>
                  🚀
                <% } else if (category.name.toLowerCase().includes('mystery')) { %>
                  🔍
                <% } else if (category.name.toLowerCase().includes('poetry')) { %>
                  ✍️
                <% } else if (category.name.toLowerCase().includes('philosophy')) { %>
                  💭
                <% } else { %>
                  📕
                <% } %>
              </div>
              <span class="genre-name"><%= category.name %></span>
              <div class="genre-checkmark">✓</div>
            </div>
          <% }) %>
        </div>

        <div class="genre-modal-footer">
          <button class="btn-continue" onclick="saveGenrePreferences()">Continue to My Collection</button>
          <button class="btn-skip" onclick="skipGenreSelection()">Skip for now</button>
        </div>
      </div>
    </div>

    <style>
      .genre-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        backdrop-filter: blur(4px);
      }

      .genre-modal-content {
        background: white;
        border-radius: 16px;
        max-width: 600px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
        padding: 40px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      }

      .genre-modal-header {
        text-align: center;
        margin-bottom: 32px;
      }

      .genre-modal-header svg {
        margin-bottom: 16px;
      }

      .genre-modal-header h2 {
        font-family: 'Playfair Display', serif;
        font-size: 28px;
        color: #2d1f14;
        margin-bottom: 12px;
      }

      .genre-modal-header p {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
      }

      .genre-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 32px;
      }

      .genre-card {
        position: relative;
        border: 2px solid #e8dcc8;
        border-radius: 12px;
        padding: 20px 12px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
      }

      .genre-card:hover {
        border-color: #2d5016;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(45, 80, 22, 0.1);
      }

      .genre-card.selected {
        border-color: #2d5016;
        background: #f0f7ed;
      }

      .genre-icon {
        font-size: 32px;
        margin-bottom: 8px;
      }

      .genre-name {
        display: block;
        font-size: 13px;
        font-weight: 500;
        color: #2d1f14;
      }

      .genre-checkmark {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: #2d5016;
        color: white;
        font-size: 12px;
        display: none;
        align-items: center;
        justify-content: center;
      }

      .genre-card.selected .genre-checkmark {
        display: flex;
      }

      .genre-modal-footer {
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .btn-continue {
        width: 100%;
        padding: 14px 24px;
        background: #2d5016;
        color: white;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
      }

      .btn-continue:hover {
        background: #1f3810;
      }

      .btn-continue:disabled {
        background: #ccc;
        cursor: not-allowed;
      }

      .btn-skip {
        width: 100%;
        padding: 12px 24px;
        background: transparent;
        color: #666;
        border: none;
        font-size: 13px;
        cursor: pointer;
        transition: color 0.2s;
      }

      .btn-skip:hover {
        color: #2d1f14;
        text-decoration: underline;
      }

      @media (max-width: 768px) {
        .genre-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .genre-modal-content {
          padding: 24px;
        }
      }
    </style>

    <script>
      const selectedGenres = new Set();

      document.querySelectorAll('.genre-card').forEach(card => {
        card.addEventListener('click', function() {
          const genreId = this.dataset.genreId;
          
          if (this.classList.contains('selected')) {
            this.classList.remove('selected');
            selectedGenres.delete(genreId);
          } else {
            this.classList.add('selected');
            selectedGenres.add(genreId);
          }
        });
      });

      async function saveGenrePreferences() {
        if (selectedGenres.size === 0) {
          Swal.fire({
            icon: 'warning',
            title: 'No Genres Selected',
            text: 'Please select at least one genre to continue',
            confirmButtonColor: '#2d5016'
          });
          return;
        }

        try {
          const response = await fetch('/save-genre-preferences', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ genres: Array.from(selectedGenres) })
          });

          const data = await response.json();

          if (data.success) {
            document.getElementById('genreModal').style.display = 'none';
            Swal.fire({
              icon: 'success',
              title: 'Preferences Saved!',
              text: 'Your library has been personalized',
              confirmButtonColor: '#2d5016',
              timer: 2000,
              showConfirmButton: false
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message || 'Failed to save preferences',
              confirmButtonColor: '#2d5016'
            });
          }
        } catch (error) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Something went wrong. Please try again.',
            confirmButtonColor: '#2d5016'
          });
        }
      }

      async function skipGenreSelection() {
        try {
          const response = await fetch('/skip-genre-selection', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
          });

          const data = await response.json();

          if (data.success) {
            document.getElementById('genreModal').style.display = 'none';
          }
        } catch (error) {
          document.getElementById('genreModal').style.display = 'none';
        }
      }
    </script>
    <% } %>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        const error = urlParams.get('error');
        const success = urlParams.get('success');
        
        if (error) {
          Swal.fire({
            icon: 'error',
            title: 'Oops!',
            text: decodeURIComponent(error),
            confirmButtonColor: '#5a4a3a'
          }).then(() => {
            const url = new URL(window.location);
            url.searchParams.delete('error');
            window.history.replaceState({}, '', url);
          });
        }
        
        if (success) {
          Swal.fire({
            icon: 'success',
            title: 'Success!',
            text: decodeURIComponent(success),
            confirmButtonColor: '#5a4a3a',
            timer: 3000
          }).then(() => {
            const url = new URL(window.location);
            url.searchParams.delete('success');
            window.history.replaceState({}, '', url);
          });
        }
      });
    </script>
  </body>
</html>
