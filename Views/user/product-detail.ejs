<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <meta name="product-id" content="<%= product._id %>"/>
  <title><%= product.title %> - Papyrus</title>
  <link rel="stylesheet" href="/css/home.css">
  <!-- Viewer.js for professional image zoom -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.6/viewer.min.css"/>
  <style>
    :root {
      --brown: #7A5C3E;
      --brown-dark: #5a4a3a;
      --brown-light: #f5f1ed;
      --text-dark: #2d1f14;
      --text-muted: #7A5C3E;
      --border: #e8dcc8;
      --white: #ffffff;
    }

    * { box-sizing: border-box; }

    .product-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 32px 24px;
    }

    /* ─── Breadcrumb ─── */
    .breadcrumb {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 24px;
      font-size: 13px;
      color: var(--brown);
    }
    .breadcrumb a { color: var(--brown); text-decoration: none; }
    .breadcrumb a:hover { text-decoration: underline; }
    .breadcrumb-sep { color: #bbb; }

    /* ─── Product Main Grid ─── */
    .product-main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    /* ─── Images ─── */
    .product-images {
      position: sticky;
      top: 24px;
      height: fit-content;
    }

    .main-image-wrap {
      width: 100%;
      height: 500px;
      background: var(--brown-light);
      border-radius: 12px;
      overflow: hidden;
      margin-bottom: 12px;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    #mainProductImage {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: zoom-in;
      transition: transform 0.25s;
      display: block;
    }

    .main-image-wrap:hover #mainProductImage {
      transform: scale(1.02);
    }

    .zoom-hint {
      position: absolute;
      bottom: 12px;
      right: 12px;
      background: rgba(0,0,0,0.55);
      color: #fff;
      font-size: 12px;
      padding: 5px 10px;
      border-radius: 20px;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .main-image-wrap:hover .zoom-hint { opacity: 1; }

    .no-image-ph { font-size: 80px; color: #bbb; }

    /* Thumbnails */
    .thumbnail-strip {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .thumb {
      width: 72px;
      height: 72px;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color 0.2s, transform 0.15s;
      background: var(--brown-light);
      flex-shrink: 0;
    }
    .thumb:hover { transform: scale(1.05); }
    .thumb.active { border-color: var(--brown); }
    .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Hidden gallery container for Viewer.js */
    #galleryImages { display: none; }

    /* ─── Product Info ─── */
    .product-info h1 {
      font-size: 30px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 6px;
      line-height: 1.25;
    }
    .product-author {
      font-size: 17px;
      color: var(--brown);
      margin-bottom: 18px;
    }

    /* Price */
    .price-row {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }
    .price-current {
      font-size: 34px;
      font-weight: 700;
      color: var(--text-dark);
    }
    .price-original {
      font-size: 18px;
      color: #999;
      text-decoration: line-through;
    }
    .discount-badge {
      background: #2d5016;
      color: #fff;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
    }

    /* Condition */
    .condition-badge {
      display: inline-block;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 18px;
    }
    .condition-new { background: #e8f5e9; color: #2e7d32; }
    .condition-like-new { background: #e3f2fd; color: #1565c0; }
    .condition-good { background: #fff3e0; color: #e65100; }
    .condition-fair { background: #fce4ec; color: #c2185b; }
    .condition-poor { background: #ffebee; color: #b71c1c; }

    /* Stock */
    .stock-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 18px;
      font-size: 14px;
      color: var(--text-dark);
    }
    .stock-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .dot-in   { background: #43a047; }
    .dot-low  { background: #fb8c00; }
    .dot-out  { background: #e53935; }

    /* Quantity */
    .qty-section { margin-bottom: 22px; }
    .qty-label {
      display: block;
      font-weight: 600;
      color: var(--text-dark);
      margin-bottom: 8px;
      font-size: 14px;
    }
    .qty-row {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .qty-btn {
      width: 40px; height: 40px;
      border: 2px solid var(--brown);
      background: var(--white);
      color: var(--brown);
      border-radius: 8px;
      font-size: 20px;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, color 0.2s, opacity 0.2s;
      line-height: 1;
    }
    .qty-btn:hover:not(:disabled) {
      background: var(--brown);
      color: #fff;
    }
    .qty-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
    #qtyInput {
      width: 68px; height: 40px;
      text-align: center;
      border: 2px solid var(--border);
      border-radius: 8px;
      font-size: 16px;
      font-weight: 700;
      color: var(--text-dark);
      background: var(--white);
      pointer-events: none;
    }
    .qty-max-note {
      font-size: 13px;
      color: #888;
    }

    /* Action buttons */
    .action-buttons {
      display: flex;
      gap: 12px;
      margin-bottom: 28px;
    }
    .btn-primary {
      flex: 1;
      padding: 14px 20px;
      background: var(--brown);
      color: var(--white);
      border: none;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: background 0.2s;
    }
    .btn-primary:hover:not(:disabled) { background: var(--brown-dark); }
    .btn-primary:disabled { background: #ccc; cursor: not-allowed; }

    .btn-wishlist {
      width: 52px; height: 52px;
      border: 2px solid var(--brown);
      background: var(--white);
      color: var(--brown);
      border-radius: 8px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: background 0.2s, color 0.2s;
      flex-shrink: 0;
    }
    .btn-wishlist:hover { background: var(--brown); color: var(--white); }
    .btn-wishlist svg { transition: fill 0.2s, stroke 0.2s; }
    .btn-wishlist.in-wishlist svg { fill: var(--brown); }
    .btn-wishlist.in-wishlist:hover svg { fill: var(--white); }

    .own-listing-note {
      background: var(--brown-light);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 14px 18px;
      color: var(--brown);
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Seller */
    .seller-box {
      background: var(--brown-light);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 4px;
    }
    .seller-box h3 {
      font-size: 13px;
      font-weight: 600;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }
    .seller-name {
      font-size: 15px;
      font-weight: 600;
      color: var(--brown);
    }

    /* ─── Product Details Card ─── */
    .product-details-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 28px;
      margin-bottom: 32px;
    }
    .details-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
      margin-bottom: 24px;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 0;
      border-bottom: 1px solid #f5f1ed;
      gap: 12px;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-key {
      font-weight: 600;
      color: var(--brown);
      font-size: 13px;
      white-space: nowrap;
    }
    .detail-val {
      color: var(--text-dark);
      font-size: 13px;
      text-align: right;
    }

    .desc-section h3 {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 10px;
    }
    .desc-text {
      color: #555;
      line-height: 1.7;
      font-size: 14px;
    }

    /* ─── Reviews ─── */
    .reviews-section {
      margin-bottom: 48px;
    }
    .reviews-section > h2,
    .related-section > h2 {
      font-size: 22px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 22px;
    }

    .reviews-summary-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 28px;
    }
    .summary-grid {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 32px;
      align-items: center;
    }
    .avg-rating-block { text-align: center; }
    .avg-num {
      font-size: 52px;
      font-weight: 800;
      color: var(--text-dark);
      line-height: 1;
    }
    .avg-stars { color: #ffa500; font-size: 22px; margin: 6px 0; }
    .avg-count { color: #888; font-size: 13px; }

    .bars-block { display: flex; flex-direction: column; gap: 7px; }
    .bar-row { display: flex; align-items: center; gap: 10px; }
    .bar-lbl { font-size: 13px; color: #666; width: 52px; white-space: nowrap; }
    .bar-track {
      flex: 1; height: 8px;
      background: #f0f0f0;
      border-radius: 4px;
      overflow: hidden;
    }
    .bar-fill { height: 100%; background: #ffa500; border-radius: 4px; transition: width 0.4s; }
    .bar-cnt { font-size: 13px; color: #666; width: 28px; text-align: right; }

    /* Review Form */
    .review-form-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 24px;
      margin-bottom: 28px;
    }
    .review-form-card h3 {
      font-size: 17px;
      font-weight: 700;
      color: var(--text-dark);
      margin-bottom: 18px;
    }
    .form-group { margin-bottom: 18px; }
    .form-group label {
      display: block;
      font-weight: 600;
      color: var(--text-dark);
      font-size: 13px;
      margin-bottom: 7px;
    }
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 10px 13px;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 14px;
      font-family: inherit;
      color: var(--text-dark);
      transition: border-color 0.2s;
    }
    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--brown);
    }
    .form-group textarea { resize: vertical; }

    .star-picker {
      display: flex;
      gap: 4px;
      font-size: 34px;
      cursor: pointer;
      margin-bottom: 18px;
    }
    .sp-star { color: #ddd; transition: color 0.15s; user-select: none; }
    .sp-star.lit { color: #ffa500; }

    .login-cta {
      background: var(--brown-light);
      border-radius: 10px;
      padding: 20px;
      text-align: center;
      margin-bottom: 28px;
      color: #666;
    }
    .login-cta a { color: var(--brown); font-weight: 600; }

    /* Review Cards */
    .reviews-list { display: flex; flex-direction: column; gap: 16px; }
    .review-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
    }
    .review-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
    }
    .rev-user { display: flex; align-items: center; gap: 12px; }
    .rev-avatar {
      width: 40px; height: 40px;
      border-radius: 50%;
      background: var(--brown);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      font-size: 14px;
      flex-shrink: 0;
    }
    .rev-name { font-weight: 700; color: var(--text-dark); font-size: 14px; }
    .rev-date { font-size: 12px; color: #aaa; margin-top: 2px; }
    .verified-tag {
      display: inline-block;
      background: #e8f5e9;
      color: #2e7d32;
      font-size: 10px;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 4px;
      margin-left: 6px;
      vertical-align: middle;
    }
    .rev-stars { color: #ffa500; font-size: 16px; }
    .rev-title { font-weight: 700; color: var(--text-dark); margin-bottom: 6px; font-size: 14px; }
    .rev-comment { color: #555; line-height: 1.6; font-size: 14px; margin-bottom: 12px; }
    .helpful-btn {
      background: none;
      border: 1px solid var(--border);
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      color: #666;
      cursor: pointer;
      transition: border-color 0.2s, color 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 5px;
    }
    .helpful-btn:hover { border-color: var(--brown); color: var(--brown); }

    /* Pagination */
    .pager {
      display: flex;
      justify-content: center;
      gap: 6px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .pager-btn {
      padding: 7px 14px;
      border: 1px solid var(--border);
      background: var(--white);
      color: var(--brown);
      border-radius: 6px;
      cursor: pointer;
      font-size: 13px;
      transition: background 0.2s, color 0.2s;
    }
    .pager-btn:hover:not(:disabled) { background: var(--brown); color: #fff; }
    .pager-btn.active { background: var(--brown); color: #fff; }
    .pager-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* Loading / empty states */
    .state-msg {
      text-align: center;
      padding: 32px;
      color: #aaa;
      font-size: 14px;
    }

    /* ─── Related ─── */
    .related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
      gap: 18px;
    }
    .rel-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: transform 0.2s, box-shadow 0.2s;
      display: block;
    }
    .rel-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 24px rgba(90,74,58,0.12);
    }
    .rel-img {
      width: 100%;
      height: 180px;
      background: var(--brown-light);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .rel-img img { width: 100%; height: 100%; object-fit: cover; }
    .rel-body { padding: 12px; }
    .rel-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-dark);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin-bottom: 3px;
    }
    .rel-author {
      font-size: 12px;
      color: var(--brown);
      margin-bottom: 6px;
    }
    .rel-price { font-size: 15px; font-weight: 800; color: var(--text-dark); }

    /* ─── Responsive ─── */
    @media (max-width: 768px) {
      .product-main { grid-template-columns: 1fr; gap: 24px; }
      .product-images { position: static; }
      .main-image-wrap { height: 320px; }
      .product-info h1 { font-size: 22px; }
      .price-current { font-size: 26px; }
      .details-grid { grid-template-columns: 1fr; }
      .related-grid { grid-template-columns: repeat(2, 1fr); }
      .summary-grid { grid-template-columns: 1fr; gap: 16px; }
    }
  </style>
</head>
<body>

  <%- include('../partials/header') %>

  <div class="product-wrapper">

    <!-- Breadcrumb -->
    <nav class="breadcrumb">
      <% if (from === 'my-listings') { %>
        <a href="/home">HOME</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/sell/my-listings">MY LISTINGS</a>
        <span class="breadcrumb-sep">›</span>
        <span><%= product.title %></span>
      <% } else { %>
        <a href="/shop">BOOKS</a>
        <span class="breadcrumb-sep">›</span>
        <a href="/shop?category=<%= product.category._id %>"><%= product.category.name %></a>
        <span class="breadcrumb-sep">›</span>
        <span><%= product.title %></span>
      <% } %>
    </nav>

    <!-- Product Main -->
    <div class="product-main">

      <!-- Images column -->
      <div class="product-images">
        <div class="main-image-wrap" id="mainImageWrap">
          <% if (product.images && product.images.length > 0) { %>
            <img id="mainProductImage"
                 src="<%= product.images[0].url %>"
                 alt="<%= product.title %>"
                 title="Click to zoom"
                 onclick="openViewer(0)"/>
            <div class="zoom-hint">🔍 Click to zoom</div>
          <% } else { %>
            <div class="no-image-ph">📚</div>
          <% } %>
        </div>

        <!-- Thumbnails -->
        <% if (product.images && product.images.length > 0) { %>
        <div class="thumbnail-strip" id="thumbStrip">
          <% product.images.forEach((img, idx) => { %>
            <div class="thumb <%= idx === 0 ? 'active' : '' %>"
                 data-index="<%= idx %>"
                 data-url="<%= img.url %>"
                 onclick="selectThumb(this, '<%= img.url %>', <%= idx %>)">
              <img src="<%= img.url %>" alt="View <%= idx + 1 %>"/>
            </div>
          <% }) %>
        </div>
        <% } %>

        <!-- Hidden image list consumed by Viewer.js -->
        <div id="galleryImages">
          <% if (product.images && product.images.length > 0) { %>
            <% product.images.forEach((img, idx) => { %>
              <img src="<%= img.url %>" alt="<%= product.title %> — image <%= idx + 1 %>"/>
            <% }) %>
          <% } %>
        </div>
      </div>

      <!-- Info column -->
      <div class="product-info">
        <h1><%= product.title %></h1>
        <% if (product.author) { %>
          <div class="product-author">by <%= product.author %></div>
        <% } %>

        <div class="price-row">
          <span class="price-current">₹<%= product.price %></span>
          <% if (product.originalPrice && product.originalPrice > product.price) { %>
            <span class="price-original">₹<%= product.originalPrice %></span>
            <span class="discount-badge">
              <%= Math.round((product.originalPrice - product.price) / product.originalPrice * 100) %>% OFF
            </span>
          <% } %>
        </div>

        <div class="condition-badge condition-<%= product.condition %>">
          <%= product.condition.replace('-', ' ') %> condition
        </div>

        <div class="stock-row">
          <% if (product.stock > 10) { %>
            <span class="stock-dot dot-in"></span>
            <span>In Stock (<%= product.stock %> available)</span>
          <% } else if (product.stock > 0) { %>
            <span class="stock-dot dot-low"></span>
            <span>Low Stock — only <%= product.stock %> left</span>
          <% } else { %>
            <span class="stock-dot dot-out"></span>
            <span>Out of Stock</span>
          <% } %>
        </div>

        <!-- Quantity (hide for own listing or out of stock) -->
        <% if (product.stock > 0 && !(locals.userId && product.seller._id.toString() === userId.toString())) { %>
        <div class="qty-section">
          <label class="qty-label">Quantity</label>
          <div class="qty-row">
            <button type="button" id="qtyDec" class="qty-btn" onclick="changeQty(-1)" aria-label="Decrease">−</button>
            <input type="number" id="qtyInput" value="1" readonly/>
            <button type="button" id="qtyInc" class="qty-btn" onclick="changeQty(1)" aria-label="Increase">+</button>
            <span class="qty-max-note">
              Max: <%= Math.min(product.stock, product.maxQuantityPerOrder || 10) %>
              <% if ((product.maxQuantityPerOrder || 10) < product.stock) { %>(per order)<% } %>
            </span>
          </div>
        </div>
        <% } %>

        <!-- Action buttons -->
        <div class="action-buttons">
          <% if (locals.userId && product.seller._id.toString() === userId.toString()) { %>
            <div class="own-listing-note">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
              This is your own listing
            </div>
          <% } else { %>
            <% if (product.stock > 0) { %>
              <button class="btn-primary" id="addToCartBtn" onclick="handleAddToCart('<%= product._id %>')">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                  <path d="m1 1 4 4 2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                Add to Cart
              </button>
            <% } else { %>
              <button class="btn-primary" disabled>Out of Stock</button>
            <% } %>
            <button class="btn-wishlist" id="wishlistBtn"
                    data-product-id="<%= product._id %>"
                    data-in-wishlist="false"
                    onclick="toggleWishlist(event, '<%= product._id %>')"
                    aria-label="Add to wishlist">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </button>
          <% } %>
        </div>

        <!-- Seller -->
        <div class="seller-box">
          <h3>Sold by</h3>
          <div class="seller-name"><%= product.seller.name %></div>
        </div>
      </div>
    </div>

    <!-- Product Details Card -->
    <div class="product-details-card">
      <div class="details-grid">
        <% if (product.isbn) { %>
        <div class="detail-row">
          <span class="detail-key">ISBN</span>
          <span class="detail-val"><%= product.isbn %></span>
        </div>
        <% } %>
        <div class="detail-row">
          <span class="detail-key">Category</span>
          <span class="detail-val"><%= product.category.name %></span>
        </div>
        <% if (product.subcategory) { %>
        <div class="detail-row">
          <span class="detail-key">Subcategory</span>
          <span class="detail-val"><%= product.subcategory.name %></span>
        </div>
        <% } %>
        <% if (product.publisher) { %>
        <div class="detail-row">
          <span class="detail-key">Publisher</span>
          <span class="detail-val"><%= product.publisher %></span>
        </div>
        <% } %>
        <% if (product.publishedYear) { %>
        <div class="detail-row">
          <span class="detail-key">Published</span>
          <span class="detail-val"><%= product.publishedYear %></span>
        </div>
        <% } %>
        <% if (product.language) { %>
        <div class="detail-row">
          <span class="detail-key">Language</span>
          <span class="detail-val"><%= product.language %></span>
        </div>
        <% } %>
        <% if (product.pages) { %>
        <div class="detail-row">
          <span class="detail-key">Pages</span>
          <span class="detail-val"><%= product.pages %></span>
        </div>
        <% } %>
        <% if (product.weight) { %>
        <div class="detail-row">
          <span class="detail-key">Weight</span>
          <span class="detail-val"><%= product.weight %>g</span>
        </div>
        <% } %>
      </div>

      <% if (product.description) { %>
      <div class="desc-section">
        <h3>Description</h3>
        <div class="desc-text"><%= product.description %></div>
      </div>
      <% } %>
    </div>

    <!-- Reviews Section -->
    <div class="reviews-section">
      <h2>Customer Reviews</h2>

      <div class="reviews-summary-card" id="reviewsSummary">
        <div class="state-msg">Loading reviews…</div>
      </div>

      <% if (locals.userId) { %>
      <div class="review-form-card">
        <h3>Write a Review</h3>
        <form id="reviewForm" onsubmit="submitReview(event)">
          <label style="display:block;font-weight:600;color:var(--text-dark);font-size:13px;margin-bottom:6px;">Your Rating *</label>
          <div class="star-picker" id="starPicker">
            <span class="sp-star" data-r="1">★</span>
            <span class="sp-star" data-r="2">★</span>
            <span class="sp-star" data-r="3">★</span>
            <span class="sp-star" data-r="4">★</span>
            <span class="sp-star" data-r="5">★</span>
          </div>
          <input type="hidden" id="ratingVal"/>

          <div class="form-group">
            <label for="revTitle">Review Title (optional)</label>
            <input type="text" id="revTitle" placeholder="Sum up your experience"/>
          </div>
          <div class="form-group">
            <label for="revComment">Your Review *</label>
            <textarea id="revComment" rows="4" placeholder="Share your thoughts about this book" required></textarea>
          </div>
          <button type="submit" class="btn-primary" style="max-width:200px">Submit Review</button>
        </form>
      </div>
      <% } else { %>
      <div class="login-cta">
        Please <a href="/login">login</a> to write a review
      </div>
      <% } %>

      <div id="reviewsList"><div class="state-msg">Loading reviews…</div></div>
      <div id="reviewsPager" class="pager"></div>
    </div>

    <!-- Related Products -->
    <% if (related && related.length > 0) { %>
    <div class="related-section">
      <h2>More from this Category</h2>
      <div class="related-grid">
        <% related.forEach(item => { %>
          <a href="/shop/<%= item._id %>" class="rel-card">
            <div class="rel-img">
              <% if (item.images && item.images.length > 0) { %>
                <img src="<%= item.images[0].url %>" alt="<%= item.title %>"/>
              <% } else { %>
                <div style="font-size:38px;color:#ccc;">📚</div>
              <% } %>
            </div>
            <div class="rel-body">
              <div class="rel-title"><%= item.title %></div>
              <% if (item.author) { %><div class="rel-author">by <%= item.author %></div><% } %>
              <div class="rel-price">₹<%= item.price %></div>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
    <% } %>

  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/js/cart-wishlist.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.6/viewer.min.js"></script>

  <script>
    /* ══════════════════════════════════════════
       CONFIG
    ══════════════════════════════════════════ */
    const PRODUCT_ID   = '<%= product._id %>';
    const MAX_STOCK    = <%= product.stock %>;
    const MAX_PER_ORDER = <%= product.maxQuantityPerOrder || 10 %>;
    const EFFECTIVE_MAX = Math.min(MAX_STOCK, MAX_PER_ORDER);
    let currentReviewPage = 1;
    let chosenRating = 0;

    /* ══════════════════════════════════════════
       IMAGE GALLERY
    ══════════════════════════════════════════ */
    let viewerInstance = null;
    let activeThumbIdx = 0;

    // Build Viewer.js on the hidden gallery div
    (function initViewer() {
      const gallery = document.getElementById('galleryImages');
      if (!gallery || gallery.children.length === 0) return;
      viewerInstance = new Viewer(gallery, {
        inline: false,
        navbar: true,
        toolbar: true,
        tooltip: true,
        movable: true,
        zoomable: true,
        rotatable: false,
        scalable: false,
        transition: true,
        fullscreen: true,
        keyboard: true,
        title: true,
        backdrop: true,
      });
    })();

    function openViewer(index) {
      if (!viewerInstance) return;
      viewerInstance.view(index);
      viewerInstance.show();
    }

    function selectThumb(el, url, idx) {
      // Update main image
      const mainImg = document.getElementById('mainProductImage');
      if (mainImg) {
        mainImg.src = url;
        mainImg.onclick = function() { openViewer(idx); };
      }
      // Update active thumb highlight
      document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
      el.classList.add('active');
      activeThumbIdx = idx;
    }

    /* ══════════════════════════════════════════
       QUANTITY
    ══════════════════════════════════════════ */
    function changeQty(delta) {
      const input = document.getElementById('qtyInput');
      if (!input) return;
      let val = parseInt(input.value) || 1;
      val = Math.min(Math.max(val + delta, 1), EFFECTIVE_MAX);

      if (delta > 0 && parseInt(input.value) >= EFFECTIVE_MAX) {
        const msg = MAX_PER_ORDER < MAX_STOCK
          ? `Maximum ${MAX_PER_ORDER} items allowed per order for this product`
          : `Only ${MAX_STOCK} items available in stock`;
        Swal.fire({ icon: 'warning', title: 'Maximum Quantity', text: msg, confirmButtonColor: '#7A5C3E' });
        return;
      }
      input.value = val;
      syncQtyButtons(val);
    }

    function syncQtyButtons(val) {
      const dec = document.getElementById('qtyDec');
      const inc = document.getElementById('qtyInc');
      if (dec) dec.disabled = val <= 1;
      if (inc) inc.disabled = val >= EFFECTIVE_MAX;
    }

    document.addEventListener('DOMContentLoaded', () => {
      syncQtyButtons(1);
    });

    /* ══════════════════════════════════════════
       CART
    ══════════════════════════════════════════ */
    let cartBusy = false;

    async function handleAddToCart(productId) {
      if (cartBusy) return;
      const qInput = document.getElementById('qtyInput');
      const qty = qInput ? parseInt(qInput.value) || 1 : 1;

      if (qty < 1 || qty > EFFECTIVE_MAX) {
        Swal.fire({ icon: 'warning', title: 'Invalid Quantity', text: `Please select between 1 and ${EFFECTIVE_MAX}.`, confirmButtonColor: '#7A5C3E' });
        return;
      }

      cartBusy = true;
      const btn = document.getElementById('addToCartBtn');
      if (btn) { btn.disabled = true; btn.textContent = 'Adding…'; }

      try {
        const res = await fetch('/cart/add', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId, quantity: qty })
        });
        const data = await res.json();

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: 'Added to Cart!',
            text: `${qty} item${qty > 1 ? 's' : ''} added successfully`,
            timer: 2000,
            showConfirmButton: false,
            timerProgressBar: true
          });
          updateHeaderCartCount();
          if (qInput) { qInput.value = 1; syncQtyButtons(1); }
        } else {
          if (res.status === 401) {
            Swal.fire({
              icon: 'warning', title: 'Login Required',
              text: 'Please login to add items to your cart',
              confirmButtonColor: '#7A5C3E', confirmButtonText: 'Go to Login'
            }).then(r => { if (r.isConfirmed) window.location.href = '/login'; });
          } else {
            Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Failed to add to cart', confirmButtonColor: '#7A5C3E' });
          }
        }
      } catch (e) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong. Please try again.', confirmButtonColor: '#7A5C3E' });
      } finally {
        cartBusy = false;
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = `
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
              <path d="m1 1 4 4 2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            Add to Cart`;
        }
      }
    }

    /* ══════════════════════════════════════════
       WISHLIST
    ══════════════════════════════════════════ */
    window.toggleWishlist = async function(event, productId) {
      event.preventDefault();
      event.stopPropagation();
      const btn = event.currentTarget;
      const inWishlist = btn.getAttribute('data-in-wishlist') === 'true';

      if (typeof CartWishlist !== 'undefined') {
        if (inWishlist) {
          await CartWishlist.removeFromWishlist(productId, btn);
        } else {
          await CartWishlist.addToWishlist(productId, btn);
        }
      } else {
        // Fallback direct call
        const endpoint = inWishlist ? '/wishlist/remove' : '/wishlist/add';
        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId })
          });
          if (res.status === 401) {
            Swal.fire({
              icon: 'warning', title: 'Login Required',
              text: 'Please login to use wishlist',
              confirmButtonColor: '#7A5C3E', confirmButtonText: 'Go to Login'
            }).then(r => { if (r.isConfirmed) window.location.href = '/login'; });
            return;
          }
          const data = await res.json();
          if (data.success) {
            const nowIn = !inWishlist;
            btn.setAttribute('data-in-wishlist', nowIn.toString());
            btn.classList.toggle('in-wishlist', nowIn);
            Swal.fire({
              icon: 'success',
              title: nowIn ? 'Added to Wishlist!' : 'Removed from Wishlist',
              timer: 1500, showConfirmButton: false
            });
            updateHeaderWishlistCount();
          }
        } catch (e) {
          Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', confirmButtonColor: '#7A5C3E' });
        }
      }
    };

    /* ══════════════════════════════════════════
       HEADER BADGE UPDATES
    ══════════════════════════════════════════ */
    async function updateHeaderCartCount() {
      try {
        const res = await fetch('/cart/count');
        const data = await res.json();
        if (data.success) {
          const el = document.querySelector('.cart-count');
          if (el) { el.textContent = data.count; el.style.display = data.count > 0 ? 'block' : 'none'; }
        }
      } catch(e) {}
    }

    async function updateHeaderWishlistCount() {
      try {
        const res = await fetch('/wishlist/count');
        const data = await res.json();
        if (data.success) {
          const el = document.querySelector('.wishlist-count');
          if (el) { el.textContent = data.count; el.style.display = data.count > 0 ? 'flex' : 'none'; }
        }
      } catch(e) {}
    }

    /* ══════════════════════════════════════════
       STAR PICKER
    ══════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', function() {
      const picker = document.getElementById('starPicker');
      if (!picker) return;

      picker.querySelectorAll('.sp-star').forEach(star => {
        star.addEventListener('mouseenter', () => lightStars(parseInt(star.dataset.r)));
        star.addEventListener('click', () => {
          chosenRating = parseInt(star.dataset.r);
          document.getElementById('ratingVal').value = chosenRating;
          lightStars(chosenRating);
        });
      });

      picker.addEventListener('mouseleave', () => lightStars(chosenRating));
    });

    function lightStars(n) {
      document.querySelectorAll('.sp-star').forEach(s => {
        s.classList.toggle('lit', parseInt(s.dataset.r) <= n);
      });
    }

    /* ══════════════════════════════════════════
       SUBMIT REVIEW
    ══════════════════════════════════════════ */
    async function submitReview(e) {
      e.preventDefault();
      if (!chosenRating) {
        Swal.fire({ icon: 'warning', title: 'Rating Required', text: 'Please select a star rating.', confirmButtonColor: '#7A5C3E' });
        return;
      }
      const body = {
        productId: PRODUCT_ID,
        rating: chosenRating,
        title: (document.getElementById('revTitle') || {}).value?.trim() || '',
        comment: (document.getElementById('revComment') || {}).value?.trim() || ''
      };
      if (!body.comment) {
        Swal.fire({ icon: 'warning', title: 'Review Required', text: 'Please write your review.', confirmButtonColor: '#7A5C3E' });
        return;
      }
      try {
        const res = await fetch('/reviews', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await res.json();
        if (data.success) {
          Swal.fire({ icon: 'success', title: 'Review Submitted!', text: 'Thank you for your feedback.', confirmButtonColor: '#7A5C3E' });
          document.getElementById('reviewForm').reset();
          chosenRating = 0;
          lightStars(0);
          loadReviews(1);
        } else {
          Swal.fire({ icon: 'error', title: 'Error', text: data.message || 'Failed to submit review.', confirmButtonColor: '#7A5C3E' });
        }
      } catch(e) {
        Swal.fire({ icon: 'error', title: 'Error', text: 'Something went wrong.', confirmButtonColor: '#7A5C3E' });
      }
    }

    /* ══════════════════════════════════════════
       LOAD REVIEWS
    ══════════════════════════════════════════ */
    async function loadReviews(page = 1) {
      currentReviewPage = page;
      try {
        const res = await fetch(`/reviews/product/${PRODUCT_ID}?page=${page}&limit=5`);
        const data = await res.json();
        if (data.success) {
          renderSummary(data.stats);
          renderReviewList(data.reviews);
          renderPager(data.currentPage, data.totalPages);
        }
      } catch(e) {
        document.getElementById('reviewsList').innerHTML = '<div class="state-msg">Failed to load reviews.</div>';
      }
    }

    function renderSummary(stats) {
      const el = document.getElementById('reviewsSummary');
      if (!stats || stats.totalReviews === 0) {
        el.innerHTML = '<div class="state-msg">No reviews yet. Be the first to review!</div>';
        return;
      }
      const avg = calcAvg(stats.ratingDistribution, stats.totalReviews);
      const stars = '★'.repeat(Math.round(avg)) + '☆'.repeat(5 - Math.round(avg));
      let bars = '';
      for (let i = 5; i >= 1; i--) {
        const cnt = stats.ratingDistribution[i] || 0;
        const pct = stats.totalReviews ? (cnt / stats.totalReviews * 100).toFixed(1) : 0;
        bars += `<div class="bar-row">
          <span class="bar-lbl">${i} star${i > 1 ? 's' : ''}</span>
          <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
          <span class="bar-cnt">${cnt}</span>
        </div>`;
      }
      el.innerHTML = `
        <div class="summary-grid">
          <div class="avg-rating-block">
            <div class="avg-num">${avg.toFixed(1)}</div>
            <div class="avg-stars">${stars}</div>
            <div class="avg-count">${stats.totalReviews} review${stats.totalReviews !== 1 ? 's' : ''}</div>
          </div>
          <div class="bars-block">${bars}</div>
        </div>`;
    }

    function calcAvg(dist, total) {
      if (!total) return 0;
      let sum = 0;
      for (let r = 1; r <= 5; r++) sum += r * (dist[r] || 0);
      return sum / total;
    }

    function renderReviewList(reviews) {
      const el = document.getElementById('reviewsList');
      if (!reviews || !reviews.length) {
        el.innerHTML = '<div class="state-msg">No reviews yet.</div>';
        return;
      }
      el.innerHTML = reviews.map(rv => {
        const stars = '★'.repeat(rv.rating) + '☆'.repeat(5 - rv.rating);
        const date = new Date(rv.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const init = (rv.user.firstName[0] || '') + (rv.user.lastName[0] || '');
        return `
        <div class="review-card">
          <div class="review-top">
            <div class="rev-user">
              <div class="rev-avatar">${init.toUpperCase()}</div>
              <div>
                <div class="rev-name">
                  ${rv.user.firstName} ${rv.user.lastName}
                  ${rv.isVerifiedPurchase ? '<span class="verified-tag">✓ Verified</span>' : ''}
                </div>
                <div class="rev-date">${date}</div>
              </div>
            </div>
            <div class="rev-stars">${stars}</div>
          </div>
          ${rv.title ? `<div class="rev-title">${rv.title}</div>` : ''}
          <div class="rev-comment">${rv.comment}</div>
          <button class="helpful-btn" onclick="markHelpful('${rv._id}')">
            👍 Helpful (${rv.helpfulCount || 0})
          </button>
        </div>`;
      }).join('');
    }

    function renderPager(cur, total) {
      const el = document.getElementById('reviewsPager');
      if (total <= 1) { el.innerHTML = ''; return; }
      let html = `<button class="pager-btn" onclick="loadReviews(${cur-1})" ${cur===1?'disabled':''}>Prev</button>`;
      for (let i = 1; i <= total; i++) {
        if (i === 1 || i === total || (i >= cur-1 && i <= cur+1)) {
          html += `<button class="pager-btn ${i===cur?'active':''}" onclick="loadReviews(${i})">${i}</button>`;
        } else if (i === cur-2 || i === cur+2) {
          html += `<span style="padding:0 4px;color:#aaa">…</span>`;
        }
      }
      html += `<button class="pager-btn" onclick="loadReviews(${cur+1})" ${cur===total?'disabled':''}>Next</button>`;
      el.innerHTML = html;
    }

    async function markHelpful(reviewId) {
      try {
        const res = await fetch(`/reviews/${reviewId}/helpful`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          Swal.fire({ icon: 'success', title: 'Thank you!', timer: 1200, showConfirmButton: false });
          loadReviews(currentReviewPage);
        }
      } catch(e) {}
    }

    /* ══════════════════════════════════════════
       INIT
    ══════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', function() {
      updateHeaderCartCount();
      updateHeaderWishlistCount();
      loadReviews(1);

      // Surface any server-side error in URL
      const urlError = new URLSearchParams(window.location.search).get('error');
      if (urlError) {
        Swal.fire({ icon: 'error', title: 'Error', text: decodeURIComponent(urlError), confirmButtonColor: '#7A5C3E' })
          .then(() => {
            const u = new URL(window.location);
            u.searchParams.delete('error');
            window.history.replaceState({}, '', u);
          });
      }
    });
  </script>
</body>
</html>
