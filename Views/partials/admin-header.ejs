<div class="admin-header">
    <div class="header-left">
        <h1><%= title || 'Admin Dashboard' %></h1>
        <% if (typeof subtitle !== 'undefined' && subtitle) { %>
            <p class="header-subtitle"><%= subtitle %></p>
        <% } %>
    </div>
    <div class="header-right">
        <div class="search-box">
            <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input type="text" placeholder="<%= typeof searchPlaceholder !== 'undefined' ? searchPlaceholder : 'Search...' %>" id="adminSearch">
        </div>
        <div class="header-actions">
            <div class="admin-profile">
                <span class="admin-status">Admin Panel</span>
                <div class="admin-avatar-small">
                    <%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : 'A' %>
                </div>
                <span class="online-status">Online</span>
            </div>
        </div>
    </div>
</div>

<style>
.admin-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    padding: 0;
}

.header-left h1 {
    font-size: 28px;
    font-weight: 600;
    color: #2d2d2d;
    margin: 0 0 4px 0;
}

.header-subtitle {
    color: #6b7280;
    font-size: 14px;
    margin: 0;
}

.header-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.search-box {
    position: relative;
}

.search-box input {
    width: 320px;
    padding: 10px 16px 10px 40px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    font-size: 14px;
    background: white;
    outline: none;
    transition: border-color 0.2s;
}

.search-box input:focus {
    border-color: #8b6f47;
    box-shadow: 0 0 0 3px rgba(139, 111, 71, 0.1);
}

.search-icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    width: 16px;
    height: 16px;
    color: #9ca3af;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 16px;
}

.admin-profile {
    display: flex;
    align-items: center;
    gap: 12px;
}

.admin-status {
    font-size: 12px;
    color: #6b7280;
}

.admin-avatar-small {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #8b6f47;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 12px;
}

.online-status {
    font-size: 12px;
    color: #059669;
    font-weight: 500;
}

@media (max-width: 768px) {
    .admin-header {
        flex-direction: column;
        gap: 16px;
        align-items: stretch;
    }
    
    .header-right {
        justify-content: space-between;
    }
    
    .search-box input {
        width: 100%;
        max-width: 300px;
    }
}
</style>