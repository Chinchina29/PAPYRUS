<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    async function handleUserLogout() {
        const result = await Swal.fire({
            title: 'Sign out?',
            text: 'Are you sure you want to sign out?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, sign out',
            cancelButtonText: 'Stay',
            confirmButtonColor: '#7A5C3E',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
        });

        if (!result.isConfirmed) return;

        try {
            const res  = await fetch('/logout', {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
            });
            const data = await res.json();

            if (data.success) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Signed Out',
                    text: 'You have been signed out successfully.',
                    timer: 1500,
                    showConfirmButton: false,
                    timerProgressBar: true,
                });
                window.location.href = data.redirectUrl || '/login';
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not sign out. Please try again.',
                });
            }
        } catch {
            Swal.fire({
                icon: 'error',
                title: 'Connection Error',
                text: 'Please try again.',
            });
        }
    }

    // Update cart count function
    async function updateCartCount() {
        try {
            const response = await fetch('/cart/count');
            const data = await response.json();
            
            if (data.success) {
                const cartCountElement = document.querySelector('.cart-count');
                if (cartCountElement) {
                    cartCountElement.textContent = data.count;
                    cartCountElement.style.display = data.count > 0 ? 'flex' : 'none';
                }
            }
        } catch (error) {
            // Silently fail for cart count - user might not be logged in
        }
    }

    // Update wishlist count function
    async function updateWishlistCount() {
        try {
            const response = await fetch('/wishlist/count');
            const data = await response.json();
            
            if (data.success) {
                const wishlistCountElement = document.querySelector('.wishlist-count');
                if (wishlistCountElement) {
                    wishlistCountElement.textContent = data.count;
                    wishlistCountElement.style.display = data.count > 0 ? 'flex' : 'none';
                }
            }
        } catch (error) {
            // Silently fail for wishlist count - user might not be logged in
        }
    }

    // Load cart and wishlist counts on page load
    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();
        updateWishlistCount();
    });
</script>