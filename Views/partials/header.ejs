<header class="header">
    <div class="container">
        <!-- Mobile Hamburger Button -->
        <button 
            class="hamburger-btn" 
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            type="button">
            <span class="hamburger-icon">
                <span class="line line-1"></span>
                <span class="line line-2"></span>
                <span class="line line-3"></span>
            </span>
        </button>

        <!-- Logo -->
        <a href="/home" class="logo" style="text-decoration: none; color: inherit; cursor: pointer;" aria-label="Papyrus home">
            <svg viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 70 Q10 75 15 75 L45 75 Q48 75 50 70 L50 85 Q48 90 45 90 L15 90 Q10 90 10 85 Z" fill="#7A5C3E"/>
                <path d="M90 70 Q90 75 85 75 L55 75 Q52 75 50 70 L50 85 Q52 90 55 90 L85 90 Q90 90 90 85 Z" fill="#7A5C3E"/>
                <path d="M50 70 L45 50 L50 30 L55 50 Z" fill="#5a4a3a"/>
                <circle cx="50" cy="25" r="6" fill="#5a4a3a"/>
                <ellipse cx="50" cy="15" rx="4" ry="7" fill="#7A5C3E"/>
                <ellipse cx="42" cy="20" rx="4" ry="6" fill="#7A5C3E"/>
                <ellipse cx="58" cy="20" rx="4" ry="6" fill="#7A5C3E"/>
                <ellipse cx="38" cy="28" rx="5" ry="7" fill="#7A5C3E"/>
                <ellipse cx="62" cy="28" rx="5" ry="7" fill="#7A5C3E"/>
                <ellipse cx="35" cy="38" rx="4" ry="6" fill="#7A5C3E"/>
                <ellipse cx="65" cy="38" rx="4" ry="6" fill="#7A5C3E"/>
            </svg>
            <span>Papyrus</span>
        </a>

        <!-- Desktop Navigation (hidden on mobile) -->
        <nav class="nav nav-desktop" aria-label="Main navigation">
            <a href="/home">Browse</a>
            <a href="/shop">Books</a>
            <a href="/sell">Sell</a>
            <a href="#" onclick="showComingSoon(event, 'About')">About</a>
        </nav>

        <!-- Header Icons (visible on all screens) -->
        <div class="header-icons">
            <a href="#" class="icon-btn cart-icon" onclick="handleCartClick(event)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="9" cy="21" r="1"></circle>
                    <circle cx="20" cy="21" r="1"></circle>
                    <path d="m1 1 4 4 2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                </svg>
                <span class="cart-count">0</span>
            </a>
            <a href="#" class="icon-btn wishlist-icon" onclick="handleWishlistClick(event)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
                <span class="wishlist-count">0</span>
            </a>
            <a href="#" class="icon-btn" onclick="handleProfileClick(event)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </a>

            <% if (locals.isLoggedIn || (locals.user && locals.user.id)) { %>
            <a href="#" class="icon-btn" onclick="handleUserLogout(event)" title="Sign Out" aria-label="Sign out">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
            </a>
            <% } %>

        </div>
    </div>

    <div id="header-user-data" data-logged-in="<%= (locals.isLoggedIn || (locals.user && locals.user.id)) ? 'true' : 'false' %>" style="display:none;"></div>

<script>
    // Check if user is logged in
    const isUserLoggedIn = document.getElementById('header-user-data')?.dataset?.loggedIn === 'true';
    
    function handleCartClick(event) {
        event.preventDefault();
        if (!isUserLoggedIn) {
            Swal.fire({
                icon: 'warning',
                title: 'Login Required',
                text: 'Please log in to access your shopping cart.',
                confirmButtonText: 'Go to Login',
                confirmButtonColor: '#7A5C3E',
                showCancelButton: true,
                cancelButtonText: 'Cancel',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/login?redirect=/cart';
                }
            });
        } else {
            window.location.href = '/cart';
        }
    }
    
    function handleWishlistClick(event) {
        event.preventDefault();
        if (!isUserLoggedIn) {
            Swal.fire({
                icon: 'warning',
                title: 'Login Required',
                text: 'Please log in to access your wishlist.',
                confirmButtonText: 'Go to Login',
                confirmButtonColor: '#7A5C3E',
                showCancelButton: true,
                cancelButtonText: 'Cancel',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/login?redirect=/wishlist';
                }
            });
        } else {
            window.location.href = '/wishlist';
        }
    }
    
    function handleProfileClick(event) {
        event.preventDefault();
        if (!isUserLoggedIn) {
            Swal.fire({
                icon: 'warning',
                title: 'Login Required',
                text: 'Please log in to access your profile.',
                confirmButtonText: 'Go to Login',
                confirmButtonColor: '#7A5C3E',
                showCancelButton: true,
                cancelButtonText: 'Cancel',
                cancelButtonColor: '#6c757d'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/login?redirect=/profile';
                }
            });
        } else {
            window.location.href = '/profile';
        }
    }
</script>

    <!-- Mobile Navigation Menu (hidden by default) -->
    <nav class="nav nav-mobile" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true" style="pointer-events: auto !important;">
        <a href="/home" style="pointer-events: auto !important; cursor: pointer !important;">Browse</a>
        <a href="/shop" style="pointer-events: auto !important; cursor: pointer !important;">Books</a>
        <a href="/sell" style="pointer-events: auto !important; cursor: pointer !important;">Sell</a>
        <a href="#" onclick="showComingSoon(event, 'About')" style="pointer-events: auto !important; cursor: pointer !important;">About</a>
    </nav>
</header>

<!-- Include Mobile Responsive CSS and JavaScript -->
<link rel="stylesheet" href="/css/mobile-responsive.css">
<script src="/js/hamburger-menu.js"></script>
<script>
  // Debug: Check if elements are found
  document.addEventListener('DOMContentLoaded', function() {
    console.log('=== Hamburger Menu Debug ===');
    console.log('Hamburger button:', document.querySelector('.hamburger-btn'));
    console.log('Mobile nav:', document.querySelector('.nav-mobile'));
    console.log('Desktop nav:', document.querySelector('.nav-desktop'));
    console.log('Body classes:', document.body.className);
  });
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/blocked-user-handler.js"></script>

<script>
    function showComingSoon(event, pageName) {
        event.preventDefault();
        Swal.fire({
            icon: 'info',
            title: `${pageName} Page`,
            html: `<p>The <strong>${pageName}</strong> page is currently under development.</p><p>We're working hard to bring you this feature soon!</p>`,
            confirmButtonText: 'Got it',
            confirmButtonColor: '#7A5C3E',
            iconColor: '#7A5C3E'
        });
    }

    async function handleUserLogout() {
        const result = await Swal.fire({
            title: 'Sign out?',
            text: 'Are you sure you want to sign out?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonText: 'Yes, sign out',
            cancelButtonText: 'Stay',
            confirmButtonColor: '#7A5C3E',
            cancelButtonColor: '#6c757d',
            reverseButtons: true,
        });

        if (!result.isConfirmed) return;

        try {
            const res  = await fetch('/logout', {
                method: 'GET',
                headers: { 'Accept': 'application/json' },
            });
            const data = await res.json();

            if (data.success) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Signed Out',
                    text: 'You have been signed out successfully.',
                    timer: 1500,
                    showConfirmButton: false,
                    timerProgressBar: true,
                });
                window.location.href = data.redirectUrl || '/';
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Could not sign out. Please try again.',
                });
            }
        } catch {
            Swal.fire({
                icon: 'error',
                title: 'Connection Error',
                text: 'Please try again.',
            });
        }
    }

    async function updateCartCount() {
        try {
            const response = await fetch('/cart/count');
            const data = await response.json();
            
            if (data.success) {
                const cartCountElement = document.querySelector('.cart-count');
                if (cartCountElement) {
                    cartCountElement.textContent = data.count;
                    cartCountElement.style.display = data.count > 0 ? 'flex' : 'none';
                }
            }
        } catch (error) {
        }
    }

    async function updateWishlistCount() {
        try {
            const response = await fetch('/wishlist/count');
            const data = await response.json();
            
            if (data.success) {
                const wishlistCountElement = document.querySelector('.wishlist-count');
                if (wishlistCountElement) {
                    wishlistCountElement.textContent = data.count;
                    wishlistCountElement.style.display = data.count > 0 ? 'flex' : 'none';
                }
            }
        } catch (error) {
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        updateCartCount();
        updateWishlistCount();
    });
</script>