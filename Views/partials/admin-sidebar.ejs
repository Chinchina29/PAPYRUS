<div class="admin-sidebar">
    <div class="sidebar-logo">
        <h2>📚 Papyrus</h2>
    </div>
    <nav class="sidebar-nav">
        <a href="/admin/dashboard" class="nav-item <%= currentPage_name === 'dashboard' ? 'active' : '' %>">
            <span class="nav-icon">📊</span>
            Dashboard
        </a>
        <a href="/admin/submissions" class="nav-item <%= currentPage_name === 'submissions' ? 'active' : '' %>">
            <span class="nav-icon">📋</span>
            Book Listings
        </a>
        <a href="/admin/products" class="nav-item <%= currentPage_name === 'inventory' ? 'active' : '' %>">
            <span class="nav-icon">📦</span>
            Inventory Management
        </a>
        <a href="/admin/categories" class="nav-item <%= currentPage_name === 'categories' ? 'active' : '' %>">
            <span class="nav-icon">🏷️</span>
            Category Management
        </a>
        <a href="/admin/orders" class="nav-item <%= currentPage_name === 'orders' ? 'active' : '' %>">
            <span class="nav-icon">🛒</span>
            Order Management
        </a>
        <a href="/admin/users" class="nav-item <%= currentPage_name === 'users' ? 'active' : '' %>">
            <span class="nav-icon">👥</span>
            User Management
        </a>
        <a href="/admin/wallet" class="nav-item <%= currentPage_name === 'wallet' ? 'active' : '' %>">
            <span class="nav-icon">💰</span>
            Wallet
        </a>
        <a href="/admin/reports" class="nav-item <%= currentPage_name === 'reports' ? 'active' : '' %>">
            <span class="nav-icon">📈</span>
            Sales Reports
        </a>
        <a href="/admin/coupons" class="nav-item <%= currentPage_name === 'coupons' ? 'active' : '' %>">
            <span class="nav-icon">🎫</span>
            Coupons
        </a>
        <a href="/admin/settings" class="nav-item <%= currentPage_name === 'settings' ? 'active' : '' %>">
            <span class="nav-icon">⚙️</span>
            Settings
        </a>
        <a href="/admin/support" class="nav-item <%= currentPage_name === 'support' ? 'active' : '' %>">
            <span class="nav-icon">❓</span>
            Support
        </a>
    </nav>
    <div class="sidebar-footer">
        <div class="admin-info">
            <div class="admin-avatar">
                <%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="admin-details">
                <div class="admin-name"><%= user ? user.firstName + ' ' + user.lastName : 'Admin' %></div>
                <div class="admin-role">Administrator</div>
            </div>
        </div>
        <a href="#" class="logout-btn" onclick="handleLogout(event)">
            <span class="nav-icon">🚪</span>
            Logout
        </a>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
async function handleLogout(event) {
    event.preventDefault();
    
    const result = await Swal.fire({
        title: 'Logout?',
        text: 'Are you sure you want to logout?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Yes, logout',
        cancelButtonText: 'Cancel'
    });

    if (result.isConfirmed) {
        window.location.href = '/admin/logout';
    }
}
</script>

