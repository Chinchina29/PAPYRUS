<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Verify OTP | Papyrus</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #c8b99a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .steps {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        border: 2px solid #a89070;
        color: #a89070;
        background: transparent;
      }
      .step.active .step-circle {
        background: #3d2c1e;
        color: #fff;
        border-color: #3d2c1e;
      }
      .step.done .step-circle {
        background: #3d2c1e;
        border-color: #3d2c1e;
        color: #fff;
        font-size: 20px;
      }
      .step-label {
        font-size: 12px;
        color: #a89070;
        font-weight: 500;
      }
      .step.active .step-label {
        color: #3d2c1e;
        font-weight: 600;
      }
      .step.done .step-label {
        color: #3d2c1e;
      }

      .step-arrow {
        display: flex;
        align-items: center;
        padding: 0 12px;
        padding-bottom: 22px;
      }
      .step-arrow.done::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #3d2c1e;
        margin-right: 4px;
      }
      .step-arrow.done::after {
        content: "▶";
        font-size: 10px;
        color: #3d2c1e;
      }
      .step-arrow.inactive::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #a89070;
        margin-right: 4px;
      }
      .step-arrow.inactive::after {
        content: "▶";
        font-size: 10px;
        color: #a89070;
      }

      .card {
        background: #f5efe6;
        border-radius: 16px;
        padding: 48px 44px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd0ba;
        text-align: center;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
      }
      .logo-icon {
        font-size: 28px;
      }
      .logo-text {
        font-size: 22px;
        font-weight: 700;
        color: #3d2c1e;
      }

      .card h2 {
        font-size: 26px;
        font-weight: 700;
        color: #3d2c1e;
        margin-bottom: 10px;
      }
      .card .subtitle {
        font-size: 14px;
        color: #7a6a58;
        margin-bottom: 4px;
      }
      .email-text {
        font-size: 14px;
        font-weight: 700;
        color: #3d2c1e;
        margin-bottom: 28px;
      }

      .otp-wrapper {
        display: flex;
        gap: 12px;
        justify-content: center;
        margin-bottom: 8px;
      }
      .otp-box {
        width: 56px;
        height: 64px;
        text-align: center;
        font-size: 26px;
        font-weight: 700;
        border: 2px solid #c8b99a;
        border-radius: 10px;
        background: #faf7f2;
        color: #3d2c1e;
        outline: none;
        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }
      .otp-box:focus {
        border-color: #3d2c1e;
        box-shadow: 0 0 0 3px rgba(61, 44, 30, 0.12);
      }
      .otp-box.filled {
        border-color: #3d2c1e;
        background: #f0e8dc;
      }
      .otp-box.error {
        border-color: #dc3545;
      }

      .otp-error {
        color: #dc3545;
        font-size: 12px;
        margin-bottom: 16px;
        min-height: 18px;
        display: block;
      }

      .btn-primary {
        width: 100%;
        padding: 15px;
        background: #3d2c1e;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-bottom: 20px;
      }
      .btn-primary:hover {
        background: #2a1f14;
      }
      .btn-primary:disabled {
        background: #9a8a7a;
        cursor: not-allowed;
      }

      .resend-row {
        font-size: 13px;
        color: #7a6a58;
        margin-bottom: 16px;
      }
      .resend-btn {
        background: none;
        border: none;
        color: #3d2c1e;
        font-weight: 700;
        font-size: 13px;
        cursor: pointer;
        padding: 0;
      }
      .resend-btn:hover {
        text-decoration: underline;
      }
      .resend-btn:disabled {
        color: #a89070;
        cursor: not-allowed;
      }
      .timer-text {
        font-size: 12px;
        color: #a89070;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #7a6a58;
        text-decoration: none;
        font-size: 13px;
      }
      .back-link:hover {
        color: #3d2c1e;
      }
    </style>
  </head>
  <body>
    <div class="steps">
      <div class="step done">
        <div class="step-circle">✓</div>
        <span class="step-label">Email</span>
      </div>
      <div class="step-arrow done"></div>
      <div class="step active">
        <div class="step-circle">2</div>
        <span class="step-label">Verify</span>
      </div>
      <div class="step-arrow inactive"></div>
      <div class="step">
        <div class="step-circle">3</div>
        <span class="step-label">Reset</span>
      </div>
    </div>

    <div class="card">
      <div class="logo">
        <span class="logo-icon">📖</span>
        <span class="logo-text">Papyrus</span>
      </div>

      <h2>Verify Your Email</h2>
      <p class="subtitle">We've sent a 6-digit verification code to</p>
      <p class="email-text"><%= email %></p>

      <form id="otpForm" novalidate>
        <div class="otp-wrapper">
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp1"
            name="otp1"
            autocomplete="off"
          />
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp2"
            name="otp2"
            autocomplete="off"
          />
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp3"
            name="otp3"
            autocomplete="off"
          />
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp4"
            name="otp4"
            autocomplete="off"
          />
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp5"
            name="otp5"
            autocomplete="off"
          />
          <input
            class="otp-box"
            type="text"
            inputmode="numeric"
            maxlength="1"
            id="otp6"
            name="otp6"
            autocomplete="off"
          />
        </div>
        <span class="otp-error" id="otp-error"></span>
        <button type="submit" class="btn-primary" id="verifyBtn">
          Verify Code
        </button>
      </form>

      <div class="resend-row">
        Didn't receive the code?
        <button class="resend-btn" id="resendBtn" onclick="resendOTP()">
          Resend Code
        </button>
        <span class="timer-text" id="timerText" style="display: none"></span>
      </div>

      <a href="/admin/signin" class="back-link">&#8592; Back to Sign In</a>
    </div>

    <script>
      const boxes = document.querySelectorAll(".otp-box");
      boxes[0].focus();

      boxes.forEach((box, i) => {
        box.addEventListener("input", () => {
          box.value = box.value.replace(/\D/g, "").slice(0, 1);
          if (box.value) {
            box.classList.add("filled");
            if (i < boxes.length - 1) boxes[i + 1].focus();
          } else {
            box.classList.remove("filled");
          }
        });
        box.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && !box.value && i > 0) {
            boxes[i - 1].value = "";
            boxes[i - 1].classList.remove("filled");
            boxes[i - 1].focus();
          }
        });
        box.addEventListener("paste", (e) => {
          e.preventDefault();
          const digits = e.clipboardData
            .getData("text")
            .replace(/\D/g, "")
            .slice(0, 6);
          [...digits].forEach((d, j) => {
            if (boxes[j]) {
              boxes[j].value = d;
              boxes[j].classList.add("filled");
            }
          });
          boxes[Math.min(digits.length, boxes.length - 1)].focus();
        });
      });

      document
        .getElementById("otpForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const vals = [...boxes].map((b) => b.value);
          const errEl = document.getElementById("otp-error");

          if (vals.some((v) => !v)) {
            errEl.textContent = "Please enter all 6 digits.";
            boxes.forEach((b) => {
              if (!b.value) b.classList.add("error");
            });
            return;
          }
          errEl.textContent = "";
          boxes.forEach((b) => b.classList.remove("error"));

          const btn = document.getElementById("verifyBtn");
          btn.textContent = "Verifying…";
          btn.disabled = true;

          const body = {};
          vals.forEach((v, i) => (body[`otp${i + 1}`] = v));

          try {
            const res = await fetch("/admin/forgot-password/verify", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(body),
            });
            const data = await res.json();

            if (data.success) {
              await Swal.fire({
                icon: "success",
                title: "Verified!",
                text: data.message,
                timer: 1500,
                showConfirmButton: false,
                timerProgressBar: true,
                background: "#f5efe6",
                color: "#3d2c1e",
                iconColor: "#3d2c1e",
              });
              window.location.href =
                data.redirectUrl || "/admin/forgot-password/reset";
            } else {
              errEl.textContent =
                data.message || "Invalid OTP. Please try again.";
              boxes.forEach((b) => {
                b.value = "";
                b.classList.remove("filled");
                b.classList.add("error");
              });
              boxes[0].focus();
            }
          } catch {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: "Please try again.",
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
          } finally {
            btn.textContent = "Verify Code";
            btn.disabled = false;
          }
        });

      let cooldownId = null;

      async function resendOTP() {
        const btn = document.getElementById("resendBtn");
        const timerText = document.getElementById("timerText");
        btn.disabled = true;

        try {
          const res = await fetch("/admin/forgot-password/resend", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
          });
          const data = await res.json();

          if (data.success) {
            Swal.fire({
              icon: "success",
              title: "Code Resent!",
              text: data.message,
              timer: 2000,
              showConfirmButton: false,
              background: "#f5efe6",
              color: "#3d2c1e",
              iconColor: "#3d2c1e",
            });
            startCooldown(60, btn, timerText);
          } else if (res.status === 429) {
            Swal.fire({
              icon: "warning",
              title: "Too Many Requests",
              text: data.message,
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
            startCooldown(data.secondsLeft || 60, btn, timerText);
          } else {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: data.message,
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
            btn.disabled = false;
          }
        } catch {
          Swal.fire({
            icon: "error",
            title: "Error",
            text: "Could not resend code.",
            background: "#f5efe6",
            color: "#3d2c1e",
            confirmButtonColor: "#3d2c1e",
          });
          btn.disabled = false;
        }
      }

      function startCooldown(seconds, btn, timerEl) {
        if (cooldownId) clearInterval(cooldownId);
        let left = seconds;
        btn.style.display = "none";
        timerEl.style.display = "inline";
        timerEl.textContent = `Resend in ${left}s`;
        cooldownId = setInterval(() => {
          left--;
          timerEl.textContent = `Resend in ${left}s`;
          if (left <= 0) {
            clearInterval(cooldownId);
            timerEl.style.display = "none";
            btn.style.display = "inline";
            btn.disabled = false;
          }
        }, 1000);
      }
    </script>
  </body>
</html>
