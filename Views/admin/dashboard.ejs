<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Overview - Papyrus Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #f8f6f3;
            color: #2d2d2d;
            line-height: 1.5;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 240px;
            flex: 1;
            padding: 32px;
            min-height: 100vh;
        }

        .content-wrapper {
            max-width: 1400px;
            margin: 0 auto;
        }

        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .header-left h1 {
            font-size: 28px;
            font-weight: 600;
            color: #2d2d2d;
            margin-bottom: 4px;
        }

        .header-subtitle {
            color: #6b7280;
            font-size: 14px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            width: 320px;
            padding: 10px 16px 10px 40px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            background: white;
            outline: none;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: #9ca3af;
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #8b6f47;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 12px;
        }

        .page-actions {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .btn {
            padding: 10px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-primary {
            background: #8b6f47;
            color: white;
        }

        .btn-primary:hover {
            background: #6b5a48;
        }

        .btn-secondary {
            background: white;
            color: #6b7280;
            border: 1px solid #d1d5db;
        }

        .btn-secondary:hover {
            background: #f9fafb;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: #f5f1ed;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8b6f47;
        }

        .stat-icon svg {
            width: 24px;
            height: 24px;
        }

        .stat-content {
            flex: 1;
        }

        .stat-value {
            font-size: 24px;
            font-weight: 700;
            color: #2d2d2d;
            margin-bottom: 4px;
        }

        .stat-label {
            font-size: 14px;
            color: #6b7280;
            margin-bottom: 8px;
        }

        .stat-change {
            font-size: 12px;
            font-weight: 600;
            padding: 4px 8px;
            border-radius: 4px;
            display: inline-block;
        }

        .stat-change.positive {
            background: #d1fae5;
            color: #065f46;
        }

        .stat-change.neutral {
            background: #f3f4f6;
            color: #6b7280;
        }

        .card {
            background: white;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #e5e7eb;
            margin-bottom: 24px;
        }

        .card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid #f3f4f6;
        }

        .card-title {
            font-size: 18px;
            font-weight: 600;
            color: #2d2d2d;
            margin: 0;
        }

        .table-responsive {
            overflow-x: auto;
            margin: -24px;
            margin-top: 0;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }

        .table th,
        .table td {
            padding: 12px 24px;
            text-align: left;
            border-bottom: 1px solid #f3f4f6;
        }

        .table th {
            background: #f9fafb;
            font-weight: 600;
            color: #374151;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .table tbody tr:hover {
            background: #f9fafb;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        @media (max-width: 1200px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 16px;
            }
            
            .stats-grid {
                grid-template-columns: 1fr;
            }
        }
        .breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-size: 14px; }
        .breadcrumb a { color: #8b6f47; text-decoration: none; transition: color 0.2s; }
        .breadcrumb a:hover { color: #6b5a48; text-decoration: underline; cursor: pointer; }
        .breadcrumb span { color: #9ca3af; }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include('../partials/admin-sidebar', { currentPage_name: 'dashboard' }) %>
        
        <div class="main-content">
            <div class="content-wrapper">
                <div class="breadcrumb">
                    <span style="color: #2d2d2d;">DASHBOARD</span>
                </div>

                <div class="admin-header">
                    <div class="header-left">
                        <h1>Dashboard Overview</h1>
                        <p class="header-subtitle">Welcome back. Here's what's happening in the library today.</p>
                    </div>
                    <div class="header-right">
                        <div class="search-box">
                            <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                            <input type="text" placeholder="Search for books, authors...">
                        </div>
                        <div class="admin-profile">
                            <span style="font-size: 12px; color: #6b7280;">Admin Panel</span>
                            <div class="admin-avatar">
                                <%= user && user.firstName ? user.firstName.charAt(0).toUpperCase() : 'A' %>
                            </div>
                            <span style="font-size: 12px; color: #059669;">Online</span>
                        </div>
                    </div>
                </div>

                <div class="page-actions">
                    <select id="chartFilter" class="btn btn-secondary" style="font-family: inherit; font-size: 14px; outline: none; cursor: pointer; padding: 10px 16px;">
                        <option value="weekly">Weekly (Last 7 Days)</option>
                        <option value="monthly" selected>Monthly (Current Year)</option>
                        <option value="yearly">Yearly (Last 5 Years)</option>
                    </select>
                    <a href="/admin/reports" class="btn btn-primary" style="text-decoration: none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width: 16px; height: 16px;">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7,10 12,15 17,10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        Export Report
                    </a>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v20m8-10H4"/>
                            </svg>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value">₹<%= stats.revenue.toLocaleString() %></div>
                            <div class="stat-label">Total Sales</div>
                            <div class="stat-change positive">+<%= stats.revenueGrowth %>%</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                <circle cx="9" cy="7" r="4"/>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                            </svg>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value"><%= stats.activeUsers.toLocaleString() %></div>
                            <div class="stat-label">Active Users</div>
                            <div class="stat-change positive">+<%= stats.ordersGrowth %>%</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                            </svg>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value"><%= stats.totalUsers.toLocaleString() %></div>
                            <div class="stat-label">Total Users</div>
                            <div class="stat-change neutral">Status</div>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                        </div>
                        <div class="stat-content">
                            <div class="stat-value"><%= stats.newUsersToday %></div>
                            <div class="stat-label">New Users Today</div>
                            <div class="stat-change positive">+<%= stats.newUsersToday %></div>
                        </div>
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Revenue Growth</h3>
                            <p style="color: #6b7280; font-size: 14px; margin: 0;">Monthly revenue performance</p>
                        </div>
                        <div style="height: 300px; position: relative;">
                            <canvas id="revenueChart"></canvas>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Categories</h3>
                            <p style="color: #6b7280; font-size: 14px; margin: 0;">Stock distribution</p>
                        </div>
                        <div style="text-align: center;">
                            <div style="width: 200px; height: 200px; border-radius: 50%; background: conic-gradient(#8b6f47 0deg 162deg, #a68b5b 162deg 270deg, #c4a373 270deg 360deg); position: relative; margin: 0 auto 24px;">
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 120px; height: 120px; background: white; border-radius: 50%;"></div>
                                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; z-index: 1;">
                                    <div style="font-size: 24px; font-weight: 700; color: #2d2d2d;">1.2k</div>
                                    <div style="font-size: 14px; color: #6b7280;">Books</div>
                                </div>
                            </div>
                            <div style="display: flex; flex-direction: column; gap: 12px;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 12px; height: 12px; border-radius: 2px; background: #8b6f47;"></span>
                                    <span style="flex: 1; font-size: 14px; color: #6b7280;">Classic Literature</span>
                                    <span style="font-size: 14px; font-weight: 600; color: #2d2d2d;">45%</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 12px; height: 12px; border-radius: 2px; background: #a68b5b;"></span>
                                    <span style="flex: 1; font-size: 14px; color: #6b7280;">Historical</span>
                                    <span style="font-size: 14px; font-weight: 600; color: #2d2d2d;">30%</span>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="width: 12px; height: 12px; border-radius: 2px; background: #c4a373;"></span>
                                    <span style="flex: 1; font-size: 14px; color: #6b7280;">Other</span>
                                    <span style="font-size: 14px; font-weight: 600; color: #2d2d2d;">25%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top 10 Best Sellers Grid -->
                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-bottom: 32px;">
                    <!-- Top Products Card -->
                    <div class="card" style="padding: 20px;">
                        <div class="card-header" style="margin-bottom: 12px; padding-bottom: 8px;">
                            <h3 class="card-title" style="font-size: 16px;">Top Products (Top 10)</h3>
                        </div>
                        <div style="max-height: 400px; overflow-y: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Rank</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Product</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600; text-align: right;">Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (bestSellingProducts && bestSellingProducts.length > 0) { %>
                                        <% bestSellingProducts.forEach((prod, idx) => { %>
                                            <tr style="border-bottom: 1px solid #f9f9f9;">
                                                <td style="padding: 8px 4px; font-weight: 600; color: #8b6f47;">#<%= idx + 1 %></td>
                                                <td style="padding: 8px 4px;">
                                                    <div style="display: flex; align-items: center; gap: 8px;">
                                                        <div style="width: 30px; height: 40px; border-radius: 4px; overflow: hidden; background: #eee; flex-shrink: 0;">
                                                            <% if (prod.productInfo && prod.productInfo.images && prod.productInfo.images.length > 0) { %>
                                                                <img src="<%= prod.productInfo.images[0].url %>" style="width: 100%; height: 100%; object-fit: cover;">
                                                            <% } else { %>
                                                                <div style="display: flex; align-items: center; justify-content: center; height: 100%; font-size: 14px; color: #bbb;">📚</div>
                                                            <% } %>
                                                        </div>
                                                        <div style="font-weight: 500; text-overflow: ellipsis; overflow: hidden; white-space: nowrap; max-width: 140px;" title="<%= prod.title %>"><%= prod.title %></div>
                                                    </div>
                                                </td>
                                                <td style="padding: 8px 4px; text-align: right; font-weight: 600;"><%= prod.totalQty %></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="padding: 16px 0; text-align: center; color: #9ca3af;">No sales data available</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top Categories Card -->
                    <div class="card" style="padding: 20px;">
                        <div class="card-header" style="margin-bottom: 12px; padding-bottom: 8px;">
                            <h3 class="card-title" style="font-size: 16px;">Top Categories (Top 10)</h3>
                        </div>
                        <div style="max-height: 400px; overflow-y: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Rank</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Category</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600; text-align: right;">Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (bestSellingCategories && bestSellingCategories.length > 0) { %>
                                        <% bestSellingCategories.forEach((cat, idx) => { %>
                                            <tr style="border-bottom: 1px solid #f9f9f9;">
                                                <td style="padding: 8px 4px; font-weight: 600; color: #8b6f47;">#<%= idx + 1 %></td>
                                                <td style="padding: 8px 4px; font-weight: 500;"><%= cat.categoryName || 'Unknown' %></td>
                                                <td style="padding: 8px 4px; text-align: right; font-weight: 600;"><%= cat.totalQty %></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="padding: 16px 0; text-align: center; color: #9ca3af;">No sales data available</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Top Brands Card -->
                    <div class="card" style="padding: 20px;">
                        <div class="card-header" style="margin-bottom: 12px; padding-bottom: 8px;">
                            <h3 class="card-title" style="font-size: 16px;">Top Brands (Top 10)</h3>
                        </div>
                        <div style="max-height: 400px; overflow-y: auto;">
                            <table style="width: 100%; border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="border-bottom: 1px solid #eee; text-align: left;">
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Rank</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600;">Brand</th>
                                        <th style="padding: 8px 4px; color: #6b7280; font-weight: 600; text-align: right;">Qty</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (bestSellingBrands && bestSellingBrands.length > 0) { %>
                                        <% bestSellingBrands.forEach((br, idx) => { %>
                                            <tr style="border-bottom: 1px solid #f9f9f9;">
                                                <td style="padding: 8px 4px; font-weight: 600; color: #8b6f47;">#<%= idx + 1 %></td>
                                                <td style="padding: 8px 4px; font-weight: 500;"><%= br._id || 'Generic' %></td>
                                                <td style="padding: 8px 4px; text-align: right; font-weight: 600;"><%= br.totalQty %></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="3" style="padding: 16px 0; text-align: center; color: #9ca3af;">No sales data available</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <div>
                            <h3 class="card-title">Recent Listings & Transactions</h3>
                            <p style="color: #6b7280; font-size: 14px; margin: 0;">Activity awaiting your approval and recent orders</p>
                        </div>
                        <a href="/admin/submissions" class="btn btn-secondary">View All Activity</a>
                    </div>

                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Reference</th>
                                    <th>Item/Book Title</th>
                                    <th>Curator/Buyer</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td>
                                        <span style="font-weight: 600; color: #8b6f47;">RP-8825</span>
                                    </td>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 12px;">
                                            <div style="width: 40px; height: 50px; background: #8b6f47; border-radius: 4px; flex-shrink: 0;"></div>
                                            <div>
                                                <div style="font-weight: 600; color: #2d2d2d; margin-bottom: 2px;"><%= order.title %></div>
                                                <div style="font-size: 12px; color: #6b7280;">First Edition Hardcover</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><%= order.customer %></td>
                                    <td>₹<%= order.price %></td>
                                    <td>Oct 26, 2023</td>
                                    <td>
                                        <span class="status-badge status-pending">Pending Approval</span>
                                    </td>
                                </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const ctx = document.getElementById('revenueChart').getContext('2d');
        let salesChart;

        function initChart(labels, data) {
            salesChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        backgroundColor: '#8b6f47',
                        borderRadius: 4,
                        borderSkipped: false,
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: '#e5e7eb'
                            },
                            ticks: {
                                color: '#6b7280'
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                color: '#6b7280'
                            }
                        }
                    }
                }
            });
        }

        async function updateChart(filter) {
            try {
                const response = await fetch(`/admin/dashboard/chart-data?filter=${filter}`);
                const resData = await response.json();
                if (resData.success) {
                    if (salesChart) {
                        salesChart.data.labels = resData.labels;
                        salesChart.data.datasets[0].data = resData.data;
                        salesChart.update();
                    } else {
                        initChart(resData.labels, resData.data);
                    }
                }
            } catch (err) {
                console.error("Failed to load chart data", err);
            }
        }

        const filterSelect = document.getElementById('chartFilter');
        updateChart(filterSelect.value);

        filterSelect.addEventListener('change', (e) => {
            updateChart(e.target.value);
        });
    </script>
</body>
</html>