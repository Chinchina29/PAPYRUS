<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book Details & Verification - Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #f8f6f3;
            color: #2d2d2d;
            line-height: 1.5;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        .main-content {
            margin-left: 240px;
            flex: 1;
            padding: 32px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .header-left h1 {
            font-size: 28px;
            font-weight: 600;
            color: #2d2d2d;
            margin-bottom: 4px;
        }

        .header-subtitle {
            color: #6b7280;
            font-size: 14px;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .search-box {
            position: relative;
        }

        .search-box input {
            width: 320px;
            padding: 10px 16px 10px 40px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            background: white;
        }

        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: #9ca3af;
        }

        .admin-profile {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .admin-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #e5e7eb;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 32px;
            margin-bottom: 32px;
        }

        .verification-section {
            background: white;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #e5e7eb;
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #2d2d2d;
            margin-bottom: 20px;
        }

        .video-player {
            width: 100%;
            height: 300px;
            background: #000;
            border-radius: 8px;
            position: relative;
            margin-bottom: 16px;
            overflow: hidden;
        }

        .video-player video {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .play-button {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 60px;
            height: 60px;
            background: rgba(255,255,255,0.9);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .play-button:hover {
            background: white;
            transform: translate(-50%, -50%) scale(1.1);
        }

        .condition-badge {
            position: absolute;
            bottom: 16px;
            left: 16px;
            background: rgba(0,0,0,0.8);
            color: white;
            padding: 6px 12px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .thumbnails {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .thumbnail {
            aspect-ratio: 1;
            border-radius: 8px;
            overflow: hidden;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.2s;
        }

        .thumbnail:hover {
            border-color: #3b82f6;
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .thumbnail-hint {
            text-align: center;
            color: #6b7280;
            font-size: 12px;
            margin-top: 12px;
            font-style: italic;
        }

        .listing-info {
            background: white;
            border-radius: 12px;
            padding: 24px;
            border: 1px solid #e5e7eb;
            position: relative;
        }

        .status-badge {
            position: absolute;
            top: 24px;
            right: 24px;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .status-pending {
            background: #fef3c7;
            color: #92400e;
        }

        .status-approved {
            background: #d1fae5;
            color: #065f46;
        }

        .status-rejected {
            background: #fee2e2;
            color: #991b1b;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 24px;
        }

        .info-item {
            margin-bottom: 16px;
        }

        .info-label {
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .info-value {
            font-size: 14px;
            color: #2d2d2d;
            font-weight: 500;
        }

        .description-section {
            margin: 24px 0;
            padding-top: 24px;
            border-top: 1px solid #f3f4f6;
        }

        .description-text {
            background: #f9fafb;
            padding: 16px;
            border-radius: 8px;
            font-size: 14px;
            line-height: 1.6;
            color: #4b5563;
        }

        .seller-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e5e7eb;
            margin-bottom: 24px;
        }

        .seller-header {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .seller-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            color: #6b7280;
        }

        .seller-info h4 {
            font-size: 14px;
            font-weight: 600;
            color: #2d2d2d;
            margin-bottom: 2px;
        }

        .seller-rating {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            color: #f59e0b;
        }

        .seller-stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .stat-item {
            text-align: center;
        }

        .stat-value {
            font-size: 16px;
            font-weight: 600;
            color: #2d2d2d;
        }

        .stat-label {
            font-size: 11px;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .pricing-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e5e7eb;
            margin-bottom: 24px;
        }

        .price-display {
            font-size: 24px;
            font-weight: 700;
            color: #2d2d2d;
            margin-bottom: 8px;
        }

        .negotiable-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            background: #ecfdf5;
            color: #059669;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: 500;
        }

        .action-buttons {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-approve {
            background: #059669;
            color: white;
        }

        .btn-approve:hover {
            background: #047857;
        }

        .btn-reject {
            background: #dc2626;
            color: white;
        }

        .btn-reject:hover {
            background: #b91c1c;
        }

        .notes-section {
            background: white;
            border-radius: 12px;
            padding: 20px;
            border: 1px solid #e5e7eb;
        }

        .notes-header {
            font-size: 11px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 12px;
        }

        .notes-textarea {
            width: 100%;
            min-height: 80px;
            padding: 12px;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: 14px;
            font-family: inherit;
            resize: vertical;
            background: #f9fafb;
        }

        .notes-textarea::placeholder {
            color: #9ca3af;
            font-style: italic;
        }

        .footer {
            margin-top: 48px;
            padding-top: 24px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            color: #6b7280;
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            justify-content: center;
            gap: 24px;
            margin-top: 8px;
        }

        .footer-links a {
            color: #6b7280;
            text-decoration: none;
        }

        .footer-links a:hover {
            color: #2d2d2d;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include('../../partials/admin-sidebar', { currentPage_name: 'submissions' }) %>

        <div class="main-content">
            <div class="header">
                <div class="header-left">
                    <h1>Book Details & Verification</h1>
                    <p class="header-subtitle">Review authenticity and condition for: <em><%= submission.title %></em></p>
                </div>
                <div class="header-right">
                    <div class="search-box">
                        <svg class="search-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                        <input type="text" placeholder="Search sellers, titles, or ISBN...">
                    </div>
                    <div class="admin-profile">
                        <span style="font-size: 12px; color: #6b7280;">Admin Panel</span>
                        <div class="admin-avatar"></div>
                        <span style="font-size: 12px; color: #059669;">Online</span>
                    </div>
                </div>
            </div>

            <div class="content-grid">
                <div class="verification-section">
                    <h3 class="section-title">Verification Media</h3>
                    
                    <div class="video-player">
                        <% if (submission.videos && submission.videos.length > 0) { %>
                            <video id="mainVideo" controls>
                                <source src="<%= submission.videos[0].url %>" type="video/mp4">
                                Your browser does not support the video tag.
                            </video>
                        <% } else { %>
                            <div style="display: flex; align-items: center; justify-content: center; height: 100%; color: #6b7280;">
                                <div style="text-align: center;">
                                    <div style="font-size: 48px; margin-bottom: 12px;">📹</div>
                                    <div>No verification video provided</div>
                                </div>
                            </div>
                        <% } %>
                        
                        <div class="condition-badge">
                            CONDITION: <%= submission.condition.toUpperCase() %> VERIFICATION
                        </div>
                    </div>

                    <div class="thumbnails">
                        <% submission.images.slice(0, 4).forEach((image, index) => { %>
                            <div class="thumbnail" onclick="enlargeImage('<%= typeof image === 'string' ? image : image.url %>')">
                                <img src="<%= typeof image === 'string' ? image : image.url %>" alt="Book image <%= index + 1 %>">
                            </div>
                        <% }) %>
                    </div>
                    
                    <div class="thumbnail-hint">
                        Click images to enlarge and inspect quality
                    </div>
                </div>

                <div class="listing-info">
                    <div class="status-badge status-<%= submission.status %>">
                        <%= submission.status.replace('-', ' ') %>
                    </div>

                    <h3 class="section-title" style="margin-top: 0;">Listing Information</h3>

                    <div class="info-grid">
                        <div>
                            <div class="info-item">
                                <div class="info-label">Book Title</div>
                                <div class="info-value"><%= submission.title %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Edition</div>
                                <div class="info-value">First Edition Hardcover</div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">ISBN</div>
                                <div class="info-value"><%= submission.isbn || 'Not provided' %></div>
                            </div>
                        </div>
                        <div>
                            <div class="info-item">
                                <div class="info-label">Author</div>
                                <div class="info-value"><%= submission.author || 'Not specified' %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Publisher</div>
                                <div class="info-value"><%= submission.publisher || 'Not specified' %></div>
                            </div>
                            <div class="info-item">
                                <div class="info-label">Category</div>
                                <div class="info-value"><%= submission.category.name %></div>
                            </div>
                        </div>
                    </div>

                    <div class="description-section">
                        <div class="info-label">Description</div>
                        <div class="description-text">
                            <%= submission.description || 'No description provided by the seller.' %>
                        </div>
                    </div>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 400px; gap: 32px;">
                <div class="seller-section">
                    <div class="info-label">Seller Profile</div>
                    <div class="seller-header">
                        <div class="seller-avatar">
                            <%= submission.submittedBy.firstName ? submission.submittedBy.firstName.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div class="seller-info">
                            <h4><%= submission.submittedBy.firstName %> <%= submission.submittedBy.lastName %></h4>
                            <div class="seller-rating">
                                ⭐ 4.9
                            </div>
                        </div>
                    </div>
                    <div class="seller-stats">
                        <div class="stat-item">
                            <div class="stat-label">Total Sales</div>
                            <div class="stat-value">142 Books</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Member Since</div>
                            <div class="stat-value">Nov 2022</div>
                        </div>
                    </div>
                </div>

                <div>
                    <div class="pricing-section">
                        <div class="info-label">Pricing & Negotiation</div>
                        <div class="price-display">₹<%= submission.price.toLocaleString() %></div>
                        <div class="negotiable-badge">
                            ✓ Negotiable
                        </div>

                        <% if (submission.status === 'pending') { %>
                        <div class="action-buttons">
                            <button class="btn btn-approve" onclick="reviewSubmission('approved')">
                                ✓ Approve Listing
                            </button>
                            <button class="btn btn-reject" onclick="reviewSubmission('rejected')">
                                ✕ Reject Listing
                            </button>
                        </div>
                        <% } %>
                    </div>

                    <div class="notes-section">
                        <div class="notes-header">Internal Curator Notes</div>
                        <textarea class="notes-textarea" placeholder="Add a note about this listing for other curators..." id="curatorNotes"><%= submission.reviewNotes || submission.rejectionReason || '' %></textarea>
                    </div>
                </div>
            </div>

            <div class="footer">
                <div>© 2024 Papyrus Marketplace. Admin Portal v2.4.0</div>
                <div class="footer-links">
                    <a href="#">Privacy Policy</a>
                    <a href="#">Curator Guidelines</a>
                    <a href="#">Terms of Service</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        function enlargeImage(src) {
            Swal.fire({
                imageUrl: src,
                imageAlt: 'Book image',
                showConfirmButton: false,
                showCloseButton: true,
                width: 'auto',
                padding: '1rem',
                background: 'white',
                backdrop: 'rgba(0,0,0,0.8)'
            });
        }

        async function reviewSubmission(action) {
            let adminNote = document.getElementById('curatorNotes').value.trim();
            
            if (action === 'rejected') {
                const result = await Swal.fire({
                    title: 'Reject Listing',
                    html: `
                        <div style="text-align: left; margin: 20px 0;">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500;">Reason for rejection:</label>
                            <textarea id="rejectionReason" style="width: 100%; height: 100px; padding: 12px; border: 1px solid #d1d5db; border-radius: 8px; font-family: inherit;" placeholder="e.g. Images are blurry, condition mismatch, inappropriate content..."></textarea>
                        </div>
                    `,
                    showCancelButton: true,
                    confirmButtonText: 'Reject Listing',
                    confirmButtonColor: '#dc2626',
                    cancelButtonText: 'Cancel',
                    preConfirm: () => {
                        const reason = document.getElementById('rejectionReason').value.trim();
                        if (!reason) {
                            Swal.showValidationMessage('Please provide a reason for rejection');
                            return false;
                        }
                        return reason;
                    }
                });
                
                if (!result.isConfirmed) return;
                adminNote = result.value;
            } else {
                const result = await Swal.fire({
                    title: 'Approve Listing',
                    text: 'This will add the book to your marketplace inventory and notify the seller.',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Approve Listing',
                    confirmButtonColor: '#059669',
                    cancelButtonText: 'Cancel'
                });
                
                if (!result.isConfirmed) return;
            }

            try {
                const response = await fetch(`/admin/submissions/<%= submission._id %>/review`, {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ action, adminNote })
                });

                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(`HTTP ${response.status}: ${errorText}`);
                }

                const data = await response.json();
                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: action === 'approved' ? 'Listing Approved!' : 'Listing Rejected',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    window.location.reload();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: data.message || 'Unknown error occurred'
                    });
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: 'Something went wrong: ' + error.message
                });
            }
        }

        let saveTimeout;
        document.getElementById('curatorNotes').addEventListener('input', function() {
            clearTimeout(saveTimeout);
            saveTimeout = setTimeout(() => {
                }, 2000);
        });
    </script>
</body>
</html>