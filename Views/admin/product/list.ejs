<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Product Management - Papyrus Admin</title>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: 'Segoe UI', sans-serif; background: #faf8f5; color: #3a3a3a; display: flex; min-height: 100vh; }
    .main-content { margin-left: 280px; flex: 1; padding: 32px; min-height: 100vh; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; flex-wrap: wrap; gap: 16px; }
    .page-title h1 { font-size: 24px; font-weight: 600; }
    .page-title p { font-size: 13px; color: #8b7355; margin-top: 4px; }
    .btn-add { display: flex; align-items: center; gap: 8px; padding: 10px 20px; background: #8b7355; color: white; border: none; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; text-decoration: none; transition: background 0.2s; }
    .btn-add:hover { background: #5a4a3a; }
    .search-bar { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    .search-wrap { position: relative; flex: 1; max-width: 400px; }
    .search-wrap input { width: 100%; padding: 10px 40px 10px 16px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 14px; background: white; outline: none; }
    .search-wrap input:focus { border-color: #8b7355; }
    .search-clear { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; color: #8b7355; font-size: 16px; }
    .btn-search { padding: 10px 20px; background: #8b7355; color: white; border: none; border-radius: 8px; font-size: 14px; cursor: pointer; }
    .btn-search:hover { background: #5a4a3a; }
    .table-card { background: white; border-radius: 12px; border: 1px solid #e8dcc8; overflow: hidden; }
    .table-info { padding: 16px 20px; border-bottom: 1px solid #e8dcc8; font-size: 13px; color: #8b7355; }
    table { width: 100%; border-collapse: collapse; }
    thead { background: #f5f1ed; }
    th { padding: 14px 16px; text-align: left; font-size: 12px; font-weight: 600; color: #5a4d42; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid #e8dcc8; }
    td { padding: 14px 16px; font-size: 14px; border-bottom: 1px solid #f0ebe3; vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #faf8f5; }
    .product-info { display: flex; align-items: center; gap: 12px; }
    .product-img { width: 50px; height: 60px; border-radius: 6px; overflow: hidden; background: #f5f1ed; display: flex; align-items: center; justify-content: center; }
    .product-img img { width: 100%; height: 100%; object-fit: cover; }
    .product-details h4 { font-size: 14px; font-weight: 600; color: #2d1f14; margin-bottom: 2px; }
    .product-details p { font-size: 12px; color: #8b7355; }
    .badge { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: 20px; font-size: 12px; font-weight: 500; }
    .badge-listed { background: #e8f5e9; color: #2e7d32; }
    .badge-unlisted { background: #fff3e0; color: #e65100; }
    .badge-new { background: #e3f2fd; color: #1976d2; }
    .badge-good { background: #fff3e0; color: #f57c00; }
    .badge-like-new { background: #e8f5e9; color: #2e7d32; }
    .badge-fair { background: #fce4ec; color: #c2185b; }
    .badge-poor { background: #ffebee; color: #d32f2f; }
    .badge-deleted { background: #f5f5f5; color: #757575; border: 1px dashed #bdbdbd; }
    .actions { display: flex; gap: 8px; align-items: center; }
    .btn-icon { width: 34px; height: 34px; border-radius: 8px; border: 1px solid #e8dcc8; background: white; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; text-decoration: none; }
    .btn-icon svg { width: 16px; height: 16px; }
    .btn-icon.edit { color: #8b7355; }
    .btn-icon.delete { color: #c0392b; }
    .btn-icon.delete:hover { background: #fdf0ef; border-color: #f5c6c2; }
    .btn-icon.edit:hover { background: #f5f1ed; }
    .toggle-switch { position: relative; width: 42px; height: 22px; cursor: pointer; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider { position: absolute; inset: 0; background: #ccc; border-radius: 22px; transition: 0.3s; }
    .toggle-slider::before { content: ""; position: absolute; width: 16px; height: 16px; left: 3px; bottom: 3px; background: white; border-radius: 50%; transition: 0.3s; }
    .toggle-switch input:checked + .toggle-slider { background: #8b7355; }
    .toggle-switch input:checked + .toggle-slider::before { transform: translateX(20px); }
    .pagination { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-top: 1px solid #e8dcc8; flex-wrap: wrap; gap: 12px; }
    .pagination-info { font-size: 13px; color: #8b7355; }
    .pagination-btns { display: flex; gap: 6px; }
    .page-btn { width: 34px; height: 34px; border: 1px solid #e8dcc8; background: white; border-radius: 8px; font-size: 13px; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #5a4d42; text-decoration: none; transition: all 0.2s; }
    .page-btn:hover { background: #f5f1ed; }
    .page-btn.active { background: #8b7355; color: white; border-color: #8b7355; }
    .page-btn.disabled { opacity: 0.4; pointer-events: none; }
    .empty-state { text-align: center; padding: 60px 20px; color: #8b7355; }
    .empty-state svg { width: 48px; height: 48px; margin-bottom: 16px; opacity: 0.4; }
    .breadcrumb { display: flex; align-items: center; gap: 8px; margin-bottom: 20px; font-size: 14px; }
    .breadcrumb a { color: #8b7355; text-decoration: none; transition: color 0.2s; }
    .breadcrumb a:hover { color: #5a4a3a; text-decoration: underline; cursor: pointer; }
    .breadcrumb span { color: #c8b89a; }
  </style>
</head>
<body>
  <%- include('../../partials/admin-sidebar') %>

  <div class="main-content">
    <div class="breadcrumb">
      <a href="/admin/dashboard">DASHBOARD</a>
      <span>/</span>
      <span style="color: #2d1f14;">PRODUCTS</span>
    </div>

    <div class="page-header">
      <div class="page-title">
        <h1>Product Management</h1>
        <p>Manage your book inventory — <%= total %> total<% if (showDeleted) { %> (including deleted)<% } %></p>
      </div>
      <a href="/admin/products/add" class="btn-add">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Add Product
      </a>
    </div>

    <form method="GET" action="/admin/products" id="searchForm">
      <div class="search-bar">
        <div class="search-wrap">
          <input type="text" name="search" id="searchInput" placeholder="Search products..." value="<%= search %>"/>
          <button type="button" class="search-clear" id="clearBtn">✕</button>
        </div>
        <select name="sort" onchange="this.form.submit()" style="padding: 10px 16px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 14px; background: white; outline: none; cursor: pointer; color: #5a4d42;">
          <option value="">Sort By</option>
          <option value="date-desc" <%= sort === 'date-desc' ? 'selected' : '' %>>Date: Newest First</option>
          <option value="date-asc" <%= sort === 'date-asc' ? 'selected' : '' %>>Date: Oldest First</option>
          <option value="price-asc" <%= sort === 'price-asc' ? 'selected' : '' %>>Price: Low to High</option>
          <option value="price-desc" <%= sort === 'price-desc' ? 'selected' : '' %>>Price: High to Low</option>
          <option value="title-asc" <%= sort === 'title-asc' ? 'selected' : '' %>>Title: A to Z</option>
          <option value="title-desc" <%= sort === 'title-desc' ? 'selected' : '' %>>Title: Z to A</option>
          <option value="stock-asc" <%= sort === 'stock-asc' ? 'selected' : '' %>>Stock: Low to High</option>
          <option value="stock-desc" <%= sort === 'stock-desc' ? 'selected' : '' %>>Stock: High to Low</option>
        </select>
        <button type="submit" class="btn-search">Search</button>
        <label style="display: flex; align-items: center; gap: 8px; margin-left: 12px; cursor: pointer; font-size: 14px; color: #5a4d42;">
          <input type="checkbox" name="showDeleted" value="true" <%= showDeleted ? 'checked' : '' %> onchange="this.form.submit()" style="width: 16px; height: 16px; cursor: pointer;"/>
          Show Deleted
        </label>
      </div>

      <%# Filter row %>
      <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 16px; align-items: center;">
        <select name="category" onchange="this.form.submit()" style="padding: 9px 14px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; cursor: pointer; outline: none;">
          <option value="">All Categories</option>
          <% if (typeof categories !== 'undefined') { categories.forEach(cat => { %>
            <option value="<%= cat._id %>" <%= category === cat._id.toString() ? 'selected' : '' %>><%= cat.name %></option>
          <% }) } %>
        </select>

        <select name="condition" onchange="this.form.submit()" style="padding: 9px 14px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; cursor: pointer; outline: none;">
          <option value="">All Conditions</option>
          <option value="new" <%= condition === 'new' ? 'selected' : '' %>>New</option>
          <option value="like-new" <%= condition === 'like-new' ? 'selected' : '' %>>Like New</option>
          <option value="good" <%= condition === 'good' ? 'selected' : '' %>>Good</option>
          <option value="fair" <%= condition === 'fair' ? 'selected' : '' %>>Fair</option>
          <option value="poor" <%= condition === 'poor' ? 'selected' : '' %>>Poor</option>
        </select>

        <select name="status" onchange="this.form.submit()" style="padding: 9px 14px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; cursor: pointer; outline: none;">
          <option value="">All Statuses</option>
          <option value="listed" <%= status === 'listed' ? 'selected' : '' %>>Listed</option>
          <option value="unlisted" <%= status === 'unlisted' ? 'selected' : '' %>>Unlisted</option>
        </select>

        <select name="stock" onchange="this.form.submit()" style="padding: 9px 14px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; cursor: pointer; outline: none;">
          <option value="">All Stock</option>
          <option value="in-stock" <%= stock === 'in-stock' ? 'selected' : '' %>>In Stock</option>
          <option value="out-of-stock" <%= stock === 'out-of-stock' ? 'selected' : '' %>>Out of Stock</option>
          <option value="low-stock" <%= stock === 'low-stock' ? 'selected' : '' %>>Low Stock (≤5)</option>
        </select>

        <input type="number" name="minPrice" placeholder="Min Price" value="<%= minPrice %>" min="0"
          style="width: 110px; padding: 9px 12px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; outline: none;"
          onblur="this.form.submit()"/>

        <input type="number" name="maxPrice" placeholder="Max Price" value="<%= maxPrice %>" min="0"
          style="width: 110px; padding: 9px 12px; border: 1.5px solid #e8dcc8; border-radius: 8px; font-size: 13px; background: white; color: #5a4d42; outline: none;"
          onblur="this.form.submit()"/>

        <% const hasFilters = category || condition || status || stock || minPrice || maxPrice || search || sort; %>
        <% if (hasFilters) { %>
          <a href="/admin/products<%= showDeleted ? '?showDeleted=true' : '' %>" style="padding: 9px 14px; background: #fee2e2; color: #c0392b; border-radius: 8px; font-size: 13px; font-weight: 500; text-decoration: none; border: 1px solid #fca5a5;">✕ Clear Filters</a>
        <% } %>
      </div>
    </form>

    <div class="table-card">
      <div class="table-info">
        Showing <%= products.length %> of <%= total %> products<% if (showDeleted) { %> (including deleted)<% } %>
        <% if (search) { %> — Results for "<strong><%= search %></strong>"<% } %>
      </div>

      <% if (products.length === 0) { %>
        <div class="empty-state">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <p>No products found<% if (search) { %> for "<%= search %>"<% } %></p>
        </div>
      <% } else { %>
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Product</th>
              <th>Category</th>
              <th>Price</th>
              <th>Stock</th>
              <th>Condition</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% products.forEach((product, index) => { %>
            <tr data-id="<%= product._id %>">
              <td><%= (currentPage - 1) * 10 + index + 1 %></td>
              <td>
                <div class="product-info">
                  <div class="product-img">
                    <% if (product.images && product.images.length > 0) { %>
                      <img src="<%= product.images[0].url %>" alt="<%= product.title %>"/>
                    <% } else { %>
                      📚
                    <% } %>
                  </div>
                  <div class="product-details">
                    <h4><%= product.title %></h4>
                    <% if (product.author) { %>
                      <p>by <%= product.author %></p>
                    <% } %>
                  </div>
                </div>
              </td>
              <td><%= product.category?.name || 'Uncategorized' %></td>
              <td>₹<%= product.price %></td>
              <td><%= product.stock %></td>
              <td>
                <span class="badge badge-<%= product.condition %>">
                  <%= product.condition.replace('-', ' ') %>
                </span>
              </td>
              <td>
                <span class="badge <%= product.isListed ? 'badge-listed' : 'badge-unlisted' %>">
                  <%= product.isListed ? '● Listed' : '● Unlisted' %>
                </span>
                <% if (product.isDeleted) { %>
                  <span class="badge badge-deleted" style="margin-left: 4px;">🗑 Deleted</span>
                <% } %>
              </td>
              <td>
                <div class="actions">
                  <% if (!product.isDeleted) { %>
                    <label class="toggle-switch" title="Toggle listing">
                      <input type="checkbox" <%= product.isListed ? 'checked' : '' %>
                        onchange="toggleProduct('<%= product._id %>', this)"/>
                      <span class="toggle-slider"></span>
                    </label>
                    <a href="/admin/products/edit/<%= product._id %>" class="btn-icon edit" title="Edit">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                    </a>
                    <button class="btn-icon delete" title="Delete" onclick="deleteProduct('<%= product._id %>', '<%= product.title %>')">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg>
                    </button>
                  <% } else { %>
                    <span style="font-size: 12px; color: #9a8a78; font-style: italic;">
                      Deleted on <%= new Date(product.updatedAt).toLocaleDateString('en-IN', {day: 'numeric', month: 'short', year: 'numeric'}) %>
                    </span>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>

        <% if (totalPages > 1) { %>
        <div class="pagination">
          <div class="pagination-info">Page <%= currentPage %> of <%= totalPages %></div>
          <div class="pagination-btns">
            <a href="?page=<%= currentPage-1 %>&search=<%= encodeURIComponent(search) %>&showDeleted=<%= showDeleted %>&sort=<%= sort %>&category=<%= category %>&condition=<%= condition %>&status=<%= status %>&stock=<%= stock %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" class="page-btn <%= currentPage === 1 ? 'disabled' : '' %>">‹</a>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="?page=<%= i %>&search=<%= encodeURIComponent(search) %>&showDeleted=<%= showDeleted %>&sort=<%= sort %>&category=<%= category %>&condition=<%= condition %>&status=<%= status %>&stock=<%= stock %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <a href="?page=<%= currentPage+1 %>&search=<%= encodeURIComponent(search) %>&showDeleted=<%= showDeleted %>&sort=<%= sort %>&category=<%= category %>&condition=<%= condition %>&status=<%= status %>&stock=<%= stock %>&minPrice=<%= minPrice %>&maxPrice=<%= maxPrice %>" class="page-btn <%= currentPage === totalPages ? 'disabled' : '' %>">›</a>
          </div>
        </div>
        <% } %>
      <% } %>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('searchInput');
    const clearBtn = document.getElementById('clearBtn');
    clearBtn.style.display = searchInput.value ? 'block' : 'none';
    searchInput.addEventListener('input', function() { clearBtn.style.display = this.value ? 'block' : 'none'; });
    clearBtn.addEventListener('click', function() {
      searchInput.value = '';
      clearBtn.style.display = 'none';
      document.getElementById('searchForm').submit();
    });

    async function toggleProduct(id, checkbox) {
      const isCurrentlyListed = checkbox.checked;
      const action = isCurrentlyListed ? 'list' : 'unlist';
      const actionText = isCurrentlyListed ? 'List' : 'Unlist';
      
      const result = await Swal.fire({
        title: `${actionText} this product?`,
        text: isCurrentlyListed 
          ? 'This product will be visible to customers in the store.' 
          : 'This product will be hidden from customers.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#8b7355',
        cancelButtonColor: '#6b7280',
        confirmButtonText: `Yes, ${action} it`,
        cancelButtonText: 'Cancel'
      });

      if (!result.isConfirmed) {
        checkbox.checked = !checkbox.checked;
        return;
      }

      try {
        const res = await fetch(`/admin/products/toggle/${id}`, { method: 'PATCH', headers: { 'Content-Type': 'application/json' } });
        const data = await res.json();
        if (data.success) {
          const row = checkbox.closest('tr');
          const badge = row.querySelector('.badge-listed, .badge-unlisted');
          badge.className = `badge ${data.isListed ? 'badge-listed' : 'badge-unlisted'}`;
          badge.textContent = data.isListed ? '● Listed' : '● Unlisted';
          Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: data.message, showConfirmButton: false, timer: 2000 });
        } else {
          checkbox.checked = !checkbox.checked;
          Swal.fire('Error', data.message, 'error');
        }
      } catch(err) { checkbox.checked = !checkbox.checked; Swal.fire('Error', 'Failed to toggle product listing. Please check your connection and try again.', 'error'); }
    }

    async function deleteProduct(id, title) {
      const result = await Swal.fire({ title: `Delete "${title}"?`, text: 'This product will be removed from the store.', icon: 'warning', showCancelButton: true, confirmButtonColor: '#c0392b', cancelButtonColor: '#8b7355', confirmButtonText: 'Yes, delete it' });
      if (!result.isConfirmed) return;
      try {
        const res = await fetch(`/admin/products/delete/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          document.querySelector(`tr[data-id="${id}"]`).remove();
          Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Product deleted', showConfirmButton: false, timer: 2000 });
        } else { Swal.fire('Error', data.message, 'error'); }
      } catch(err) { Swal.fire('Error', 'Failed to delete product. Please check your connection and try again.', 'error'); }
    }
  </script>
</body>
</html>