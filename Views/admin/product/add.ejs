<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Add Product - Papyrus Admin</title>
  <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', sans-serif;
      background: #faf8f5; color: #3a3a3a;
      display: flex; min-height: 100vh;
    }
    .main-content { margin-left: 280px; flex: 1; padding: 32px; }
    .page-header {
      display: flex; align-items: center; gap: 16px; margin-bottom: 28px;
    }
    .btn-back {
      width: 36px; height: 36px; border: 1px solid #e8dcc8;
      border-radius: 8px; background: white;
      display: flex; align-items: center; justify-content: center;
      color: #8b7355; text-decoration: none;
    }
    .btn-back:hover { background: #f5f1ed; }
    .page-title h1 { font-size: 22px; font-weight: 600; }
    .page-title p  { font-size: 13px; color: #8b7355; margin-top: 3px; }

    .form-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }

    .form-card {
      background: white; border-radius: 12px;
      border: 1px solid #e8dcc8; padding: 28px;
    }

    .form-card.full { grid-column: 1 / -1; }

    .card-title {
      font-size: 15px; font-weight: 600;
      margin-bottom: 20px; padding-bottom: 12px;
      border-bottom: 1px solid #e8dcc8; color: #3a3a3a;
    }

    .form-group { margin-bottom: 18px; position: relative; }
    .form-group label {
      display: block; font-size: 13px; font-weight: 500;
      color: #3a3a3a; margin-bottom: 7px;
    }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%; padding: 10px 14px;
      border: 1.5px solid #e8dcc8; border-radius: 8px;
      font-size: 14px; font-family: inherit;
      background: #faf8f5; outline: none;
      transition: border-color 0.2s; resize: vertical;
    }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: #8b7355;
      box-shadow: 0 0 0 3px rgba(139,115,85,0.10);
      background: white;
    }
    .form-group input.error,
    .form-group select.error,
    .form-group textarea.error {
      border-color: #c0392b;
    }
    .form-group .error-message {
      display: none;
      color: #c0392b;
      font-size: 12px;
      margin-top: 4px;
    }
    .form-group .error-message.show {
      display: block;
    }

    .form-row {
      display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    }
    .image-upload-area {
      border: 2px dashed #e8dcc8; border-radius: 12px;
      padding: 24px; text-align: center; cursor: pointer;
      transition: border-color 0.2s; background: #faf8f5;
    }
    .image-upload-area:hover { border-color: #8b7355; }
    .image-upload-area svg { width: 40px; height: 40px; color: #8b7355; margin-bottom: 12px; }
    .image-upload-area p { font-size: 14px; color: #8b7355; }
    .image-upload-area span { font-size: 12px; color: #aaa; display: block; margin-top: 4px; }
    .image-previews {
      display: flex; flex-wrap: wrap; gap: 12px; margin-top: 16px;
    }

    .image-preview-item {
      position: relative; width: 100px; height: 100px;
    }

    .image-preview-item img {
      width: 100%; height: 100%; object-fit: cover;
      border-radius: 8px; border: 1px solid #e8dcc8;
    }

    .image-preview-item .remove-img {
      position: absolute; top: -6px; right: -6px;
      width: 22px; height: 22px; border-radius: 50%;
      background: #c0392b; color: white;
      border: none; cursor: pointer; font-size: 12px;
      display: flex; align-items: center; justify-content: center;
    }

    .img-count {
      font-size: 12px; color: #8b7355; margin-top: 8px;
    }

    .img-count.error { color: #c0392b; }
    .img-count.success { color: #2e7d32; }
    .cropper-modal-overlay {
      display: none; position: fixed; inset: 0;
      background: rgba(0,0,0,0.7); z-index: 9999;
      align-items: center; justify-content: center;
    }
    .cropper-modal-overlay.show { display: flex; }

    .cropper-modal {
      background: white; border-radius: 16px;
      padding: 24px; width: 90%; max-width: 600px;
    }
    .cropper-modal h3 {
      font-size: 16px; font-weight: 600;
      margin-bottom: 16px; color: #3a3a3a;
    }
    .cropper-container-wrap {
      width: 100%; height: 350px;
      background: #f5f1ed; border-radius: 8px; overflow: hidden;
    }
    .cropper-container-wrap img { max-width: 100%; }

    .cropper-actions {
      display: flex; gap: 12px; margin-top: 16px; justify-content: flex-end;
    }
    .btn-crop {
      padding: 10px 24px; background: #8b7355; color: white;
      border: none; border-radius: 8px; font-size: 14px;
      cursor: pointer; font-weight: 500;
    }
    .btn-crop:hover { background: #5a4a3a; }
    .btn-crop-cancel {
      padding: 10px 24px; background: white; color: #5a4d42;
      border: 1px solid #e8dcc8; border-radius: 8px;
      font-size: 14px; cursor: pointer;
    }

    .alert {
      padding: 12px 16px; border-radius: 8px;
      font-size: 13.5px; margin-bottom: 20px; display: none;
    }
    .alert-danger  { background: #fdf0ef; color: #c0392b; border: 1px solid #f5c6c2; }
    .alert-success { background: #edfaf3; color: #1e7e4a; border: 1px solid #b7eacf; }

    .form-actions { display: flex; gap: 12px; margin-top: 24px; }
    .btn-submit {
      padding: 11px 28px; background: #8b7355; color: white;
      border: none; border-radius: 8px; font-size: 14px;
      font-weight: 500; cursor: pointer;
    }
    .btn-submit:hover:not(:disabled) { background: #5a4a3a; }
    .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; }
    .btn-cancel {
      padding: 11px 28px; background: white; color: #5a4d42;
      border: 1px solid #e8dcc8; border-radius: 8px;
      font-size: 14px; cursor: pointer; text-decoration: none;
      display: flex; align-items: center;
    }
    .btn-cancel:hover { background: #f5f1ed; }

    .required { color: #c0392b; }
  </style>
</head>
<body>

  <%- include('../../partials/admin-sidebar') %>

  <div class="main-content">
    <div class="page-header">
      <a href="/admin/products" class="btn-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </a>
      <div class="page-title">
        <h1>Add Product</h1>
        <p>Add a new book to your store</p>
      </div>
    </div>

    <div id="errorMsg"   class="alert alert-danger"></div>
    <div id="successMsg" class="alert alert-success"></div>

    <form id="addProductForm" novalidate>
      <div class="form-grid">
        <div class="form-card">
          <div class="card-title">📖 Basic Information</div>

          <div class="form-group">
            <label>Book Title <span class="required">*</span></label>
            <input type="text" id="name" name="name"
              placeholder="e.g. The Great Gatsby"/>
            <div class="error-message" id="nameError">Book title is required</div>
          </div>

          <div class="form-group">
            <label>Author</label>
            <input type="text" id="author" name="author"
              placeholder="e.g. F. Scott Fitzgerald"/>
          </div>

          <div class="form-group">
            <label>Category <span class="required">*</span></label>
            <select id="category" name="category">
              <option value="">Select category</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat._id %>"><%= cat.name %></option>
              <% }) %>
            </select>
            <div class="error-message" id="categoryError">Please select a category</div>
          </div>

          <div class="form-group">
            <label>Condition <span class="required">*</span></label>
            <select id="condition" name="condition">
              <option value="">Select condition</option>
              <option value="new">New</option>
              <option value="like-new">Like New</option>
              <option value="good">Good</option>
              <option value="fair">Fair</option>
              <option value="poor">Poor</option>
            </select>
            <div class="error-message" id="conditionError">Please select a condition</div>
          </div>

          <div class="form-group">
            <label>Description</label>
            <textarea id="description" name="description"
              rows="4" placeholder="Brief description of the book..."></textarea>
          </div>
        </div>
        <div class="form-card">
          <div class="card-title">💰 Pricing & Stock</div>

          <div class="form-row">
            <div class="form-group">
              <label>Selling Price (₹) <span class="required">*</span></label>
              <input type="number" id="price" name="price"
                placeholder="299" min="0"/>
              <div class="error-message" id="priceError">Price is required</div>
            </div>
            <div class="form-group">
              <label>Original Price (₹)</label>
              <input type="number" id="originalPrice" name="originalPrice"
                placeholder="399" min="0"/>
            </div>
          </div>

          <div class="form-group">
            <label>Stock Quantity <span class="required">*</span></label>
            <input type="number" id="stock" name="stock"
              placeholder="10" min="0"/>
            <div class="error-message" id="stockError">Stock quantity is required</div>
          </div>

          <div class="card-title" style="margin-top:20px">📚 Book Details</div>

          <div class="form-group">
            <label>ISBN</label>
            <input type="text" id="isbn" name="isbn"
              placeholder="978-3-16-148410-0"/>
          </div>

          <div class="form-group">
            <label>Publisher</label>
            <input type="text" id="publisher" name="publisher"
              placeholder="e.g. Penguin Books"/>
          </div>
        </div>
        <div class="form-card full">
          <div class="card-title">
            🖼️ Product Images
            <span style="font-weight:400; color:#8b7355; font-size:13px">
              (minimum 3 required)
            </span>
          </div>
          <div class="image-upload-area" id="uploadArea"
            onclick="document.getElementById('imageInput').click()">
            <svg viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="1.5">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="17 8 12 3 7 8"/>
              <line x1="12" y1="3" x2="12" y2="15"/>
            </svg>
            <p>Click to upload images</p>
            <span>JPG, PNG, WEBP — Each image will be cropped before upload</span>
          </div>

          <input type="file" id="imageInput" accept="image/*"
            style="display:none" onchange="handleImageSelect(event)"/>

          <div class="img-count" id="imgCount">0 images selected (minimum 3)</div>

          <div class="image-previews" id="imagePreviews"></div>
        </div>

      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit" id="submitBtn">
          Add Product
        </button>
        <a href="/admin/products" class="btn-cancel">Cancel</a>
      </div>
    </form>
  </div>
  <div class="cropper-modal-overlay" id="cropperModal">
    <div class="cropper-modal">
      <h3>✂️ Crop Image</h3>
      <div class="cropper-container-wrap">
        <img id="cropperImage" src="" alt="Crop"/>
      </div>
      <div class="cropper-actions">
        <button class="btn-crop-cancel" onclick="closeCropper()">Cancel</button>
        <button class="btn-crop" onclick="cropAndSave()">Crop & Save</button>
      </div>
    </div>
  </div>

  <script>
    let croppedImages  = []; 
    let currentCropper = null;

    function handleImageSelect(event) {
      const file = event.target.files[0];
      if (!file) return;
      event.target.value = "";

      const reader = new FileReader();
      reader.onload = (e) => {
        openCropper(e.target.result); 
      };
      reader.readAsDataURL(file);
    }

    function openCropper(imageSrc) {
      const modal     = document.getElementById("cropperModal");
      const cropperImg = document.getElementById("cropperImage");

      cropperImg.src = imageSrc;
      modal.classList.add("show");
      if (currentCropper) {
        currentCropper.destroy();
      }

      currentCropper = new Cropper(cropperImg, {
        aspectRatio:    1,
        viewMode:       1,
        dragMode:       "move",
        autoCropArea:   0.8,
        restore:        false,
        guides:         true,
        center:         true,
        highlight:      false,
        cropBoxMovable: true,
        cropBoxResizable: true,
        toggleDragModeOnDblclick: false,
      });
    }

    function closeCropper() {
      document.getElementById("cropperModal").classList.remove("show");
      if (currentCropper) {
        currentCropper.destroy();
        currentCropper = null;
      }
    }

    function cropAndSave() {
      if (!currentCropper) return;

      const canvas = currentCropper.getCroppedCanvas({
        width:  800,   
        height: 800,
        fillColor: "#fff",
        imageSmoothingEnabled: true,
        imageSmoothingQuality: "high",
      });

      const base64 = canvas.toDataURL("image/jpeg", 0.85);

      croppedImages.push(base64);

      addImagePreview(base64, croppedImages.length - 1);

      updateImageCount();

      closeCropper();
    }

    function addImagePreview(base64, index) {
      const previews = document.getElementById("imagePreviews");
      const item     = document.createElement("div");
      item.className = "image-preview-item";
      item.setAttribute("data-index", index);
      item.innerHTML = `
        <img src="${base64}" alt="Preview ${index + 1}"/>
        <button type="button" class="remove-img"
          onclick="removeImage(${index})">✕</button>
      `;
      previews.appendChild(item);
    }

    function removeImage(index) {
      croppedImages.splice(index, 1);

      const previews = document.getElementById("imagePreviews");
      previews.innerHTML = "";
      croppedImages.forEach((img, i) => addImagePreview(img, i));

      updateImageCount();
    }

    function updateImageCount() {
      const count    = croppedImages.length;
      const el       = document.getElementById("imgCount");
      el.textContent = `${count} image${count !== 1 ? "s" : ""} selected (minimum 3)`;

      if (count === 0) {
        el.className = "img-count";
      } else if (count < 3) {
        el.className = "img-count error";
      } else {
        el.className = "img-count success";
      }
    }

    document.getElementById("addProductForm")
      .addEventListener("submit", async (e) => {
        e.preventDefault();

        clearAllErrors();

        const name          = document.getElementById("name").value.trim();
        const author        = document.getElementById("author").value.trim();
        const category      = document.getElementById("category").value;
        const condition     = document.getElementById("condition").value;
        const description   = document.getElementById("description").value.trim();
        const price         = document.getElementById("price").value;
        const originalPrice = document.getElementById("originalPrice").value;
        const stock         = document.getElementById("stock").value;
        const isbn          = document.getElementById("isbn").value.trim();
        const publisher     = document.getElementById("publisher").value.trim();

        const submitBtn = document.getElementById("submitBtn");

        let hasError = false;

        if (!name) {
          showFieldError("name", "Book title is required");
          hasError = true;
        }
        if (!category) {
          showFieldError("category", "Please select a category");
          hasError = true;
        }
        if (!condition) {
          showFieldError("condition", "Please select a condition");
          hasError = true;
        }
        if (!price || price <= 0) {
          showFieldError("price", "Please enter a valid price");
          hasError = true;
        }
        if (!stock || stock < 0) {
          showFieldError("stock", "Please enter a valid stock quantity");
          hasError = true;
        }
        if (croppedImages.length < 3) {
          Swal.fire({
            icon: 'warning',
            title: 'Images Required',
            text: 'Please upload at least 3 images',
            confirmButtonColor: '#8b7355'
          });
          hasError = true;
        }

        if (hasError) {
          return;
        }

        submitBtn.disabled    = true;
        submitBtn.textContent = "Uploading images...";

        try {
          const res  = await fetch("/admin/products/add", {
            method:  "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name, author, category, condition, description,
              price, originalPrice, stock,
              isbn, publisher,
              images: croppedImages, 
            }),
          });
          const data = await res.json();

          if (data.success) {
            Swal.fire({
              icon: 'success',
              title: 'Product Added!',
              text: data.message,
              confirmButtonColor: '#8b7355',
              timer: 2000,
              showConfirmButton: false
            }).then(() => {
              window.location.href = data.redirectUrl;
            });
          } else {
            Swal.fire({
              icon: 'error',
              title: 'Error',
              text: data.message,
              confirmButtonColor: '#8b7355'
            });
            submitBtn.disabled     = false;
            submitBtn.textContent  = "Add Product";
          }
        } catch(err) {
          Swal.fire({
            icon: 'error',
            title: 'Error',
            text: 'Something went wrong. Please try again.',
            confirmButtonColor: '#8b7355'
          });
          submitBtn.disabled     = false;
          submitBtn.textContent  = "Add Product";
        }
      });

    function showFieldError(fieldId, message) {
      const field = document.getElementById(fieldId);
      const errorDiv = document.getElementById(fieldId + "Error");
      
      if (field) {
        field.classList.add("error");
      }
      if (errorDiv) {
        errorDiv.textContent = message;
        errorDiv.classList.add("show");
      }
    }

    function clearAllErrors() {
      document.querySelectorAll(".error-message").forEach(el => {
        el.classList.remove("show");
      });
      document.querySelectorAll("input, select, textarea").forEach(el => {
        el.classList.remove("error");
      });
    }

    document.querySelectorAll("input, select, textarea").forEach(field => {
      field.addEventListener("input", function() {
        this.classList.remove("error");
        const errorDiv = document.getElementById(this.id + "Error");
        if (errorDiv) {
          errorDiv.classList.remove("show");
        }
      });
    });
  </script>
</body>
</html>