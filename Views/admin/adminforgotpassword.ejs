<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Forgot Password | Papyrus</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #c8b99a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .steps {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        border: 2px solid #a89070;
        color: #a89070;
        background: transparent;
      }
      .step.active .step-circle {
        background: #3d2c1e;
        color: #fff;
        border-color: #3d2c1e;
      }
      .step.done .step-circle {
        background: #3d2c1e;
        border-color: #3d2c1e;
        color: #fff;
        font-size: 20px;
      }
      .step-label {
        font-size: 12px;
        color: #a89070;
        font-weight: 500;
      }
      .step.active .step-label {
        color: #3d2c1e;
        font-weight: 600;
      }
      .step.done .step-label {
        color: #3d2c1e;
      }

      .step-arrow {
        display: flex;
        align-items: center;
        padding: 0 12px;
        padding-bottom: 22px;
      }
      .step-arrow.inactive::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #a89070;
        margin-right: 4px;
      }
      .step-arrow.inactive::after {
        content: "▶";
        font-size: 10px;
        color: #a89070;
      }

      .card {
        background: #f5efe6;
        border-radius: 16px;
        padding: 48px 44px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd0ba;
        text-align: center;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
      }
      .logo-icon {
        font-size: 28px;
      }
      .logo-text {
        font-size: 22px;
        font-weight: 700;
        color: #3d2c1e;
      }

      .card h2 {
        font-size: 26px;
        font-weight: 700;
        color: #3d2c1e;
        margin-bottom: 10px;
      }
      .card .subtitle {
        font-size: 14px;
        color: #7a6a58;
        margin-bottom: 28px;
        line-height: 1.6;
      }

      .form-group {
        text-align: left;
        margin-bottom: 24px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #3d2c1e;
        margin-bottom: 8px;
      }
      .form-group input {
        width: 100%;
        padding: 14px 16px;
        border: 1.5px solid #c8b99a;
        border-radius: 10px;
        font-size: 14px;
        background: #faf7f2;
        color: #3d2c1e;
        outline: none;
        transition: border-color 0.2s;
      }
      .form-group input:focus {
        border-color: #3d2c1e;
      }
      .form-group input.error {
        border-color: #dc3545;
      }

      .field-error {
        color: #dc3545;
        font-size: 12px;
        margin-top: 6px;
        display: block;
        min-height: 18px;
      }

      .btn-primary {
        width: 100%;
        padding: 15px;
        background: #3d2c1e;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-bottom: 20px;
      }
      .btn-primary:hover {
        background: #2a1f14;
      }
      .btn-primary:disabled {
        background: #9a8a7a;
        cursor: not-allowed;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #7a6a58;
        text-decoration: none;
        font-size: 13px;
      }
      .back-link:hover {
        color: #3d2c1e;
      }
    </style>
  </head>
  <body>
    <div class="steps">
      <div class="step active">
        <div class="step-circle">1</div>
        <span class="step-label">Email</span>
      </div>
      <div class="step-arrow inactive"></div>
      <div class="step">
        <div class="step-circle">2</div>
        <span class="step-label">Verify</span>
      </div>
      <div class="step-arrow inactive"></div>
      <div class="step">
        <div class="step-circle">3</div>
        <span class="step-label">Reset</span>
      </div>
    </div>

    <div class="card">
      <div class="logo">
        <span class="logo-icon">📖</span>
        <span class="logo-text">Papyrus</span>
      </div>

      <h2>Forgot Password?</h2>
      <p class="subtitle">
        Enter your administrative email address below, and we'll send you a
        verification code to reset your password.
      </p>

      <form id="forgotForm" novalidate>
        <div class="form-group">
          <label for="email">Admin Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="admin@papyrus.com"
            required
            autocomplete="email"
            oninput="clearErr()"
          />
          <span class="field-error" id="email-error"></span>
        </div>

        <button type="submit" class="btn-primary" id="submitBtn">
          Send Verification Code
        </button>
      </form>

      <a href="/admin/signin" class="back-link">&#8592; Back to Sign In</a>
    </div>

    <script>
      const emailInput = document.getElementById("email");
      const errorEl = document.getElementById("email-error");
      const submitBtn = document.getElementById("submitBtn");

      function showErr(msg) {
        errorEl.textContent = msg;
        emailInput.classList.add("error");
      }

      function clearErr() {
        errorEl.textContent = "";
        emailInput.classList.remove("error");
      }

      document
        .getElementById("forgotForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const emailVal = emailInput.value.trim();

          if (!emailVal) {
            showErr("Email is required.");
            emailInput.focus();
            return;
          }

          const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
          if (!emailRegex.test(emailVal)) {
            showErr("Please enter a valid email address.");
            emailInput.focus();
            return;
          }

          clearErr();
          submitBtn.textContent = "Sending…";
          submitBtn.disabled = true;

          try {
            const res = await fetch("/admin/forgot-password/send", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: emailVal }),
            });
            const data = await res.json();

            if (data.success) {
              await Swal.fire({
                icon: "success",
                title: "Code Sent!",
                text: data.message || "Verification code sent to your email",
                timer: 2000,
                showConfirmButton: false,
                timerProgressBar: true,
                background: "#f5efe6",
                color: "#3d2c1e",
                iconColor: "#3d2c1e",
              });
              window.location.href = data.redirectUrl || "/admin/forgot-password/verify";
            } else {
              Swal.fire({
                icon: "error",
                title: "Error",
                text: data.message || "Failed to send code",
                background: "#f5efe6",
                color: "#3d2c1e",
                confirmButtonColor: "#3d2c1e",
              });
              submitBtn.textContent = "Send Verification Code";
              submitBtn.disabled = false;
            }
          } catch {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: "A connection or server error occurred. Please try again.",
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
            submitBtn.textContent = "Send Verification Code";
            submitBtn.disabled = false;
          }
        });
    </script>
  </body>
</html>
