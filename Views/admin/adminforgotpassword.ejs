<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Forgot Password | Papyrus</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #c8b99a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .steps {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        border: 2px solid #a89070;
        color: #a89070;
        background: transparent;
      }
      .step.active .step-circle {
        background: #3d2c1e;
        color: #fff;
        border-color: #3d2c1e;
      }
      .step-label {
        font-size: 12px;
        color: #a89070;
        font-weight: 500;
      }
      .step.active .step-label {
        color: #3d2c1e;
        font-weight: 600;
      }

      .step-arrow {
        display: flex;
        align-items: center;
        padding: 0 12px;
        padding-bottom: 22px;
      }
      .step-arrow::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #a89070;
        margin-right: 4px;
      }
      .step-arrow::after {
        content: "▶";
        font-size: 10px;
        color: #a89070;
      }

      .card {
        background: #f5efe6;
        border-radius: 16px;
        padding: 48px 44px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd0ba;
        text-align: center;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
      }
      .logo-icon {
        font-size: 28px;
      }
      .logo-text {
        font-size: 22px;
        font-weight: 700;
        color: #3d2c1e;
      }

      .card h2 {
        font-size: 26px;
        font-weight: 700;
        color: #3d2c1e;
        margin-bottom: 12px;
      }
      .card p {
        font-size: 14px;
        color: #7a6a58;
        line-height: 1.6;
        margin-bottom: 28px;
      }

      .form-group {
        text-align: left;
        margin-bottom: 20px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #3d2c1e;
        margin-bottom: 8px;
      }
      .form-group input {
        width: 100%;
        padding: 14px 16px;
        border: 1.5px solid #c8b99a;
        border-radius: 10px;
        font-size: 14px;
        background: #faf7f2;
        color: #3d2c1e;
        outline: none;
        transition: border-color 0.2s;
      }
      .form-group input:focus {
        border-color: #3d2c1e;
      }
      .form-group input.error {
        border-color: #dc3545;
      }
      .form-group input.success {
        border-color: #28a745;
      }
      .field-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
        min-height: 16px;
        text-align: left;
      }

      .btn-primary {
        width: 100%;
        padding: 15px;
        background: #3d2c1e;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 4px;
      }
      .btn-primary:hover {
        background: #2a1f14;
      }
      .btn-primary:disabled {
        background: #9a8a7a;
        cursor: not-allowed;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 22px;
        color: #7a6a58;
        text-decoration: none;
        font-size: 13px;
      }
      .back-link:hover {
        color: #3d2c1e;
      }
    </style>
  </head>
  <body>
    <div class="steps">
      <div class="step active">
        <div class="step-circle">1</div>
        <span class="step-label">Email</span>
      </div>
      <div class="step-arrow"></div>
      <div class="step">
        <div class="step-circle">2</div>
        <span class="step-label">Verify</span>
      </div>
      <div class="step-arrow"></div>
      <div class="step">
        <div class="step-circle">3</div>
        <span class="step-label">Reset</span>
      </div>
    </div>

    <div class="card">
      <div class="logo">
        <span class="logo-icon">📖</span>
        <span class="logo-text">Papyrus</span>
      </div>

      <h2>Forgot Password?</h2>
      <p>
        No worries! Enter your admin email address and we'll send you a
        verification code to reset your password.
      </p>

      <form id="forgotForm" novalidate>
        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="your.email@example.com"
          />
          <span class="field-error" id="email-error"></span>
        </div>
        <button type="submit" class="btn-primary" id="submitBtn">
          Send Verification Code
        </button>
      </form>

      <a href="/admin/signin" class="back-link">&#8592; Back to Sign In</a>
    </div>

    <script>
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function showErr(msg) {
        document.getElementById("email-error").textContent = msg;
        document.getElementById("email").classList.add("error");
        document.getElementById("email").classList.remove("success");
      }
      function clearErr() {
        document.getElementById("email-error").textContent = "";
        document.getElementById("email").classList.remove("error");
        document.getElementById("email").classList.add("success");
      }

      document.getElementById("email").addEventListener("input", function () {
        const v = this.value.trim();
        if (!v) return showErr("Email is required.");
        if (!emailRe.test(v))
          return showErr("Please enter a valid email address.");
        clearErr();
      });

      document
        .getElementById("forgotForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const email = document.getElementById("email").value.trim();
          if (!email) return showErr("Email is required.");
          if (!emailRe.test(email))
            return showErr("Please enter a valid email address.");
          clearErr();

          const btn = document.getElementById("submitBtn");
          btn.textContent = "Sending…";
          btn.disabled = true;

          try {
            const res = await fetch("/admin/forgot-password/send", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email }),
            });
            const data = await res.json();

            if (data.success) {
              await Swal.fire({
                icon: "success",
                title: "Code Sent!",
                text:
                  data.message || "Check your email for the verification code.",
                timer: 2000,
                showConfirmButton: false,
                timerProgressBar: true,
                background: "#f5efe6",
                color: "#3d2c1e",
                iconColor: "#3d2c1e",
              });
              window.location.href =
                data.redirectUrl || "/admin/forgot-password/verify";
            } else {
              Swal.fire({
                icon: res.status === 429 ? "warning" : "error",
                title: res.status === 429 ? "Too Many Requests" : "Error",
                text: data.message,
                background: "#f5efe6",
                color: "#3d2c1e",
                confirmButtonColor: "#3d2c1e",
              });
            }
          } catch {
            Swal.fire({
              icon: "error",
              title: "Connection Error",
              text: "Please try again.",
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
          } finally {
            btn.textContent = "Send Verification Code";
            btn.disabled = false;
          }
        });
    </script>
  </body>
</html>
