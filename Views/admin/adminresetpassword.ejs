<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Reset Password | Papyrus</title>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        background-color: #c8b99a;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }

      .steps {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
      }
      .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }
      .step-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        font-weight: 700;
        border: 2px solid #a89070;
        color: #a89070;
        background: transparent;
      }
      .step.active .step-circle {
        background: #3d2c1e;
        color: #fff;
        border-color: #3d2c1e;
      }
      .step.done .step-circle {
        background: #3d2c1e;
        border-color: #3d2c1e;
        color: #fff;
        font-size: 20px;
      }
      .step-label {
        font-size: 12px;
        color: #a89070;
        font-weight: 500;
      }
      .step.active .step-label {
        color: #3d2c1e;
        font-weight: 600;
      }
      .step.done .step-label {
        color: #3d2c1e;
      }

      .step-arrow {
        display: flex;
        align-items: center;
        padding: 0 12px;
        padding-bottom: 22px;
      }
      .step-arrow.done::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #3d2c1e;
        margin-right: 4px;
      }
      .step-arrow.done::after {
        content: "▶";
        font-size: 10px;
        color: #3d2c1e;
      }
      .step-arrow.inactive::before {
        content: "";
        display: inline-block;
        width: 50px;
        height: 1px;
        background: #a89070;
        margin-right: 4px;
      }
      .step-arrow.inactive::after {
        content: "▶";
        font-size: 10px;
        color: #a89070;
      }

      .card {
        background: #f5efe6;
        border-radius: 16px;
        padding: 48px 44px;
        width: 100%;
        max-width: 520px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.1);
        border: 1px solid #ddd0ba;
        text-align: center;
      }
      .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 28px;
      }
      .logo-icon {
        font-size: 28px;
      }
      .logo-text {
        font-size: 22px;
        font-weight: 700;
        color: #3d2c1e;
      }
      .card h2 {
        font-size: 26px;
        font-weight: 700;
        color: #3d2c1e;
        margin-bottom: 10px;
      }
      .card .sub {
        font-size: 14px;
        color: #7a6a58;
        margin-bottom: 28px;
      }

      .form-group {
        text-align: left;
        margin-bottom: 18px;
      }
      .form-group label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #3d2c1e;
        margin-bottom: 8px;
      }
      .input-wrap {
        position: relative;
      }
      .form-group input {
        width: 100%;
        padding: 14px 46px 14px 16px;
        border: 1.5px solid #c8b99a;
        border-radius: 10px;
        font-size: 14px;
        background: #faf7f2;
        color: #3d2c1e;
        outline: none;
        transition: border-color 0.2s;
      }
      .form-group input:focus {
        border-color: #3d2c1e;
      }
      .form-group input.error {
        border-color: #dc3545;
      }
      .form-group input.success {
        border-color: #28a745;
      }

      .eye-btn {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: #7a6a58;
        padding: 4px;
        display: flex;
        align-items: center;
      }
      .eye-btn:hover {
        color: #3d2c1e;
      }
      .eye-btn svg {
        width: 18px;
        height: 18px;
      }

      .field-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
        min-height: 16px;
      }

      .strength-track {
        height: 4px;
        background: #e0d5c5;
        border-radius: 2px;
        margin-top: 8px;
        overflow: hidden;
      }
      .strength-fill {
        height: 100%;
        border-radius: 2px;
        width: 0;
        transition:
          width 0.3s,
          background 0.3s;
      }
      .strength-label {
        font-size: 11px;
        color: #9a8a7a;
        margin-top: 3px;
      }

      .req-list {
        list-style: none;
        text-align: left;
        margin: 8px 0 2px;
        padding: 0;
        font-size: 12px;
        color: #a89070;
      }
      .req-list li {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 3px;
      }
      .req-list li::before {
        content: "✗";
        font-size: 11px;
        color: #c8b99a;
      }
      .req-list li.met {
        color: #28a745;
      }
      .req-list li.met::before {
        content: "✓";
        color: #28a745;
      }

      .btn-primary {
        width: 100%;
        padding: 15px;
        background: #3d2c1e;
        color: #fff;
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        margin-top: 6px;
      }
      .btn-primary:hover {
        background: #2a1f14;
      }
      .btn-primary:disabled {
        background: #9a8a7a;
        cursor: not-allowed;
      }
    </style>
  </head>
  <body>
    <div class="steps">
      <div class="step done">
        <div class="step-circle">✓</div>
        <span class="step-label">Email</span>
      </div>
      <div class="step-arrow done"></div>
      <div class="step done">
        <div class="step-circle">✓</div>
        <span class="step-label">Verify</span>
      </div>
      <div class="step-arrow inactive"></div>
      <div class="step active">
        <div class="step-circle">3</div>
        <span class="step-label">Reset</span>
      </div>
    </div>

    <div class="card">
      <div class="logo">
        <span class="logo-icon">📖</span>
        <span class="logo-text">Papyrus</span>
      </div>

      <h2>Reset Password</h2>
      <p class="sub">Create a new secure password for your admin account.</p>

      <form id="resetForm" novalidate>
        <div class="form-group">
          <label for="newPassword">New Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              placeholder="Enter new password"
              autocomplete="new-password"
            />
            <button
              type="button"
              class="eye-btn"
              onclick="toggleVis('newPassword')"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
          <div class="strength-track">
            <div class="strength-fill" id="strengthFill"></div>
          </div>
          <div class="strength-label" id="strengthLabel"></div>
          <ul class="req-list">
            <li id="req-len">At least 8 characters</li>
            <li id="req-upper">One uppercase letter (A–Z)</li>
            <li id="req-lower">One lowercase letter (a–z)</li>
            <li id="req-num">One number (0–9)</li>
          </ul>
          <span class="field-error" id="newPassword-error"></span>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm New Password</label>
          <div class="input-wrap">
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              placeholder="Re-enter new password"
              autocomplete="new-password"
            />
            <button
              type="button"
              class="eye-btn"
              onclick="toggleVis('confirmPassword')"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                <circle cx="12" cy="12" r="3" />
              </svg>
            </button>
          </div>
          <span class="field-error" id="confirmPassword-error"></span>
        </div>

        <button type="submit" class="btn-primary" id="resetBtn">
          Reset Password
        </button>
      </form>
    </div>

    <script>
      function toggleVis(id) {
        const inp = document.getElementById(id);
        inp.type = inp.type === "password" ? "text" : "password";
      }
      function showErr(id, msg) {
        document.getElementById(id + "-error").textContent = msg;
        document.getElementById(id).classList.add("error");
        document.getElementById(id).classList.remove("success");
      }
      function clearErr(id) {
        document.getElementById(id + "-error").textContent = "";
        document.getElementById(id).classList.remove("error");
        document.getElementById(id).classList.add("success");
      }

      const strengthColors = [
        "",
        "#dc3545",
        "#fd7e14",
        "#ffc107",
        "#28a745",
        "#198754",
      ];
      const strengthLabels = [
        "",
        "Very Weak",
        "Weak",
        "Fair",
        "Strong",
        "Very Strong",
      ];

      function getScore(p) {
        let s = 0;
        if (p.length >= 8) s++;
        if (/[A-Z]/.test(p)) s++;
        if (/[a-z]/.test(p)) s++;
        if (/\d/.test(p)) s++;
        if (/[^A-Za-z0-9]/.test(p)) s++;
        return s;
      }
      function setReq(id, met) {
        const el = document.getElementById(id);
        if (met) el.classList.add("met");
        else el.classList.remove("met");
      }

      document
        .getElementById("newPassword")
        .addEventListener("input", function () {
          const v = this.value;
          setReq("req-len", v.length >= 8);
          setReq("req-upper", /[A-Z]/.test(v));
          setReq("req-lower", /[a-z]/.test(v));
          setReq("req-num", /\d/.test(v));

          const score = v ? getScore(v) : 0;
          document.getElementById("strengthFill").style.width = v
            ? `${score * 20}%`
            : "0";
          document.getElementById("strengthFill").style.background =
            strengthColors[score] || "#e0d5c5";
          document.getElementById("strengthLabel").textContent = v
            ? strengthLabels[score]
            : "";

          if (!v) return showErr("newPassword", "Password is required.");
          if (v.length < 8)
            return showErr("newPassword", "Minimum 8 characters required.");
          clearErr("newPassword");

          const cv = document.getElementById("confirmPassword").value;
          if (cv) {
            if (cv !== v) showErr("confirmPassword", "Passwords do not match.");
            else clearErr("confirmPassword");
          }
        });

      document
        .getElementById("confirmPassword")
        .addEventListener("input", function () {
          const v = this.value;
          const pv = document.getElementById("newPassword").value;
          if (!v)
            return showErr("confirmPassword", "Please confirm your password.");
          if (v !== pv)
            return showErr("confirmPassword", "Passwords do not match.");
          clearErr("confirmPassword");
        });

      document
        .getElementById("resetForm")
        .addEventListener("submit", async (e) => {
          e.preventDefault();
          const np = document.getElementById("newPassword").value;
          const cp = document.getElementById("confirmPassword").value;
          let ok = true;

          if (!np) {
            showErr("newPassword", "Password is required.");
            ok = false;
          } else if (np.length < 8) {
            showErr("newPassword", "Minimum 8 characters.");
            ok = false;
          } else clearErr("newPassword");

          if (!cp) {
            showErr("confirmPassword", "Please confirm your password.");
            ok = false;
          } else if (cp !== np) {
            showErr("confirmPassword", "Passwords do not match.");
            ok = false;
          } else clearErr("confirmPassword");

          if (!ok) return;

          const btn = document.getElementById("resetBtn");
          btn.textContent = "Resetting…";
          btn.disabled = true;

          try {
            const res = await fetch("/admin/forgot-password/reset", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ newPassword: np, confirmPassword: cp }),
            });
            const data = await res.json();

            if (data.success) {
              await Swal.fire({
                icon: "success",
                title: "Password Reset!",
                text: data.message,
                timer: 2000,
                showConfirmButton: false,
                timerProgressBar: true,
                background: "#f5efe6",
                color: "#3d2c1e",
                iconColor: "#3d2c1e",
              });
              window.location.href = data.redirectUrl || "/admin/signin";
            } else {
              Swal.fire({
                icon: "error",
                title: "Error",
                text: data.message,
                background: "#f5efe6",
                color: "#3d2c1e",
                confirmButtonColor: "#3d2c1e",
              });
            }
          } catch {
            Swal.fire({
              icon: "error",
              title: "Error",
              text: "Please try again.",
              background: "#f5efe6",
              color: "#3d2c1e",
              confirmButtonColor: "#3d2c1e",
            });
          } finally {
            btn.textContent = "Reset Password";
            btn.disabled = false;
          }
        });
    </script>
  </body>
</html>
